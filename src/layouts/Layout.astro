---
import '../styles/global.css';
import WhatsappFloat from '../components/WhatsappFloat.astro';
import LivePopup from '../components/LivePopup.astro';
import ModalPreMatricula from '../components/ModalPreMatricula.astro';
import { SITE, SITE_URL } from '../data/site';
import { breadcrumbs, breadcrumbJsonLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  /** Texto alternativo de la imagen social; Google lo usa como caption. */
  ogImageAlt?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** `article` en las noticias; `website` en el resto del sitio. */
  ogType?: 'website' | 'article';
  /** Solo con ogType="article". */
  publishedTime?: string;
  modifiedTime?: string;
  /** Migas de pan. Si no se pasan se deducen de la URL. */
  migas?: { name: string; href: string }[];
  /** Texto del ultimo nivel de la miga deducida (el titular, en noticias). */
  migasUltimo?: string;
}

const {
  title,
  description = SITE.description,
  canonical,
  ogImage,
  ogImageAlt = `${SITE.name} — ${SITE.tagline}`,
  noindex = false,
  jsonLd,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  migas: migasProp,
  migasUltimo,
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const site = new URL(SITE_URL);
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site).toString();
const ogImageUrl = new URL(ogImage ?? '/og-image.png', site).toString();
const migas = migasProp ?? breadcrumbs(Astro.url.pathname, migasUltimo);

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'EducationalOrganization',
  '@id': `${SITE_URL}/#organization`,
  name: SITE.name,
  legalName: SITE.legalName,
  description: SITE.description,
  url: SITE_URL,
  logo: new URL('/logo.png', site).toString(),
  image: new URL('/og-image.png', site).toString(),
  telephone: SITE.phone.display,
  email: SITE.email,
  foundingDate: String(SITE.fundacion),
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address.street,
    addressLocality: SITE.address.city,
    addressRegion: SITE.address.region,
    postalCode: SITE.address.postalCode,
    addressCountry: SITE.address.country,
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: -11.1067,
    longitude: -77.6119,
  },
  openingHoursSpecification: SITE.hours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days === 'Sábado' ? 'Saturday' : 'Monday-Friday',
    opens: h.opens,
    closes: h.closes,
  })),
  areaServed: { '@type': 'City', name: 'Huacho' },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
    `${SITE.address.street}, ${SITE.address.city}, ${SITE.address.countryName}`,
  )}`,
  /** Contacto de admisiones: es lo que Google muestra en el panel local. */
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'admissions',
      telephone: SITE.phone.e164,
      email: SITE.email,
      areaServed: 'PE',
      availableLanguage: ['es'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'sales',
      telephone: SITE.phoneAcademia.e164,
      areaServed: 'PE',
      availableLanguage: ['es'],
    },
  ],
  knowsLanguage: 'es-PE',
  sameAs: Object.values(SITE.social).filter(Boolean),
};

const structuredData = [
  defaultJsonLd,
  ...(migas.length > 0 ? [breadcrumbJsonLd(migas)] : []),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

const redes = Object.values(SITE.social).filter((url) => url.length > 0) as string[];
const twitter = redes.find((url) => url.includes('twitter.com') || url.includes('x.com'));
---

<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!--
      Solo PNG: el favicon.svg que traia el starter de Astro (el cohete) tiene
      prioridad sobre estos iconos en los navegadores que soportan SVG, asi que
      se elimino. Los PNG se generan desde public/escudo.png en prebuild.
    -->
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {ogType === 'article' && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {ogType === 'article' && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {ogType === 'article' && <meta property="article:publisher" content={SITE_URL} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />
    {twitter && <meta name="twitter:site" content={`@${twitter.split('/').pop()}`} />}

    <meta name="theme-color" content={SITE.themeColor} />

    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />
    <!--
      Global helpers must load before any component script in <body>, because
      components read `window.createDialog` / `window.icons` at parse time.
    -->
    <script src="/js/a11y-modal.js" is:inline></script>
    <script src="/js/icons.js" is:inline></script>
    <slot name="head" />
  </head>
  <body class="bg-white text-slate-800 antialiased">
    <a href="#contenido" class="skip-link">
      Saltar al contenido principal
    </a>
    <slot />
    <WhatsappFloat />
    <LivePopup />
    <ModalPreMatricula />

    <script>
      (() => {
        const SECRET = 'admin';
        const buffer: string[] = [];
        const MAX_BUFFER = 12;
        const isTyping = (el: EventTarget | null) => {
          if (!el || !(el instanceof HTMLElement)) return false;
          const tag = el.tagName;
          return tag === 'INPUT' || tag === 'TEXTAREA' || el.isContentEditable;
        };
        document.addEventListener('keydown', (e) => {
          if (isTyping(e.target)) return;
          if (e.metaKey || e.ctrlKey || e.altKey) return;
          if (e.key.length !== 1) return;
          buffer.push(e.key.toLowerCase());
          if (buffer.length > MAX_BUFFER) buffer.shift();
          if (buffer.join('').endsWith(SECRET)) {
            window.location.href = '/admin';
          }
        });
      })();
    </script>
  </body>
</html>
