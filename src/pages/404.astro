---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, waLink } from '../data/site';
---

<Layout
  title="Página no encontrada"
  description="La página que buscas no existe. Vuelve al inicio del Colegio y Academia Galileo."
  noindex
>
  <Header />
  <main id="contenido" class="flex min-h-[60vh] items-center justify-center bg-slate-50 px-4 py-20">
    <div class="mx-auto max-w-md text-center">
      <p class="text-7xl font-extrabold text-brand-500">404</p>
      <h1 class="mt-4 text-2xl font-extrabold text-navy-700 sm:text-3xl">Página no encontrada</h1>
      <p class="mt-3 text-sm text-slate-600 sm:text-base">
        La página que buscas no existe o fue movida. Vuelve al inicio para seguir explorando.
      </p>
      <div class="mt-6 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-brand-600"
        >
          ← Volver al inicio
        </a>
        <a
          href={waLink('Hola, no encuentro la página que busco. ¿Me pueden ayudar?')}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center justify-center gap-2 rounded-full border-2 border-navy-200 px-6 py-3 text-sm font-bold text-navy-700 transition hover:border-brand-400 hover:text-brand-600"
        >
          Escribir a {SITE.shortName}
        </a>
      </div>
    </div>
  </main>
  <Footer />
</Layout>
