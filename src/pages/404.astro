---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout
  title="Página no encontrada | Colegio y Academia Galileo"
  description="La página que buscas no existe. Vuelve al inicio del Colegio y Academia Galileo."
>
  <Header />
  <main class="flex min-h-[60vh] items-center justify-center bg-slate-50 px-4 py-20">
    <div class="mx-auto max-w-md text-center">
      <p class="text-7xl font-extrabold text-brand-500">404</p>
      <h1 class="mt-4 text-2xl font-extrabold text-navy-700 sm:text-3xl">Página no encontrada</h1>
      <p class="mt-3 text-sm text-slate-600 sm:text-base">
        La página que buscas no existe o fue movida. Vuelve al inicio para seguir explorando.
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center justify-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white shadow-md transition hover:bg-brand-600"
      >
        ← Volver al inicio
      </a>
    </div>
  </main>
  <Footer />
</Layout>