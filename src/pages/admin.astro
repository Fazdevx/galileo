    const statusOptions = ['Programado', 'En vivo', 'Finalizado', 'Suspendido'];
    return `<form id="game-form" class="space-y-4">
      <input type="hidden" name="id" value="${esc(g.id)}" />
      <div class="grid gap-3 sm:grid-cols-2">
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Local</span>
          <select name="local" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            <option value="">—</option>
            ${data.sections.map(s => `<option value="${esc(s.name)}" ${s.name === g.local ? 'selected' : ''}>${esc(s.name)}</option>`).join('')}
          </select>
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Visitante</span>
          <select name="visit" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            <option value="">—</option>
            ${data.sections.map(s => `<option value="${esc(s.name)}" ${s.name === g.visit ? 'selected' : ''}>${esc(s.name)}</option>`).join('')}
          </select>
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Goles/puntos local</span>
          <input name="localScore" type="number" min="0" value="${g.localScore}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" />
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Goles/puntos visitante</span>
          <input name="visitScore" type="number" min="0" value="${g.visitScore}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" />
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Disciplina</span>
          <select name="sport" required class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            <option value="">—</option>
            ${data.sports.map(sp => `<option value="${esc(sp)}" ${sp === g.sport ? 'selected' : ''}>${esc(sp)}</option>`).join('')}
          </select>
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Estado</span>
          <select name="status" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            ${statusOptions.map(st => `<option value="${st}" ${st === g.status ? 'selected' : ''}>${st}</option>`).join('')}
          </select>
        </label>
      </div>
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Fecha / hora</span>
        <input name="date" maxlength="40" value="${esc(g.date)}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="15 Feb 2026" />
      </label>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" id="modal-cancel" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button type="submit" class="rounded-xl bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-md hover:bg-brand-600">${g.id ? 'Guardar' : 'Crear'}</button>
      </div>
    </form>`;
  }

  async function attachFormHandlers() {
    const sf = $('#section-form');
    if (sf) {
      sf.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const fd = new FormData(sf);
        const id = String(fd.get('id') || '').trim();
        const payload = {
          id: id || uid('s'),
          name: String(fd.get('name') || '').trim(),
          initial: String(fd.get('initial') || '').trim().toUpperCase().slice(0, 2),
          color: String(fd.get('color') || 'bg-brand-500'),
        };
        if (!payload.name) return;
        if (id) { const i = data.sections.findIndex(s => s.id === id); if (i >= 0) data.sections[i] = payload; }
        else data.sections.push(payload);
        await save();
        renderAll(); closeModal();
      });
      $('#modal-cancel', sf.parentElement)?.addEventListener('click', closeModal);
    }
    const spf = $('#sport-form');
    if (spf) {
      spf.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const fd = new FormData(spf);
        const name = String(fd.get('name') || '').trim();
        if (!name) return;
        if (editingSportIdx != null) { data.sports[editingSportIdx] = name; editingSportIdx = null; }
        else if (data.sports.includes(name)) { alert('Esa disciplina ya existe.'); return; }
        else data.sports.push(name);
        await save();
        renderAll(); closeModal();
      });
      $('#modal-cancel', spf.parentElement)?.addEventListener('click', closeModal);
    }
    const gf = $('#game-form');
    if (gf) {
      gf.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const fd = new FormData(gf);
        const id = String(fd.get('id') || '').trim();
        const local = String(fd.get('local') || '').trim();
        const visit = String(fd.get('visit') || '').trim();
        if (!local || !visit) { alert('Selecciona local y visitante.'); return; }
        if (local === visit) { alert('Local y visitante deben ser distintos.'); return; }
        const payload = {
          id: id || uid('g'),
          local, visit,
          localScore: Math.max(0, Number(fd.get('localScore') || 0)),
          visitScore: Math.max(0, Number(fd.get('visitScore') || 0)),
          status: String(fd.get('status') || 'Programado'),
          sport: String(fd.get('sport') || '').trim(),
          date: String(fd.get('date') || '').trim(),
        };
        if (id) { const i = data.games.findIndex(g => g.id === id); if (i >= 0) data.games[i] = payload; }
        else data.games.unshift(payload);
        await save();
        renderAll(); closeModal();
      });
      $('#modal-cancel', gf.parentElement)?.addEventListener('click', closeModal);
    }

    const pf = $('#prize-form');
    if (pf) {
      pf.addEventListener('submit', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const fd = new FormData(pf);
        const id = String(fd.get('id') || '').trim();
        const payload = {
          id: id || uid('p'),
          name: String(fd.get('name') || '').trim(),
          description: String(fd.get('description') || '').trim(),
          type: String(fd.get('type') || 'descuento_mensualidad'),
          value: Math.max(1, Number(fd.get('value') || 5)),
          color: String(fd.get('color') || 'bg-brand-500'),
          icon: String(fd.get('icon') || '🎁'),
        };
        if (!payload.name) return;
        if (!data.prizes) data.prizes = [];
        if (id) { const i = data.prizes.findIndex(p => p.id === id); if (i >= 0) data.prizes[i] = payload; }
        else data.prizes.push(payload);
        await save();
        renderAll(); closeModal();
      });
      $('#modal-cancel', pf.parentElement)?.addEventListener('click', closeModal);
    }
  }

  async function initData() {
    console.log('[Admin] initData started');
    const cloud = await loadFromCloud();
    const local = loadLocal();
    console.log('[Admin]:', { hasCloud: !!cloud, hasLocal: !!local });
    if (cloud) {
      data = cloud;
      saveLocal();
      console.log('[Admin] using cloud data');
    } else if (local) {
      data = local;
      console.log('[Admin] using local data');
    } else {
      console.log('[Admin] using default data');
    }
    if (isAuthed) { showPanel(); renderAll(); } else { showLogin(); }
  }

  function faIcon(name, size = 20) {
    return `<i class="fas fa-${name}" style="font-size:${size}px"></i>`;
  }

  function renderPrizes() {
    const list = $('#prizes-list');
    if (!list) return;
    if (!data.prizes || !data.prizes.length) {
      list.innerHTML = '<p class="col-span-full text-sm text-slate-500">No hay premios configurados.</p>';
      return;
    }
    list.innerHTML = data.prizes.map((p, idx) => `
      <div class="flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 px-3 py-2">
        <div class="flex items-center gap-2">
          <span class="text-slate-700">${faIcon(p.icon || 'gift', 20)}</span>
          <div>
            <p class="text-sm font-bold text-navy-700">${esc(p.name)}</p>
            <p class="text-[10px] text-slate-500">${esc(p.description)}</p>
          </div>
        </div>
        <button type="button" data-delete-prize="${idx}" class="rounded-md bg-red-50 px-2 py-1 text-[10px] font-bold text-red-600 hover:bg-red-100">✕</button>
      </div>
    `).join('');
  }

  function buildPrizeForm(prize) {
    prize = prize || { id: '', name: '', description: '', type: 'descuento_mensualidad', value: 5, color: 'bg-brand-500', icon: 'gift' };
    const typeOptions = [
      { value: 'descuento_mensualidad', label: 'Descuento mensualidad' },
      { value: 'descuento_matricula', label: 'Descuento matrícula' },
      { value: 'libro', label: 'Libro' },
      { value: 'cuaderno', label: 'Cuaderno' },
      { value: 'bonus', label: 'Bonus' },
    ];
    const colorOptions = [
      { value: 'bg-brand-500', label: 'Naranja' },
      { value: 'bg-navy-600', label: 'Azul marino' },
      { value: 'bg-emerald-500', label: 'Verde' },
      { value: 'bg-purple-500', label: 'Morado' },
      { value: 'bg-rose-500', label: 'Rosa' },
      { value: 'bg-amber-500', label: 'Ámbar' },
      { value: 'bg-sky-500', label: 'Celeste' },
    ];
    return `<form id="prize-form" class="space-y-4">
      <input type="hidden" name="id" value="${esc(prize.id)}" />
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Nombre</span>
        <input name="name" required maxlength="40" value="${esc(prize.name)}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="5% Descuento" />
      </label>
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Descripción</span>
        <input name="description" required maxlength="80" value="${esc(prize.description)}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="5% descuento mensualidad" />
      </label>
      <div class="grid grid-cols-2 gap-3">
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Tipo</span>
          <select name="type" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            ${typeOptions.map(t => `<option value="${t.value}" ${t.value === prize.type ? 'selected' : ''}>${t.label}</option>`).join('')}
          </select>
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Valor (%)</span>
          <input name="value" type="number" min="1" max="100" value="${prize.value}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" />
        </label>
      </div>
      <div class="grid grid-cols-2 gap-3">
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Color</span>
          <select name="color" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            ${colorOptions.map(c => `<option value="${c.value}" ${c.value === prize.color ? 'selected' : ''}>${c.label}</option>`).join('')}
          </select>
        </label>
        <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Icono</span>
          <select name="icon" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
            ${['money', 'gift', 'star', 'graduation', 'book', 'notebook'].map(icon => `<option value="${icon}" ${icon === (prize.icon || 'gift') ? 'selected' : ''}>${icon}</option>`).join('')}
          </select>
        </label>
      </div>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" id="modal-cancel" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button type="submit" class="rounded-xl bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-md hover:bg-brand-600">${prize.id ? 'Guardar' : 'Crear'}</button>
