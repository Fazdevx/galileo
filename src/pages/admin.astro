  function bindGlobal() {
    initData();

    $('#login-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const pass = $('#login-pass').value;
      if (pass === ADMIN_PASSWORD) {
        isAuthed = true;
        sessionStorage.setItem(AUTH_KEY, '1');
        $('#login-error')?.classList.add('hidden');
        await initData();
        showPanel(); renderAll();
      } else {
        $('#login-error')?.classList.remove('hidden');
      }
    });

    $('#logout-btn')?.addEventListener('click', () => {
      sessionStorage.removeItem(AUTH_KEY);
      isAuthed = false;
      showLogin();
    });

    $('#stats-form')?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fd = new FormData(e.target);
      data.heroStats = {
        secciones: Math.max(0, Number(fd.get('secciones') || 0)),
        disciplinas: Math.max(0, Number(fd.get('disciplinas') || 0)),
        dias: Math.max(0, Number(fd.get('dias') || 0)),
      };
      await save(); renderAll();
    });

    $('#btn-add-section')?.addEventListener('click', () => {
      editingSectionId = null;
      openModal('Nueva sección', buildSectionForm(null));
      attachFormHandlers();
    });
    $('#btn-add-sport')?.addEventListener('click', () => {
      editingSportIdx = null;
      openModal('Nueva disciplina', buildSportForm(null));
      attachFormHandlers();
    });
    $('#btn-add-game')?.addEventListener('click', () => {
      editingGameId = null;
      openModal('Nuevo partido', buildGameForm(null));
      attachFormHandlers();
    });
    $('#btn-add-prize')?.addEventListener('click', () => {
      openModal('Nuevo premio', buildPrizeForm(null));
      attachFormHandlers();
    });

    $('#prizes-list')?.addEventListener('click', (e) => {
      const delBtn = e.target.closest('[data-delete-prize]');
      if (delBtn) {
        const idx = Number(delBtn.getAttribute('data-delete-prize'));
        if (confirm(`¿Eliminar premio "${data.prizes[idx]?.name}"?`)) {
          data.prizes.splice(idx, 1);
          save(); renderAll();
        }
      }
    });

    $('#btn-reset')?.addEventListener('click', async () => {
      if (confirm('¿Restablecer todos los datos?')) {
        data = JSON.parse(JSON.stringify(DEFAULT_DATA));
        await save();
        renderAll();
      }
    });

    $('#sections-tbody')?.addEventListener('click', (e) => {
      const t = e.target.closest('[data-edit-section]');
      if (t) {
        const s = data.sections.find(x => x.id === t.getAttribute('data-edit-section'));
        if (s) { openModal('Editar sección', buildSectionForm(s)); attachFormHandlers(); }
        return;
      }
      const d = e.target.closest('[data-delete-section]');
      if (d && !d.hasAttribute('disabled')) {
        const s = data.sections.find(x => x.id === d.getAttribute('data-delete-section'));
        if (!s) return;
        if (data.games.some(g => g.local === s.name || g.visit === s.name)) {
          alert('No se puede eliminar: está en uso por un partido.'); return;
        }
        if (confirm(`¿Eliminar "${s.name}"?`)) {
          data.sections = data.sections.filter(x => x.id !== s.id);
          save(); renderAll();
        }
      }
    });

    $('#sports-list')?.addEventListener('click', (e) => {
      const t = e.target.closest('[data-edit-sport]');
      if (t) {
        const idx = Number(t.getAttribute('data-edit-sport'));
        editingSportIdx = Number.isFinite(idx) ? idx : null;
        openModal('Editar disciplina', buildSportForm(data.sports[editingSportIdx]));
        attachFormHandlers();
        return;
      }
      const d = e.target.closest('[data-delete-sport]');
      if (d) {
        const idx = Number(d.getAttribute('data-delete-sport'));
        if (confirm(`¿Eliminar "${data.sports[idx]}"?`)) {
          data.sports.splice(idx, 1); save(); renderAll();
        }
      }
    });

    $('#games-tbody')?.addEventListener('click', (e) => {
      const editBtn = e.target.closest('[data-edit-game]');
      if (editBtn) {
        const g = data.games.find(x => x.id === editBtn.getAttribute('data-edit-game'));
        if (g) { openModal('Editar partido', buildGameForm(g)); attachFormHandlers(); }
        return;
      }
      const delBtn = e.target.closest('[data-delete-game]');
      if (delBtn) {
        if (confirm('¿Eliminar este partido?')) {
          data.games = data.games.filter(x => x.id !== delBtn.getAttribute('data-delete-game'));
          save(); renderAll();
        }
        return;
      }
      const scoreBtn = e.target.closest('[data-score]');
      if (scoreBtn) {
        const id = scoreBtn.getAttribute('data-game-id');
        const side = scoreBtn.getAttribute('data-score');
        const delta = Number(scoreBtn.getAttribute('data-delta') || 1);
        const g = data.games.find(x => x.id === id);
        if (!g) return;
        if (side === 'local') g.localScore = Math.max(0, (Number(g.localScore) || 0) + delta);
        else g.visitScore = Math.max(0, (Number(g.visitScore) || 0) + delta);
        save();
        const lEl = document.querySelector(`[data-score-local="${id}"]`);
        const vEl = document.querySelector(`[data-score-visit="${id}"]`);
        if (lEl) lEl.textContent = String(g.localScore);
        if (vEl) vEl.textContent = String(g.visitScore);
        return;
      }
      const liveBtn = e.target.closest('[data-toggle-live]');
      if (liveBtn) {
        const g = data.games.find(x => x.id === liveBtn.getAttribute('data-toggle-live'));
        if (!g) return;
        if ((g.status || '').includes('En vivo')) g.status = 'Finalizado';
        else g.status = "En vivo · 0'";
        save(); renderAll();
      }
    });

    window.addEventListener('galileo-data-changed', () => { renderSummary(); });
    setInterval(async () => { const cloud = await loadFromCloud(); if (cloud) { data = cloud; renderAll(); } }, 60000);
  }

  bindGlobal();
</script>
