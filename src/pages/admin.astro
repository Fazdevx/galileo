        <button type="button" id="modal-cancel" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button type="submit" class="rounded-xl bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-md hover:bg-brand-600">${s.id ? 'Guardar' : 'Crear'}</button>
      </div>
    </form>`;
  }

  function buildSportForm(name) {
    return `<form id="sport-form" class="space-y-4">
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Disciplina</span>
        <input name="name" required maxlength="40" value="${esc(name || '')}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="Karate" />
      </label>
      <div class="flex justify-end gap-2 pt-2">
        <button type="button" id="modal-cancel" class="rounded-xl border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-600 hover:bg-slate-50">Cancelar</button>
        <button type="submit" class="rounded-xl bg-brand-500 px-4 py-2 text-sm font-bold text-white shadow-md hover:bg-brand-600">Guardar</button>
      </div>
    </form>`;
  }

  function buildGameForm(g) {
