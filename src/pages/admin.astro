---
import Layout from '../layouts/Layout.astro';
import { DEFAULT_DATA, ADMIN_PASSWORD, uid, PRIZES } from '../data/olimpiadasStore';

const DEFAULT_DATA_COPY = JSON.stringify(DEFAULT_DATA);
const defaultDataJson = DEFAULT_DATA_COPY;
const adminPassword = ADMIN_PASSWORD;
---
<Layout title="Admin · Olimpiadas Galileo">
  <div class="min-h-screen bg-slate-100">
    <header class="sticky top-0 z-40 border-b border-slate-200 bg-white shadow-sm">
      <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6 sm:py-4">
        <div class="flex items-center gap-3">
          <img src="/logo.png" alt="Galileo" class="h-9 w-auto sm:h-10" />
          <div>
            <p class="text-[10px] font-bold uppercase tracking-widest text-brand-500 sm:text-xs">Panel admin</p>
            <p class="text-sm font-extrabold text-navy-700 sm:text-base">Olimpiadas 2026</p>
          </div>
        </div>
        <div class="flex items-center gap-2">
          <a href="/" class="rounded-full border border-slate-200 px-3 py-1.5 text-xs font-semibold text-slate-600 hover:bg-slate-50 sm:px-4 sm:py-2 sm:text-sm">← Volver al sitio</a>
          <button id="logout-btn" class="rounded-full bg-navy-700 px-3 py-1.5 text-xs font-semibold text-white hover:bg-navy-800 sm:px-4 sm:py-2 sm:text-sm">Salir</button>
        </div>
      </div>
    </header>

    <main class="mx-auto max-w-7xl px-4 py-6 sm:px-6 sm:py-10">
      <div id="login-card" class="mx-auto mt-10 max-w-md rounded-2xl bg-white p-6 shadow-xl ring-1 ring-slate-200 sm:p-8">
        <div class="mb-6 flex flex-col items-center text-center">
          <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-brand-500 text-white shadow-md">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-7 w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 15v2 M12 11v2 M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/></svg>
          </div>
          <h1 class="mt-4 text-xl font-extrabold text-navy-700 sm:text-2xl">Acceso restringido</h1>
          <p class="mt-1 text-sm text-slate-500">Ingresa la contraseña para administrar las olimpiadas.</p>
        </div>
        <form id="login-form" class="space-y-4">
          <label class="block">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Contraseña</span>
            <input id="login-pass" type="password" required autocomplete="current-password" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-3 text-sm transition focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="••••••••" />
          </label>
          <p id="login-error" class="hidden text-sm font-semibold text-red-600">Contraseña incorrecta.</p>
          <button type="submit" class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-brand-500 py-3 text-sm font-bold text-white shadow-md transition hover:bg-brand-600">
            Ingresar
            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14 M13 6l6 6-6 6"/></svg>
          </button>
        </form>
      </div>

      <div id="admin-panel" class="hidden space-y-6">
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Partidos en vivo</p>
            <p class="mt-2 text-3xl font-extrabold text-brand-500" data-summary-live>0</p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Partidos finalizados</p>
            <p class="mt-2 text-3xl font-extrabold text-navy-700" data-summary-finished>0</p>
          </div>
          <div class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:col-span-2 lg:col-span-1">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">Secciones / disciplinas</p>
            <p class="mt-2 text-3xl font-extrabold text-navy-700"><span data-summary-sections>0</span> <span class="text-base font-semibold text-slate-500">/</span> <span data-summary-sports>0</span></p>
          </div>
        </div>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
          <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">Estadísticas del hero</h2>
          <p class="text-xs text-slate-500 sm:text-sm">Números que se muestran en la sección principal.</p>
          <form id="stats-form" class="mt-4 grid gap-3 sm:grid-cols-3">
            <label class="block">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Secciones</span>
              <input name="secciones" type="number" min="0" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" />
            </label>
            <label class="block">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Disciplinas</span>
              <input name="disciplinas" type="number" min="0" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" />
            </label>
            <label class="block">
              <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Días</span>
              <input name="dias" type="number" min="0" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" />
            </label>
            <div class="sm:col-span-3 flex justify-end">
              <button type="submit" class="inline-flex items-center gap-2 rounded-xl bg-navy-700 px-4 py-2.5 text-sm font-bold text-white shadow-md transition hover:bg-navy-800">Guardar estadísticas</button>
            </div>
          </form>
        </section>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">Secciones en competencia</h2>
            <button id="btn-add-section" type="button" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-3 py-2 text-xs font-bold text-white shadow-md transition hover:bg-brand-600 sm:text-sm">+ Nueva sección</button>
          </div>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full min-w-[520px] text-sm">
              <thead class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500">
                <tr>
                  <th class="px-3 py-2 text-left">Inicial</th>
                  <th class="px-3 py-2 text-left">Nombre</th>
                  <th class="px-3 py-2 text-left">Color</th>
                  <th class="px-3 py-2 text-right">Acciones</th>
                </tr>
              </thead>
              <tbody id="sections-tbody" class="divide-y divide-slate-100"></tbody>
            </table>
          </div>
        </section>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">Disciplinas deportivas</h2>
            <button id="btn-add-sport" type="button" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-3 py-2 text-xs font-bold text-white shadow-md transition hover:bg-brand-600 sm:text-sm">+ Nueva disciplina</button>
          </div>
          <div id="sports-list" class="mt-4 flex flex-wrap gap-2"></div>
        </section>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">Partidos / Marcadores</h2>
            <button id="btn-add-game" type="button" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-3 py-2 text-xs font-bold text-white shadow-md transition hover:bg-brand-600 sm:text-sm">+ Nuevo partido</button>
          </div>
          <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3" id="games-tbody"></div>
        </section>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">🎡 Premios de la Ruleta</h2>
            <button id="btn-add-prize" type="button" class="inline-flex items-center gap-2 rounded-xl bg-brand-500 px-3 py-2 text-xs font-bold text-white shadow-md transition hover:bg-brand-600 sm:text-sm">+ Nuevo premio</button>
          </div>
          <div class="mt-4 grid gap-2 sm:grid-cols-2 lg:grid-cols-3" id="prizes-list"></div>
        </section>

        <section class="rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">Zona peligrosa</h2>
            <button id="btn-reset" type="button" class="inline-flex items-center gap-2 rounded-xl border-2 border-red-200 bg-white px-3 py-2 text-xs font-bold text-red-600 transition hover:bg-red-50 sm:text-sm">Restablecer datos</button>
          </div>
        </section>
      </div>
    </main>
  </div>

  <div id="modal-root"></div>
</Layout>

<script define:vars={{ defaultDataJson, adminPassword }}>
  const DEFAULT_DATA = JSON.parse(defaultDataJson);
  const ADMIN_PASSWORD = adminPassword;
  const uid = (prefix = 'id') => `${prefix}-${Date.now().toString(36)}-${Math.random().toString(36).slice(2, 7)}`;
  const KEY = 'galileo-olimpiadas-v2';
  const AUTH_KEY = 'galileo-admin-auth';
  const $ = (sel, root) => (root || document).querySelector(sel);

  const COLOR_OPTIONS = [
    { value: 'bg-brand-500', label: 'Naranja' },
    { value: 'bg-navy-600', label: 'Azul marino' },
    { value: 'bg-emerald-500', label: 'Verde' },
    { value: 'bg-purple-500', label: 'Morado' },
    { value: 'bg-rose-500', label: 'Rosa' },
    { value: 'bg-amber-500', label: 'Ámbar' },
    { value: 'bg-sky-500', label: 'Celeste' },
    { value: 'bg-slate-500', label: 'Gris' },
  ];

  function saveLocal() {
    try {
      localStorage.setItem(KEY, JSON.stringify(data));
      window.dispatchEvent(new CustomEvent('galileo-data-changed'));
    } catch (e) {
      console.error('Error al guardar localmente:', e);
    }
  }

  function loadLocal() {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return null;
      const parsed = JSON.parse(raw);
      return {
        sections: Array.isArray(parsed.sections) ? parsed.sections : JSON.parse(JSON.stringify(DEFAULT_DATA.sections)),
        sports: Array.isArray(parsed.sports) ? parsed.sports : [...DEFAULT_DATA.sports],
        games: Array.isArray(parsed.games) ? parsed.games : JSON.parse(JSON.stringify(DEFAULT_DATA.games)),
        heroStats: parsed.heroStats || { ...DEFAULT_DATA.heroStats },
        prizes: Array.isArray(parsed.prizes) ? parsed.prizes : [...DEFAULT_DATA.prizes],
      };
    } catch { return null; }
  }

  // Firebase initialization
  let firebaseDb = null;
  let firebaseReady = false;
  let firebaseFuncs = null;

  async function initFirebase() {
    if (firebaseReady) return firebaseFuncs;
    try {
      const firebaseApp = await import('https://www.gstatic.com/firebasejs/10.12.0/firebase-app.js');
      const firebaseFirestore = await import('https://www.gstatic.com/firebasejs/10.12.0/firebase-firestore.js');
      
      const { initializeApp, getApps, getApp } = firebaseApp;
      const { getFirestore, doc, getDoc, setDoc, initializeFirestore, experimentalForceLongPolling } = firebaseFirestore;
      
      const firebaseConfig = {
        apiKey: "AIzaSyAgjrkE_Ah-mKOm8naH-aFEB7UrschO40o",
        authDomain: "galiweb-4cc7d.firebaseapp.com",
        projectId: "galiweb-4cc7d",
        storageBucket: "galiweb-4cc7d.firebasestorage.app",
        messagingSenderId: "192323726068",
        appId: "1:192323726068:web:9cebbbd6d9e20c12ce0ca1"
      };
      
      const app = getApps().length === 0 ? initializeApp(firebaseConfig) : getApp();
      
      // Use REST/long polling to avoid ad blockers
      firebaseDb = initializeFirestore(app, {
        experimentalForceLongPolling: true,
        experimentalAutoDetectLongPolling: true
      });
      
      firebaseFuncs = { doc, getDoc, setDoc };
      firebaseReady = true;
      console.log('[Firebase] Initialized with REST mode');
      return firebaseFuncs;
    } catch (error) {
      console.error('[Firebase] Init error:', error);
      return null;
    }
  }

  async function save() {
    saveLocal();
    // Save to Firebase directly
    try {
      const funcs = await initFirebase();
      if (!funcs) return false;
      
      const docRef = funcs.doc(firebaseDb, 'olimpiadas', 'olimpiadas-data');
      await funcs.setDoc(docRef, data);
      console.log('[Firebase] Data saved');
      return true;
    } catch (e) {
      console.warn('[Firebase] Save error:', e);
      return false;
    }
  }

  async function loadFromCloud() {
    try {
      const funcs = await initFirebase();
      if (!funcs) {
        console.warn('[Firebase] init failed');
        return null;
      }
      const docRef = funcs.doc(firebaseDb, 'olimpiadas', 'olimpiadas-data');
      const docSnap = await funcs.getDoc(docRef);
      if (docSnap.exists()) {
        const fb = docSnap.data();
        console.log('[Firebase] loaded:', fb);
        if (fb && fb.sections && fb.sports && fb.games) {
          return {
            sections: fb.sections || [],
            sports: fb.sports || [],
            games: fb.games || [],
            heroStats: fb.heroStats || { secciones: 0, disciplinas: 0, dias: 0 },
            prizes: fb.prizes || []
          };
        }
      }
    } catch (e) {
      console.warn('[Firebase] error:', e);
    }
    return null;
  }

  const esc = (s) => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

  let data = JSON.parse(JSON.stringify(DEFAULT_DATA));
  let isAuthed = sessionStorage.getItem(AUTH_KEY) === '1';
  let editingSportIdx = null;
  let editingGameId = null;
  let editingSectionId = null;

  function showLogin() { $('#login-card')?.classList.remove('hidden'); $('#admin-panel')?.classList.add('hidden'); }
  function showPanel() { $('#login-card')?.classList.add('hidden'); $('#admin-panel')?.classList.remove('hidden'); }

  function findSection(name) {
    const n = String(name || '').trim();
    return data.sections.find(s => s.name.trim() === n) || null;
  }

  function renderSections() {
    const tbody = $('#sections-tbody');
    if (!tbody) return;
    if (!data.sections.length) {
      tbody.innerHTML = '<tr><td colspan="4" class="px-3 py-4 text-center text-sm text-slate-500">No hay secciones.</td></tr>';
      return;
    }
    tbody.innerHTML = data.sections.map(s => {
      const inUse = data.games.some(g => g.local === s.name || g.visit === s.name);
      return `<tr>
        <td class="px-3 py-2"><span class="flex h-7 w-7 items-center justify-center rounded-full ${s.color} text-xs font-extrabold text-white">${esc(s.initial)}</span></td>
        <td class="px-3 py-2 font-semibold text-navy-700">${esc(s.name)}</td>
        <td class="px-3 py-2 text-slate-600">${esc(COLOR_OPTIONS.find(c => c.value === s.color)?.label || s.color)}</td>
        <td class="px-3 py-2 text-right">
          <button type="button" data-edit-section="${s.id}" class="rounded-md bg-slate-100 px-2 py-1 text-xs font-semibold text-slate-700 hover:bg-slate-200">Editar</button>
          <button type="button" data-delete-section="${s.id}" class="ml-1 rounded-md bg-red-50 px-2 py-1 text-xs font-semibold text-red-600 hover:bg-red-100 ${inUse ? 'opacity-50 cursor-not-allowed' : ''}" ${inUse ? 'disabled title="En uso"' : ''}>Eliminar</button>
        </td>
      </tr>`;
    }).join('');
  }

  function renderSports() {
    const list = $('#sports-list');
    if (!list) return;
    if (!data.sports.length) {
      list.innerHTML = '<p class="text-sm text-slate-500">No hay disciplinas.</p>';
      return;
    }
    list.innerHTML = data.sports.map((name, idx) =>
      `<span class="inline-flex items-center gap-2 rounded-full bg-slate-100 px-3 py-1.5 text-xs font-semibold text-slate-700">
        ${esc(name)}
        <button type="button" data-edit-sport="${idx}" class="rounded-full bg-white px-1.5 text-[10px] font-bold text-slate-500 hover:text-brand-500">✎</button>
        <button type="button" data-delete-sport="${idx}" class="rounded-full bg-white px-1.5 text-[10px] font-bold text-slate-500 hover:text-red-500">✕</button>
      </span>`
    ).join('');
  }

  function renderGames() {
    const list = $('#games-tbody');
    if (!list) return;
    if (!data.games.length) {
      list.innerHTML = '<p class="col-span-full text-center text-sm text-slate-500">No hay partidos.</p>';
      return;
    }
    list.innerHTML = data.games.map(g => {
      const live = (g.status || '').includes('En vivo');
      const ls = findSection(g.local);
      const vs = findSection(g.visit);
      return `<article data-game-id="${g.id}" class="rounded-2xl border border-slate-200 p-4 transition hover:border-brand-300 ${live ? 'ring-2 ring-brand-400' : ''}">
        <div class="flex items-center justify-between">
          <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase text-slate-600">${esc(g.sport || 'Sin deporte')}</span>
          <span class="inline-flex items-center gap-1 rounded-full px-2.5 py-1 text-[10px] font-bold ${live ? 'bg-brand-500 text-white' : 'bg-slate-100 text-slate-600'}">
            ${live ? '<span class="h-1.5 w-1.5 rounded-full bg-white animate-pulse"></span>' : ''}${esc(g.status || 'Sin estado')}
          </span>
        </div>
        <div class="mt-3 flex items-center justify-between gap-2 text-center">
          <div>
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full ${ls?.color || 'bg-slate-500'} text-sm font-extrabold text-white">${esc(ls?.initial ?? '?')}</div>
            <p class="mt-1 text-[11px] font-semibold text-slate-700">${esc(g.local)}</p>
          </div>
          <p class="text-2xl font-black text-navy-700 tabular-nums">
            <span data-score-local="${g.id}">${g.localScore}</span> <span class="text-slate-400">-</span> <span data-score-visit="${g.id}">${g.visitScore}</span>
          </p>
          <div>
            <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full ${vs?.color || 'bg-slate-500'} text-sm font-extrabold text-white">${esc(vs?.initial ?? '?')}</div>
            <p class="mt-1 text-[11px] font-semibold text-slate-700">${esc(g.visit)}</p>
          </div>
        </div>
        <p class="mt-2 text-center text-[10px] text-slate-500">${esc(g.date || '')}</p>
        <div class="mt-3 flex flex-wrap gap-1.5">
          <button type="button" data-score="local" data-delta="1" data-game-id="${g.id}" class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200">+1 ${esc(ls?.initial ?? 'L')}</button>
          <button type="button" data-score="visit" data-delta="1" data-game-id="${g.id}" class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200">+1 ${esc(vs?.initial ?? 'V')}</button>
          <button type="button" data-score="local" data-delta="-1" data-game-id="${g.id}" class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200">-1 ${esc(ls?.initial ?? 'L')}</button>
          <button type="button" data-score="visit" data-delta="-1" data-game-id="${g.id}" class="rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200">-1 ${esc(vs?.initial ?? 'V')}</button>
          <button type="button" data-toggle-live="${g.id}" class="rounded-md ${live ? 'bg-slate-700 text-white' : 'bg-brand-500 text-white'} px-2 py-1 text-[11px] font-semibold hover:opacity-90">${live ? 'Quitar en vivo' : 'Marcar en vivo'}</button>
          <button type="button" data-edit-game="${g.id}" class="ml-auto rounded-md bg-slate-100 px-2 py-1 text-[11px] font-semibold text-slate-700 hover:bg-slate-200">Editar</button>
          <button type="button" data-delete-game="${g.id}" class="rounded-md bg-red-50 px-2 py-1 text-[11px] font-semibold text-red-600 hover:bg-red-100">Eliminar</button>
        </div>
      </article>`;
    }).join('');
  }

  function renderStatsForm() {
    const form = $('#stats-form');
    if (!form) return;
    form.elements['secciones'].value = data.heroStats.secciones;
    form.elements['disciplinas'].value = data.heroStats.disciplinas;
    form.elements['dias'].value = data.heroStats.dias;
  }

  function renderSummary() {
    const live = data.games.filter(g => (g.status || '').includes('En vivo')).length;
    const finished = data.games.filter(g => (g.status || '').includes('Finalizado')).length;
    const lEl = $('[data-summary-live]');
    const fEl = $('[data-summary-finished]');
    const sEl = $('[data-summary-sections]');
    const spEl = $('[data-summary-sports]');
    if (lEl) lEl.textContent = String(live);
    if (fEl) fEl.textContent = String(finished);
    if (sEl) sEl.textContent = String(data.sections.length);
    if (spEl) spEl.textContent = String(data.sports.length);
  }

  function renderAll() { renderSections(); renderSports(); renderGames(); renderStatsForm(); renderSummary(); renderPrizes(); }

  function openModal(title, formHtml) {
    const root = $('#modal-root');
    root.innerHTML = `<div id="modal-backdrop" class="fixed inset-0 z-50 flex items-end justify-center bg-slate-900/60 p-0 sm:items-center sm:p-4">
      <div class="w-full max-w-lg overflow-hidden rounded-t-2xl bg-white shadow-2xl ring-1 ring-slate-200 sm:rounded-2xl">
        <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
          <h3 class="text-base font-extrabold text-navy-700 sm:text-lg">${esc(title)}</h3>
          <button type="button" id="modal-close" class="rounded-full p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-700">
            <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 6l12 12 M18 6L6 18"/></svg>
          </button>
        </div>
        <div class="max-h-[80vh] overflow-y-auto p-5">${formHtml}</div>
      </div>
    </div>`;
    $('#modal-backdrop').addEventListener('click', (e) => { if (e.target === e.currentTarget) closeModal(); });
    $('#modal-close').addEventListener('click', closeModal);
  }
  function closeModal() { const r = $('#modal-root'); if (r) r.innerHTML = ''; }

  function buildSectionForm(s) {
    s = s || { id: '', name: '', color: 'bg-brand-500', initial: '' };
    return `<form id="section-form" class="space-y-4">
      <input type="hidden" name="id" value="${esc(s.id)}" />
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Nombre</span>
        <input name="name" required maxlength="40" value="${esc(s.name)}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="Sección E" />
      </label>
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Inicial (1 carácter)</span>
        <input name="initial" required maxlength="2" value="${esc(s.initial)}" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none" placeholder="E" />
      </label>
      <label class="block"><span class="text-xs font-bold uppercase tracking-wider text-slate-600">Color</span>
        <select name="color" class="mt-2 w-full rounded-xl border border-slate-200 bg-slate-50 px-4 py-2.5 text-sm focus:border-brand-500 focus:bg-white focus:ring-2 focus:ring-brand-200 focus:outline-none">
