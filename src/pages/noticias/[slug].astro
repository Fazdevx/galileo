---
/**
 * Detalle de una noticia: /noticias/<slug>
 *
 * No se prerenderiza. Las noticias se crean desde el panel /admin despues del
 * build, asi que un getStaticPaths soloKnowneria los slugs que ya existian al
 * compilar y las nuevas darian 404.
 *
 * Para el SEO se intenta una lectura directa a Firestore desde el servidor
 * (las reglas permiten lectura publica). Si esa lectura falla por red o por
 * configuracion, se responde 200 y se resuelve en el cliente, para no marcar
 * como inexistente una noticia que si existe.
 */
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { NOTICIAS_SEED, ordenar, formatearFecha, desdeDocFirestore, imagenDe, type Noticia } from '../../data/noticias';
import { PROJECT_ID, API_KEY } from '../../lib/firebase.config';
import { tarjetasHTML } from '../../lib/noticiaMarkup';

export const prerender = false;

const { slug = '' } = Astro.params;
const COLECCION = 'noticias';

/** Lectura puntual por documento desde el servidor. null = no existe. undefined = no se pudo saber. */
async function leerNoticiaDelServidor(s: string): Promise<Noticia | null | undefined> {
  if (!s || !PROJECT_ID || !API_KEY) return undefined;
  const url = `https://firestore.googleapis.com/v1/projects/${PROJECT_ID}/databases/(default)/documents/${COLECCION}/${encodeURIComponent(s)}`;
  try {
    const res = await fetch(url, { headers: { Authorization: `Bearer ${API_KEY}` } });
    if (res.status === 404) return null;
    if (!res.ok) return undefined;
    return desdeDocFirestore(await res.json(), s) ?? undefined;
  } catch {
    return undefined;
  }
}

const remota = await leerNoticiaDelServidor(slug);
const semilla = NOTICIAS_SEED.find((n) => n.slug === slug) ?? null;

// Solo marcamos 404 si el servidor pudo confirmar que no existe.
if (remota === null && !semilla) Astro.response.status = 404;

const noticia: Noticia | null = remota ?? semilla;
const fecha = noticia ? formatearFecha(noticia.fecha) : '';

/** Foto grande de la cabecera. Nunca sale vacía: cae en la de la categoría. */
const foto = noticia ? imagenDe(noticia, 'full') : '';

/**
 * Relacionadas: otras tres de la misma categoría y, si no alcanzan, las más
 * recientes. Se calculan con la semilla porque es lo que hay en el servidor;
 * el script del cliente no las toca.
 */
const relacionadas = noticia
  ? ordenar(NOTICIAS_SEED.filter((n) => n.publicado && n.slug !== noticia.slug))
      .sort((a, b) => Number(b.categoria === noticia.categoria) - Number(a.categoria === noticia.categoria))
      .slice(0, 3)
  : [];
---

<Layout
  title={noticia ? `${noticia.titulo} | Noticias Galileo` : 'Noticias | Colegio y Academia Galileo'}
  description={noticia?.resumen || 'Noticias del Colegio y Academia Galileo en Huacho.'}
  ogImage={noticia?.imagen || undefined}
>
  <Header />
  <main id="contenido">
    {noticia ? (
      <article>
        {/* Cabecera: la foto ocupa el fondo y el texto va sobre ella. */}
        <header class="relative isolate overflow-hidden bg-navy-900">
          {foto && (
            <img
              src={foto}
              alt=""
              width="1200"
              height="675"
              loading="eager"
              decoding="async"
              fetchpriority="high"
              aria-hidden="true"
              class="absolute inset-0 -z-10 h-full w-full object-cover"
            />
          )}
          {/* Velo azul. Solo se oscurece lo justo para que el título se lea:
              la foto va a opacidad completa y la capa es translúcida, para que
              se vea la imagen de verdad y no una mancha navy. */}
          <div
            class="absolute inset-0 -z-10 bg-gradient-to-br from-navy-900/95 via-navy-900/70 to-navy-800/45"
            aria-hidden="true"
          />

          <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
            <nav aria-label="Migas de pan" class="text-sm text-navy-200">
              <a href="/" class="transition hover:text-white">
                Inicio
              </a>
              <span aria-hidden="true" class="mx-2">
                /
              </span>
              <a href="/noticias" class="transition hover:text-white">
                Noticias
              </a>
            </nav>

            <div class="mt-6 flex flex-wrap items-center gap-3">
              <span class="rounded-full bg-brand-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">
                {noticia.categoria}
              </span>
              {fecha && (
                <time class="text-sm font-medium text-navy-200" datetime={noticia.fecha}>
                  {fecha}
                </time>
              )}
            </div>

            <h1 class="mt-5 text-3xl font-black leading-tight text-white sm:text-4xl lg:text-5xl">{noticia.titulo}</h1>

            {noticia.resumen && <p class="mt-5 text-lg leading-relaxed text-navy-100">{noticia.resumen}</p>}
          </div>

          {/* Filete de marca, igual que el hero del home. */}
          <div class="h-1.5 w-full bg-gradient-to-r from-brand-500 via-brand-400 to-navy-600" aria-hidden="true" />
        </header>

        {/* Cuerpo */}
        <div class="bg-white py-12 sm:py-16">
          <div class="mx-auto max-w-3xl px-4 sm:px-6">
            <div class="space-y-5" data-noticia-cuerpo>
              {noticia.cuerpo.map((parrafo, i) => (
                <p class:list={['leading-relaxed text-slate-700', i === 0 ? 'text-lg text-slate-800' : 'text-base']}>
                  {parrafo}
                </p>
              ))}
            </div>

            {noticia.cuerpo.length === 0 && (
              <p class="rounded-2xl bg-slate-50 p-6 text-slate-500 ring-1 ring-slate-200">
                Esta noticia todavía no tiene texto. Vuelve pronto.
              </p>
            )}

            <div class="mt-12 flex flex-wrap items-center justify-between gap-4 border-t border-slate-200 pt-8">
              <a
                href="/noticias"
                class="inline-flex items-center gap-2 font-bold text-brand-600 transition hover:gap-3 hover:text-brand-700"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  class="h-4 w-4"
                  aria-hidden="true"
                >
                  <path d="M19 12H5M11 18l-6-6 6-6" />
                </svg>
                Volver a noticias
              </a>

              <a
                href="/#contacto"
                class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-6 py-3 text-sm font-bold text-white shadow-sm transition hover:-translate-y-0.5 hover:bg-brand-600"
              >
                Escríbenos por WhatsApp
              </a>
            </div>
          </div>
        </div>

        {/* Relacionadas */}
        {relacionadas.length > 0 && (
          <section class="border-t border-slate-200 bg-slate-50 py-14 sm:py-16" aria-labelledby="relacionadas-titulo">
            <div class="mx-auto max-w-7xl px-4 sm:px-6">
              <p class="text-sm font-bold uppercase tracking-widest text-brand-600">Sigue leyendo</p>
              <h2 id="relacionadas-titulo" class="mt-2 text-2xl font-black text-navy-800 sm:text-3xl">
                También te puede interesar
              </h2>

              <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3" set:html={tarjetasHTML(relacionadas)} />
            </div>
          </section>
        )}
      </article>
    ) : (
      <section class="bg-white py-20 sm:py-28">
        <div class="mx-auto max-w-2xl px-4 text-center sm:px-6">
          <p class="text-6xl font-black text-slate-200">404</p>
          <h1 class="mt-4 text-3xl font-black text-navy-800">No encontramos esta noticia</h1>
          <p class="mt-3 text-slate-600">Es posible que se haya retirado o que el enlace esté mal escrito.</p>
          <a
            href="/noticias"
            class="mt-8 inline-block rounded-full bg-navy-800 px-6 py-3 text-sm font-bold text-white transition hover:bg-navy-700"
          >
            Ver todas las noticias
          </a>
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>

<script define:vars={{ slug }}>
  import { fetchNoticias, formatearFecha, imagenDe } from '../../data/noticias';
  import { esc } from '../../lib/text';

  (async () => {
    // Si el servidor ya entrego la noticia, no hay nada que hacer.
    if (document.querySelector('article')) return;

    const noticias = await fetchNoticias();
    const n = noticias.find((x) => x.slug === slug);
    if (!n) return;

    const main = document.querySelector('main, #contenido') || document.body;
    const fecha = formatearFecha(n.fecha);
    const foto = imagenDe(n, 'full');

    main.innerHTML = `<article>
      <header class="relative isolate overflow-hidden bg-navy-900">
        ${foto ? `<img src="${esc(foto)}" alt="" width="1200" height="675" class="absolute inset-0 -z-10 h-full w-full object-cover" aria-hidden="true">` : ''}
        <div class="absolute inset-0 -z-10 bg-gradient-to-br from-navy-900/95 via-navy-900/70 to-navy-800/45" aria-hidden="true"></div>
        <div class="mx-auto max-w-4xl px-4 py-14 sm:px-6 sm:py-20">
          <nav aria-label="Migas de pan" class="text-sm text-navy-200">
            <a href="/" class="transition hover:text-white">Inicio</a>
            <span aria-hidden="true" class="mx-2">/</span>
            <a href="/noticias" class="transition hover:text-white">Noticias</a>
          </nav>
          <div class="mt-6 flex flex-wrap items-center gap-3">
            <span class="rounded-full bg-brand-500 px-3 py-1 text-xs font-bold uppercase tracking-wider text-white">${esc(n.categoria)}</span>
            ${fecha ? `<time class="text-sm font-medium text-navy-200" datetime="${esc(n.fecha)}">${esc(fecha)}</time>` : ''}
          </div>
          <h1 class="mt-5 text-3xl font-black leading-tight text-white sm:text-4xl lg:text-5xl">${esc(n.titulo)}</h1>
          ${n.resumen ? `<p class="mt-5 text-lg leading-relaxed text-navy-100">${esc(n.resumen)}</p>` : ''}
        </div>
        <div class="h-1.5 w-full bg-gradient-to-r from-brand-500 via-brand-400 to-navy-600" aria-hidden="true"></div>
      </header>
      <div class="bg-white py-12 sm:py-16">
        <div class="mx-auto max-w-3xl px-4 sm:px-6">
          <div class="space-y-5">${(n.cuerpo || []).map((p, i) => `<p class="${i === 0 ? 'text-lg leading-relaxed text-slate-800' : 'text-base leading-relaxed text-slate-700'}">${esc(p)}</p>`).join('')}</div>
          <div class="mt-12 border-t border-slate-200 pt-8">
            <a href="/noticias" class="font-bold text-brand-600 hover:text-brand-700">Volver a noticias</a>
          </div>
        </div>
      </div>
    </article>`;

    document.title = `${n.titulo} | Noticias Galileo`;
  })();
</script>
