---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import aniversarioImg from '../assets/hero_aniversario.jpg';
import logoSrc from '../assets/logo.webp';
import { waLink, TRAYECTORIA, ANIOS_ANTIGUEDAD } from '../data/site';

interface Slide {
  id: string;
  eyebrow: string;
  title: string;
  titleAccent: string;
  accentClass: string;
  description: string;
  primaryCta: { label: string; href: string; style: string; openModal?: boolean };
  secondaryCta: { label: string; href: string; style: string };
  bg: string;
  badge: { text: string; href?: string; live?: boolean };
  floating: { side: string; label: string; value: string; style: string };
  card: { side: string; icon: string; title: string; live?: boolean; href?: string };
  stats: { value: string; label: string }[];
  image?: ImageMetadata;
  imageWidth?: number;
  imageHeight?: number;
  imageFill?: boolean;
}

const waFelicitaciones = waLink(
  '¡Feliz aniversario, Colegio Galileo! 🎉 Te deseamos todo lo mejor en este día especial.',
);

// El primer elemento es el slide inicial del carrusel: la celebración del
// aniversario con la actividad de las manitos pintadas.
const slides: Slide[] = [
  {
    id: 'aniversario',
    eyebrow: 'Mes de Aniversario · Familia Galileana',
    title: '¡Así celebramos nuestro',
    titleAccent: 'aniversario!',
    accentClass: 'text-brand-300',
    description:
      'Los niños de 3, 4 y 5 años fueron los protagonistas de nuestra primera actividad: pintaron sus manitas y dejaron sus huellitas de colores, dando inicio al Mes de Aniversario. Cada huellita es una sonrisa y la alegría de crecer juntos como parte de la Familia Galileana.',
    primaryCta: {
      label: 'Envía tus felicitaciones',
      href: waFelicitaciones,
      style: 'bg-brand-500 hover:bg-brand-600',
    },
    secondaryCta: {
      label: 'Conoce nuestra historia',
      href: '/nosotros',
      style: 'border-2 border-white hover:bg-white hover:text-brand-600',
    },
    // La foto de las manitas pintadas mide 2048x1365: entra recortada en el
    // cuadro cuadrado, así que no fijamos width/height y dejamos que Astro
    // derive el srcset.
    image: aniversarioImg,
    imageWidth: 2048,
    imageHeight: 1365,
    imageFill: true,
    bg: 'from-navy-700 via-navy-800 to-brand-600',
    badge: {
      text: 'Celebrado: 1 de Octubre',
      href: '/nosotros',
      live: false,
    },
    floating: {
      side: 'left',
      label: 'Mes de aniversario',
      value: 'Octubre',
      style: 'bg-brand-500 text-white',
    },
    card: {
      side: 'right',
      icon: 'cake',
      title: 'Manitos pintadas',
      live: false,
      href: '/nosotros',
    },
    stats: [
      { value: '3, 4 y 5', label: 'Años que pintaron' },
      { value: '01', label: 'Mes de aniversario' },
      { value: String(ANIOS_ANTIGUEDAD), label: 'Años del colegio' },
    ],
  },
  {
    id: 'colegio',
    eyebrow: 'Colegio & Academia Galileo',
    title: 'Formamos el futuro con',
    titleAccent: 'educación de excelencia',
    accentClass: 'text-navy-700',
    description: `Nuestra academia combina enseñanza personalizada, tecnología y valores para preparar a los estudiantes desde inicial hasta preuniversitario. Con ${TRAYECTORIA}, ofrecemos un ambiente inclusivo y de alto rendimiento académico.`,
    primaryCta: {
      label: 'Matricúlate',
      href: '#prematricula',
      style: 'bg-navy-700 hover:bg-navy-800',
      openModal: true,
    },
    secondaryCta: {
      label: 'Conoce la academia',
      href: '/nosotros',
      style: 'border-2 border-white hover:bg-white hover:text-brand-600',
    },
    bg: 'from-brand-500 via-brand-600 to-brand-700',
    badge: {
      text: 'Olimpiadas Internas 2026',
      href: '/olimpiadas',
      live: true,
    },
    floating: {
      side: 'left',
      label: 'Próximo inicio',
      value: 'Marzo 2026',
      style: 'bg-navy-700 text-white',
    },
    card: {
      side: 'right',
      icon: 'trophy',
      title: 'Olimpiadas 2026',
      live: true,
      href: '/olimpiadas',
    },
    stats: [
      { value: String(ANIOS_ANTIGUEDAD), label: 'Años de antigüedad' },
      { value: '1500+', label: 'Estudiantes' },
      { value: '98%', label: 'Ingresantes' },
    ],
    image: logoSrc,
    imageWidth: 480,
    imageHeight: 166,
  },
];
---

<section id="inicio" class="relative text-white" aria-roledescription="carrusel" aria-label="Novedades del colegio">
  <div class="relative">
    <div class="grid">
      {slides.map((slide, idx) => (
        <div
          class:list={[
            'col-start-1 row-start-1 transition-opacity duration-700 ease-in-out motion-reduce:transition-none',
            idx === 0 ? 'opacity-100 z-10' : 'opacity-0 z-0 pointer-events-none',
          ]}
          data-slide={idx}
          data-anniversary-slide={slide.id === 'aniversario' ? '' : undefined}
          aria-hidden={idx !== 0}
          inert={idx !== 0}
        >
          <div class:list={['bg-gradient-to-br', slide.bg]}>
            <div class="relative">
              <div class="absolute inset-0 opacity-10">
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 100 100"
                  preserveAspectRatio="none"
                  class="h-full w-full"
                >
                  <circle cx="20" cy="30" r="2" fill="white" />
                  <circle cx="80" cy="60" r="2" fill="white" />
                  <circle cx="50" cy="80" r="2" fill="white" />
                  <circle cx="10" cy="70" r="2" fill="white" />
                  <circle cx="90" cy="20" r="2" fill="white" />
                </svg>
              </div>
              <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 md:grid-cols-2 md:gap-12 md:py-28">
                <div>
                  <span class="inline-block rounded-full bg-white/10 px-4 py-1 text-xs font-medium backdrop-blur sm:text-sm">
                    {slide.eyebrow}
                  </span>
                  <h1 class="mt-6 text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl lg:text-6xl">
                    {slide.title} <span class:list={[slide.accentClass]}>{slide.titleAccent}</span>
                  </h1>

                  <a
                    href={slide.badge.href}
                    class="mt-5 inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-2.5 text-xs font-bold text-white shadow-lg backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/20 sm:px-5 sm:text-sm"
                  >
                    <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-500">
                      <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-3.5 w-3.5 text-white"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                      >
                        <path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z" />
                      </svg>
                    </span>
                    <span class="flex items-center gap-2">
                      {slide.badge.live && (
                        <span class="rounded-full bg-emerald-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-100">
                          En vivo
                        </span>
                      )}
                      <span class="hidden sm:inline">{slide.badge.text}</span>
                      <span class="sm:hidden">{slide.badge.text.split(' ').slice(0, 2).join(' ')}</span>
                    </span>
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="h-4 w-4"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M9 5l7 7-7 7" />
                    </svg>
                  </a>

                  <p class="mt-6 text-base text-white/90 sm:text-lg md:text-xl">{slide.description}</p>

                  <div class="mt-8 flex flex-wrap gap-3 sm:gap-4">
                    {slide.primaryCta.openModal ? (
                      <button
                        id="btn-matriculate-hero"
                        type="button"
                        class:list={[
                          'rounded-full px-6 py-3 text-sm font-bold text-white shadow-lg transition sm:px-8 sm:text-base',
                          slide.primaryCta.style,
                        ]}
                      >
                        {slide.primaryCta.label}
                      </button>
                    ) : (
                      <a
                        href={slide.primaryCta.href}
                        class:list={[
                          'rounded-full px-6 py-3 text-sm font-bold text-white shadow-lg transition sm:px-8 sm:text-base',
                          slide.primaryCta.style,
                        ]}
                      >
                        {slide.primaryCta.label}
                      </a>
                    )}
                    <a
                      href={slide.secondaryCta.href}
                      class:list={[
                        'rounded-full px-6 py-3 text-sm font-semibold transition sm:px-8 sm:text-base',
                        slide.secondaryCta.style,
                      ]}
                    >
                      {slide.secondaryCta.label}
                    </a>
                  </div>
                  <div class="mt-8 grid grid-cols-3 gap-3 border-t border-white/20 pt-6 sm:mt-10 sm:gap-6 sm:pt-8">
                    {slide.stats.map((stat) => (
                      <div>
                        <p class="text-2xl font-bold text-navy-100 sm:text-3xl">{stat.value}</p>
                        <p class="text-xs text-white/90 sm:text-sm">{stat.label}</p>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="relative mx-auto w-full max-w-sm md:max-w-none">
                  <div
                    class:list={[
                      'aspect-square overflow-hidden rounded-3xl bg-white/95 shadow-2xl backdrop-blur flex items-center justify-center',
                      slide.imageFill ? '' : 'p-6 sm:p-8',
                    ]}
                  >
                    <Image
                      src={slide.image!}
                      alt={slide.eyebrow}
                      // width/height fijos con `widths` collapsing el srcset a una
                      // sola entrada: para las imágenes que llenan el cuadro
                      // dejamos que Astro derive el tamaño de `widths`.
                      width={slide.imageFill ? undefined : slide.imageWidth}
                      height={slide.imageFill ? undefined : slide.imageHeight}
                      widths={[640, 828, 1080, 1200, 1920]}
                      sizes="(min-width: 1024px) 38vw, (min-width: 768px) 45vw, 100vw"
                      loading={idx === 0 ? 'eager' : 'lazy'}
                      fetchpriority={idx === 0 ? 'high' : 'auto'}
                      quality={90}
                      class:list={['w-full h-auto', slide.imageFill && 'h-full w-full object-cover']}
                    />
                  </div>

                  <div
                    class:list={[
                      'absolute rounded-2xl p-3 shadow-xl sm:p-4',
                      slide.floating.style,
                      slide.floating.side === 'left'
                        ? '-bottom-4 -left-4 sm:-bottom-6 sm:-left-6'
                        : '-bottom-4 -right-4 sm:-bottom-6 sm:-right-6',
                    ]}
                  >
                    <p class="text-xs font-semibold opacity-80 sm:text-sm">{slide.floating.label}</p>
                    <p class="text-lg font-bold sm:text-2xl">{slide.floating.value}</p>
                  </div>

                  <a
                    href={slide.card.href}
                    class:list={[
                      'absolute inline-flex items-center gap-2 rounded-2xl bg-white p-2.5 shadow-xl border-2 border-brand-500 transition hover:-translate-y-1 sm:gap-3 sm:p-4',
                      slide.card.side === 'right'
                        ? '-top-4 -right-4 sm:-top-6 sm:-right-6'
                        : '-top-4 -left-4 sm:-top-6 sm:-left-6',
                    ]}
                  >
                    <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-500 text-white sm:h-10 sm:w-10">
                      {slide.card.icon === 'trophy' && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 sm:h-5 sm:w-5"
                          fill="currentColor"
                          viewBox="0 0 20 20"
                        >
                          <path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z" />
                        </svg>
                      )}
                      {slide.card.icon === 'soccer' && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 sm:h-5 sm:w-5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <path d="M12 2l3 7h7 M12 22l-3-7h-7 M2 12l7-3 M22 12l-7 3" />
                        </svg>
                      )}
                      {slide.card.icon === 'cake' && (
                        <svg
                          xmlns="http://www.w3.org/2000/svg"
                          class="h-4 w-4 sm:h-5 sm:w-5"
                          fill="none"
                          viewBox="0 0 24 24"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <path d="M20 12v10H4V12 M2 7h20v5H2z M12 22V7 M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" />
                        </svg>
                      )}
                    </span>
                    <span>
                      {slide.card.live && (
                        <span class="block text-[9px] font-bold uppercase tracking-wider text-emerald-600 sm:text-[10px]">
                          En vivo
                        </span>
                      )}
                      <span class="block text-xs font-extrabold text-navy-700 sm:text-sm">{slide.card.title}</span>
                    </span>
                  </a>
                </div>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <div class="relative mx-auto flex max-w-7xl items-center justify-between px-4 pb-8 pt-2 sm:px-6 sm:pb-10">
      <button
        id="hero-prev"
        aria-label="Anterior"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M15 18l-6-6 6-6"></path>
        </svg>
      </button>

      <div id="hero-dots" class="flex gap-2">
        {slides.map((_, idx) => (
          <button
            class:list={[
              'h-2.5 rounded-full transition-all',
              idx === 0 ? 'w-10 bg-white' : 'w-2.5 bg-white/40 hover:bg-white/70',
            ]}
            data-dot={idx}
            aria-label={`Ir al slide ${idx + 1}`}
          />
        ))}
      </div>

      <button
        id="hero-next"
        aria-label="Siguiente"
        class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="2.5"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M9 18l6-6-6-6"></path>
        </svg>
      </button>
    </div>
  </div>
</section>

<script>
  const slides = document.querySelectorAll('[data-slide]');
  const dots = document.querySelectorAll('[data-dot]');
  const prevBtn = document.getElementById('hero-prev');
  const nextBtn = document.getElementById('hero-next');
  let current = 0;
  let timer: ReturnType<typeof setInterval> | null = null;

  const show = (idx: number) => {
    slides.forEach((s, i) => {
      const active = i === idx;
      s.setAttribute('aria-hidden', String(!active));
      // Off-screen slides stay in the DOM, so without this their CTAs
      // would still be reachable by keyboard and read by screen readers.
      s.toggleAttribute('inert', !active);
      if (active) {
        s.classList.remove('opacity-0', 'z-0', 'pointer-events-none');
        s.classList.add('opacity-100', 'z-10');
      } else {
        s.classList.remove('opacity-100', 'z-10');
        s.classList.add('opacity-0', 'z-0', 'pointer-events-none');
      }
    });
    dots.forEach((d, i) => {
      d.setAttribute('aria-current', i === idx ? 'true' : 'false');
      if (i === idx) {
        d.classList.remove('w-2.5', 'bg-white/40');
        d.classList.add('w-10', 'bg-white');
      } else {
        d.classList.remove('w-10', 'bg-white');
        d.classList.add('w-2.5', 'bg-white/40');
      }
    });
    current = idx;
  };

  const next = () => show((current + 1) % slides.length);
  const prev = () => show((current - 1 + slides.length) % slides.length);

  // Todos los heroes rotan cada 5 s. Antes el slide del aniversario se quedaba
  // 10 s, pero ahora que es un mensaje corto la duración extra solo hacía el
  // carrusel más lento.
  const DWELL_MS = 5000;

  nextBtn?.addEventListener('click', () => {
    next();
    restart();
  });
  prevBtn?.addEventListener('click', () => {
    prev();
    restart();
  });
  dots.forEach((d, i) =>
    d.addEventListener('click', () => {
      show(i);
      restart();
    }),
  );

  const restart = () => {
    if (timer) clearInterval(timer);
    timer = setInterval(next, DWELL_MS);
  };

  const stop = () => {
    if (timer) clearInterval(timer);
    timer = null;
  };

// El carrusel siempre rota. Con movimiento reducido solo se quita el fundido
  // (motion-reduce:transition-none en el markup): apagar el autoplay dejaba el
  // primer slide como única vista posible en equipos sin animaciones.
  const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

  const hero = document.getElementById('inicio');
  hero?.addEventListener('mouseenter', stop);
  hero?.addEventListener('mouseleave', restart);
  hero?.addEventListener('focusin', stop);
  hero?.addEventListener('focusout', restart);
  hero?.addEventListener('keydown', (e) => {
    if (e.key === 'Tab') stop();
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
    else restart();
  });

  restart();

  // Confeti de bienvenida: el slide del aniversario ya no lleva cuenta atrás,
  // así que la celebración se dispara una vez al entrar a la página.
  (() => {
    if (motionQuery.matches) return;
    // Solo se celebra si el slide del aniversario es el que se muestra primero.
    if (!slides[0].hasAttribute('data-anniversary-slide')) return;

    const style = document.createElement('style');
    style.textContent =
      '@keyframes hero-confetti-fall{0%{transform:translateY(-4vh) rotate(0)}100%{transform:translateY(110vh) rotate(720deg)}}';
    document.head.appendChild(style);

    const COLORS = [
      '#ff6b1a',
      '#f04e00',
      '#ffa05c',
      '#ffc89b',
      '#ffffff',
      '#2d4173',
      '#1b2a4e',
      '#10b981',
      '#0ea5e9',
      '#f59e0b',
      '#ec4899',
    ];

    const fireConfetti = (pieces: number) => {
      const layer = document.createElement('div');
      layer.className = 'pointer-events-none fixed inset-0 z-[999] overflow-hidden';
      document.body.appendChild(layer);
      for (let i = 0; i < pieces; i++) {
        const p = document.createElement('span');
        const size = 6 + Math.random() * 8;
        p.style.cssText = [
          'position:absolute',
          'top:-24px',
          `left:${Math.random() * 100}%`,
          `width:${size}px`,
          `height:${size * (0.5 + Math.random() * 0.4)}px`,
          `background:${COLORS[Math.floor(Math.random() * COLORS.length)]}`,
          'border-radius:2px',
          `opacity:${0.6 + Math.random() * 0.4}`,
          `animation:hero-confetti-fall ${2.4 + Math.random() * 2.2}s linear ${Math.random() * 0.8}s forwards`,
        ].join(';');
        layer.appendChild(p);
      }
      setTimeout(() => layer.remove(), 6000);
    };

    const celebrate = () => {
      if (document.hidden) return;
      fireConfetti(140);
    };

    if (document.readyState === 'complete') celebrate();
    else window.addEventListener('load', celebrate, { once: true });
  })();
</script>
