---
import { getImage } from 'astro:assets';
import aniversarioImg from '../assets/aniversario.jpg';

const aniversarioUrl = (await getImage({ src: aniversarioImg, widths: [480, 800, 1200, 1600], formats: ['webp', 'avif'] })).src;

const waFelicitaciones = `https://wa.me/51997394157?text=${encodeURIComponent('¡Feliz aniversario, Colegio Galileo! 🎉 Te deseamos todo lo mejor en este día especial.')}`;
const slides = [
    {
        id: "colegio",
        eyebrow: "Colegio & Academia Galileo",
        title: "Formamos el futuro con",
        titleAccent: "educación de excelencia",
        accentClass: "text-navy-700",
        description:
            "Nuestra academia combina enseñanza personalizada, tecnología y valores para preparar a los estudiantes desde inicial hasta preuniversitario. Con más de 20 años de experiencia, ofrecemos un ambiente inclusivo y de alto rendimiento académico.",
        primaryCta: {
            label: "Matricúlate",
            href: "#prematricula",
            style: "bg-navy-700 hover:bg-navy-800",
            openModal: true,
        },
        secondaryCta: {
            label: "Conoce la academia",
            href: "/nosotros",
            style: "border-2 border-white hover:bg-white hover:text-brand-600",
        },
        bg: "from-brand-500 via-brand-600 to-brand-700",
        badge: {
            text: "Olimpiadas Internas 2026",
            href: "/olimpiadas",
            live: true,
        },
        floating: {
            side: "left",
            label: "Próximo inicio",
            value: "Marzo 2026",
            style: "bg-navy-700 text-white",
        },
        card: {
            side: "right",
            icon: "trophy",
            title: "Olimpiadas 2026",
            live: true,
            href: "/olimpiadas",
        },
        stats: [
            { value: "20+", label: "Años" },
            { value: "1500+", label: "Estudiantes" },
            { value: "98%", label: "Ingresantes" },
        ],
        image: "/logo.png",
    },
    {
        id: "olimpiadas",
        eyebrow: "Olimpiadas Internas · 2026",
        title: "La gran jornada",
        titleAccent: "entre secciones",
        accentClass: "text-brand-400",
        description:
            "Las cuatro secciones del colegio compiten en fútbol y vóley por la gloria deportiva. ¡Sigue los marcadores en vivo!",
        primaryCta: {
            label: "Ver resultados en vivo",
            href: "/olimpiadas",
            style: "bg-brand-500 hover:bg-brand-600",
        },
        secondaryCta: {
            label: "Inscribe tu sección",
            href: "/#contacto",
            style: "border-2 border-white hover:bg-white hover:text-navy-700",
        },
        bg: "from-navy-700 via-navy-800 to-brand-700",
        badge: { text: "Sección A vs Sección C", href: "/olimpiadas", live: true },
        floating: {
            side: "left",
            label: "En vivo ahora",
            value: "Fútbol · 78'",
            style: "bg-brand-500 text-white",
        },
        card: {
            side: "right",
            icon: "soccer",
            title: "Marcador en vivo",
            live: true,
            href: "/olimpiadas",
        },
        stats: [
            { value: "4", label: "Secciones" },
            { value: "2", label: "Disciplinas" },
            { value: "15", label: "Días" },
        ],
        image: "/escudo.png",
    },
    {
        id: "aniversario",
        eyebrow: "Aniversario del colegio",
        title: "Cuenta regresiva para",
        titleAccent: "el gran día",
        accentClass: "text-brand-300",
        description:
            "El 1 de octubre celebramos nuestro aniversario institucional. ¡Falta muy poco para festejarlo juntos!",
        countdown: true,
        target: "2026-10-01T08:00:00",
        primaryCta: {
            label: "Envía tus felicitaciones",
            href: waFelicitaciones,
            style: "bg-brand-500 hover:bg-brand-600",
        },
        secondaryCta: {
            label: "Conoce nuestra historia",
            href: "/nosotros",
            style: "border-2 border-white hover:bg-white hover:text-brand-600",
        },
        image: aniversarioUrl,
        imageFill: true,
        bg: "from-navy-700 via-navy-800 to-brand-600",
        badge: {
            text: "Próximo: 1 de Octubre",
            href: "/nosotros",
            live: false,
        },
        floating: {
            side: "left",
            label: "Fecha",
            value: "1 Octubre",
            style: "bg-brand-500 text-white",
        },
        card: {
            side: "right",
            icon: "cake",
            title: "Aniversario 2026",
            live: false,
            href: "/nosotros",
        },
        stats: [
            { value: "1", label: "Octubre" },
            { value: "8", label: "AM" },
            { value: "¡", label: "Únete" },
        ],
    },
];
---

<section id="inicio" class="relative text-white">
    <div class="relative">
        <div class="grid">
            {
                slides.map((slide, idx) => (
                    <div
                        class:list={[
                            "col-start-1 row-start-1 transition-opacity duration-700 ease-in-out",
                            idx === 0
                                ? "opacity-100 z-10"
                                : "opacity-0 z-0 pointer-events-none",
                        ]}
                        data-slide={idx}
                        aria-hidden={idx !== 0}
                    >
                        <div class:list={["bg-gradient-to-br", slide.bg]}>
                            <div class="relative">
                                <div class="absolute inset-0 opacity-10">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        viewBox="0 0 100 100"
                                        preserveAspectRatio="none"
                                        class="h-full w-full"
                                    >
                                        <circle
                                            cx="20"
                                            cy="30"
                                            r="2"
                                            fill="white"
                                        />
                                        <circle
                                            cx="80"
                                            cy="60"
                                            r="2"
                                            fill="white"
                                        />
                                        <circle
                                            cx="50"
                                            cy="80"
                                            r="2"
                                            fill="white"
                                        />
                                        <circle
                                            cx="10"
                                            cy="70"
                                            r="2"
                                            fill="white"
                                        />
                                        <circle
                                            cx="90"
                                            cy="20"
                                            r="2"
                                            fill="white"
                                        />
                                    </svg>
                                </div>
                                <div class="relative mx-auto grid max-w-7xl items-center gap-10 px-4 py-16 sm:px-6 sm:py-20 md:grid-cols-2 md:gap-12 md:py-28">
                                    <div>
                                        <span class="inline-block rounded-full bg-white/10 px-4 py-1 text-xs font-medium backdrop-blur sm:text-sm">
                                            {slide.eyebrow}
                                        </span>
                                        <h1 class="mt-6 text-3xl font-extrabold leading-tight sm:text-4xl md:text-5xl lg:text-6xl">
                                            {slide.title}{" "}
                                            <span
                                                class:list={[slide.accentClass]}
                                            >
                                                {slide.titleAccent}
                                            </span>
                                        </h1>

                                        <a
                                            href={slide.badge.href}
                                            class="mt-5 inline-flex items-center gap-3 rounded-full bg-white/10 px-4 py-2.5 text-xs font-bold text-white shadow-lg backdrop-blur transition hover:-translate-y-0.5 hover:bg-white/20 sm:px-5 sm:text-sm"
                                        >
                                            <span class="flex h-6 w-6 items-center justify-center rounded-full bg-brand-500">
                                                <svg
                                                    xmlns="http://www.w3.org/2000/svg"
                                                    class="h-3.5 w-3.5 text-white"
                                                    fill="currentColor"
                                                    viewBox="0 0 20 20"
                                                >
                                                    <path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z" />
                                                </svg>
                                            </span>
                                            <span class="flex items-center gap-2">
                                                {slide.badge.live && (
                                                    <span class="rounded-full bg-emerald-600 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-emerald-100">
                                                        En vivo
                                                    </span>
                                                )}
                                                <span class="hidden sm:inline">
                                                    {slide.badge.text}
                                                </span>
                                                <span class="sm:hidden">
                                                    {slide.badge.text
                                                        .split(" ")
                                                        .slice(0, 2)
                                                        .join(" ")}
                                                </span>
                                            </span>
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                class="h-4 w-4"
                                                fill="none"
                                                viewBox="0 0 24 24"
                                                stroke="currentColor"
                                                stroke-width="2.5"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                            >
                                                <path d="M9 5l7 7-7 7" />
                                            </svg>
                                        </a>

                                        <p class="mt-6 text-base text-white/90 sm:text-lg md:text-xl">
                                            {slide.description}
                                        </p>

                                        {slide.countdown && (
                                            <div class="mt-6 sm:mt-8">
                                                <div
                                                    data-hero-countdown
                                                    data-target={slide.target}
                                                    class="grid w-full max-w-md grid-cols-4 gap-2 sm:gap-3"
                                                >
                                                    <div class="rounded-2xl bg-white/10 p-2.5 text-center backdrop-blur sm:p-4">
                                                        <p data-count-days class="text-2xl font-black tabular-nums text-white sm:text-4xl">0</p>
                                                        <p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-white/80 sm:text-xs">Días</p>
                                                    </div>
                                                    <div class="rounded-2xl bg-white/10 p-2.5 text-center backdrop-blur sm:p-4">
                                                        <p data-count-hours class="text-2xl font-black tabular-nums text-white sm:text-4xl">0</p>
                                                        <p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-white/80 sm:text-xs">Horas</p>
                                                    </div>
                                                    <div class="rounded-2xl bg-white/10 p-2.5 text-center backdrop-blur sm:p-4">
                                                        <p data-count-minutes class="text-2xl font-black tabular-nums text-white sm:text-4xl">0</p>
                                                        <p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-white/80 sm:text-xs">Min</p>
                                                    </div>
                                                    <div class="rounded-2xl bg-white/10 p-2.5 text-center backdrop-blur sm:p-4">
                                                        <p data-count-seconds class="text-2xl font-black tabular-nums text-white sm:text-4xl">0</p>
                                                        <p class="mt-1 text-[10px] font-bold uppercase tracking-wider text-white/80 sm:text-xs">Seg</p>
                                                    </div>
                                                </div>

                                                <div data-count-celebrate class="hidden">
                                                    <p class="text-2xl font-black text-white sm:text-3xl">¡Feliz Aniversario, Galileo! 🎉</p>
                                                    <p class="mt-2 max-w-md text-sm text-white/90 sm:text-base">
                                                        Hoy celebramos otro año formando grandes personas. ¡Gracias por ser parte de nuestra familia!
                                                    </p>
                                                    <button
                                                        data-count-replay
                                                        type="button"
                                                        class="mt-4 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-brand-600 transition hover:bg-navy-100"
                                                    >
                                                        ¡Celebrar nuevamente! 🎊
                                                    </button>
                                                </div>
                                            </div>
                                        )}

                                        <div class="mt-8 flex flex-wrap gap-3 sm:gap-4">
                                            {slide.primaryCta.openModal ? (
                                                <button id="btn-matriculate-hero" type="button" class:list={[
                                                    "rounded-full px-6 py-3 text-sm font-bold text-white shadow-lg transition sm:px-8 sm:text-base",
                                                    slide.primaryCta.style,
                                                ]}>
                                                    {slide.primaryCta.label}
                                                </button>
                                            ) : (
                                                <a
                                                    href={slide.primaryCta.href}
                                                    class:list={[
                                                        "rounded-full px-6 py-3 text-sm font-bold text-white shadow-lg transition sm:px-8 sm:text-base",
                                                        slide.primaryCta.style,
                                                    ]}
                                                >
                                                    {slide.primaryCta.label}
                                                </a>
                                            )}
                                            <a
                                                href={slide.secondaryCta.href}
                                                class:list={[
                                                    "rounded-full px-6 py-3 text-sm font-semibold transition sm:px-8 sm:text-base",
                                                    slide.secondaryCta.style,
                                                ]}
                                            >
                                                {slide.secondaryCta.label}
                                            </a>
                                        </div>
                                        {!slide.countdown && (
                                            <div class="mt-8 grid grid-cols-3 gap-3 border-t border-white/20 pt-6 sm:mt-10 sm:gap-6 sm:pt-8">
                                                {slide.stats.map((stat) => (
                                                    <div>
                                                        <p class="text-2xl font-bold text-navy-100 sm:text-3xl">
                                                            {stat.value}
                                                        </p>
                                                        <p class="text-xs text-white/90 sm:text-sm">
                                                            {stat.label}
                                                        </p>
                                                    </div>
                                                ))}
                                            </div>
                                        )}
                                    </div>

                                    <div class="relative mx-auto w-full max-w-sm md:max-w-none">
                                        <div
                                            class:list={[
                                                "aspect-square overflow-hidden rounded-3xl bg-white/95 shadow-2xl backdrop-blur flex items-center justify-center",
                                                slide.imageFill
                                                    ? ""
                                                    : "p-6 sm:p-8",
                                            ]}
                                        >
                                            <img
                                                src={slide.image}
                                                alt={slide.eyebrow}
                                                class:list={[
                                                    "w-full h-auto",
                                                    slide.imageFill &&
                                                        "h-full w-full object-cover",
                                                ]}
                                            />
                                        </div>

                                        <div
                                            class:list={[
                                                "absolute rounded-2xl p-3 shadow-xl sm:p-4",
                                                slide.floating.style,
                                                slide.floating.side === "left"
                                                    ? "-bottom-4 -left-4 sm:-bottom-6 sm:-left-6"
                                                    : "-bottom-4 -right-4 sm:-bottom-6 sm:-right-6",
                                            ]}
                                        >
                                            <p class="text-xs font-semibold opacity-80 sm:text-sm">
                                                {slide.floating.label}
                                            </p>
                                            <p class="text-lg font-bold sm:text-2xl">
                                                {slide.floating.value}
                                            </p>
                                        </div>

                                        <a
                                            href={slide.card.href}
                                            class:list={[
                                                "absolute inline-flex items-center gap-2 rounded-2xl bg-white p-2.5 shadow-xl border-2 border-brand-500 transition hover:-translate-y-1 sm:gap-3 sm:p-4",
                                                slide.card.side === "right"
                                                    ? "-top-4 -right-4 sm:-top-6 sm:-right-6"
                                                    : "-top-4 -left-4 sm:-top-6 sm:-left-6",
                                            ]}
                                        >
                                            <span class="flex h-8 w-8 items-center justify-center rounded-full bg-brand-500 text-white sm:h-10 sm:w-10">
                                                {slide.card.icon ===
                                                    "trophy" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        class="h-4 w-4 sm:h-5 sm:w-5"
                                                        fill="currentColor"
                                                        viewBox="0 0 20 20"
                                                    >
                                                        <path d="M12 2l3 7h7l-5.5 4 2 7L12 16l-6.5 4 2-7L2 9h7z" />
                                                    </svg>
                                                )}
                                                {slide.card.icon ===
                                                    "soccer" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        class="h-4 w-4 sm:h-5 sm:w-5"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                    >
                                                        <circle
                                                            cx="12"
                                                            cy="12"
                                                            r="10"
                                                        />
                                                        <path d="M12 2l3 7h7 M12 22l-3-7h-7 M2 12l7-3 M22 12l-7 3" />
                                                    </svg>
                                                )}
                                                {slide.card.icon ===
                                                    "cake" && (
                                                    <svg
                                                        xmlns="http://www.w3.org/2000/svg"
                                                        class="h-4 w-4 sm:h-5 sm:w-5"
                                                        fill="none"
                                                        viewBox="0 0 24 24"
                                                        stroke="currentColor"
                                                        stroke-width="2"
                                                        stroke-linecap="round"
                                                        stroke-linejoin="round"
                                                    >
                                                        <path d="M20 12v10H4V12 M2 7h20v5H2z M12 22V7 M12 7H7.5a2.5 2.5 0 010-5C11 2 12 7 12 7z M12 7h4.5a2.5 2.5 0 000-5C13 2 12 7 12 7z" />
                                                    </svg>
                                                )}
                                            </span>
                                            <span>
                                                {slide.card.live && (
                                                    <span class="block text-[9px] font-bold uppercase tracking-wider text-emerald-600 sm:text-[10px]">
                                                        En vivo
                                                    </span>
                                                )}
                                                <span class="block text-xs font-extrabold text-navy-700 sm:text-sm">
                                                    {slide.card.title}
                                                </span>
                                            </span>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                ))
            }
        </div>

        <div
            class="relative mx-auto flex max-w-7xl items-center justify-between px-4 pb-8 pt-2 sm:px-6 sm:pb-10"
        >
            <button
                id="hero-prev"
                aria-label="Anterior"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    ><path d="M15 18l-6-6 6-6"></path></svg
                >
            </button>

            <div id="hero-dots" class="flex gap-2">
                {
                    slides.map((_, idx) => (
                        <button
                            class:list={[
                                "h-2.5 rounded-full transition-all",
                                idx === 0
                                    ? "w-10 bg-white"
                                    : "w-2.5 bg-white/40 hover:bg-white/70",
                            ]}
                            data-dot={idx}
                            aria-label={`Ir al slide ${idx + 1}`}
                        />
                    ))
                }
            </div>

            <button
                id="hero-next"
                aria-label="Siguiente"
                class="flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white backdrop-blur transition hover:bg-white/20"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    class="h-5 w-5"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"><path d="M9 18l6-6-6-6"></path></svg
                >
            </button>
        </div>
    </div>
</section>

<script>
    const slides = document.querySelectorAll("[data-slide]");
    const dots = document.querySelectorAll("[data-dot]");
    const prevBtn = document.getElementById("hero-prev");
    const nextBtn = document.getElementById("hero-next");
    let current = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const show = (idx: number) => {
        slides.forEach((s, i) => {
            s.setAttribute("aria-hidden", String(i !== idx));
            if (i === idx) {
                s.classList.remove("opacity-0", "z-0", "pointer-events-none");
                s.classList.add("opacity-100", "z-10");
            } else {
                s.classList.remove("opacity-100", "z-10");
                s.classList.add("opacity-0", "z-0", "pointer-events-none");
            }
        });
        dots.forEach((d, i) => {
            if (i === idx) {
                d.classList.remove("w-2.5", "bg-white/40");
                d.classList.add("w-10", "bg-white");
            } else {
                d.classList.remove("w-10", "bg-white");
                d.classList.add("w-2.5", "bg-white/40");
            }
        });
        current = idx;
    };

    const next = () => show((current + 1) % slides.length);
    const prev = () => show((current - 1 + slides.length) % slides.length);

    nextBtn?.addEventListener("click", () => {
        next();
        restart();
    });
    prevBtn?.addEventListener("click", () => {
        prev();
        restart();
    });
    dots.forEach((d, i) =>
        d.addEventListener("click", () => {
            show(i);
            restart();
        }),
    );

    const restart = () => {
        if (timer) clearInterval(timer);
        timer = setInterval(next, 6000);
    };
    restart();

    (() => {
        const countdown = document.querySelector("[data-hero-countdown]") as HTMLElement | null;
        const celebrate = document.querySelector("[data-count-celebrate]");
        const replayBtn = document.querySelector("[data-count-replay]");
        if (!countdown) return;

        const target = new Date(countdown.dataset.target || "2026-10-01T08:00:00");
        const daysEl = document.querySelector("[data-count-days]");
        const hoursEl = document.querySelector("[data-count-hours]");
        const minutesEl = document.querySelector("[data-count-minutes]");
        const secondsEl = document.querySelector("[data-count-seconds]");

        const pad = (n: number) => String(n).padStart(2, "0");

        const style = document.createElement("style");
        style.textContent =
            "@keyframes hero-confetti-fall{0%{transform:translateY(-4vh) rotate(0)}100%{transform:translateY(110vh) rotate(720deg)}}";
        document.head.appendChild(style);

        const COLORS = ["#ff6b1a", "#f04e00", "#ffa05c", "#ffc89b", "#ffffff", "#2d4173", "#1b2a4e", "#10b981", "#0ea5e9", "#f59e0b", "#ec4899"];

        const fireConfetti = (pieces: number) => {
            const layer = document.createElement("div");
            layer.className = "pointer-events-none fixed inset-0 z-[999] overflow-hidden";
            document.body.appendChild(layer);
            for (let i = 0; i < pieces; i++) {
                const p = document.createElement("span");
                const size = 6 + Math.random() * 8;
                p.style.cssText = [
                    "position:absolute",
                    "top:-24px",
                    `left:${Math.random() * 100}%`,
                    `width:${size}px`,
                    `height:${size * (0.5 + Math.random() * 0.4)}px`,
                    `background:${COLORS[Math.floor(Math.random() * COLORS.length)]}`,
                    "border-radius:2px",
                    `opacity:${0.6 + Math.random() * 0.4}`,
                    `animation:hero-confetti-fall ${2.4 + Math.random() * 2.2}s linear ${Math.random() * 0.8}s forwards`,
                ].join(";");
                layer.appendChild(p);
            }
            setTimeout(() => layer.remove(), 6000);
        };

        const celebrateToday = () => {
            const KEY = "galileo-aniversario-day";
            const today = new Date().toDateString();
            if (localStorage.getItem(KEY) === today) return;
            localStorage.setItem(KEY, today);
            fireConfetti(160);
        };

        const startCelebration = () => {
            if (countdown) countdown.classList.add("hidden");
            celebrate?.classList.remove("hidden");
            celebrateToday();
        };

        replayBtn?.addEventListener("click", () => fireConfetti(120));

        let iv: ReturnType<typeof setInterval> | null = null;
        const tick = () => {
            const diff = target.getTime() - Date.now();
            if (diff <= 0) {
                if (iv) clearInterval(iv);
                startCelebration();
                return;
            }
            const d = Math.floor(diff / 86400000);
            const h = Math.floor(diff / 3600000) % 24;
            const m = Math.floor(diff / 60000) % 60;
            const s = Math.floor(diff / 1000) % 60;
            if (daysEl) daysEl.textContent = pad(d);
            if (hoursEl) hoursEl.textContent = pad(h);
            if (minutesEl) minutesEl.textContent = pad(m);
            if (secondsEl) secondsEl.textContent = pad(s);
        };

        tick();
        iv = setInterval(tick, 1000);
    })();
</script>
