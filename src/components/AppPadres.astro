---
const features = [
  { title: 'Asistencia en tiempo real', desc: 'Recibe notificaciones cada vez que tu hijo ingresa o sale del colegio.', icon: 'M9 12l2 2 4-4 M12 22a10 10 0 100-20 10 10 0 000 20z' },
  { title: 'Calificaciones al instante', desc: 'Consulta notas, tareas y rendimiento académico desde cualquier lugar.', icon: 'M4 19.5A2.5 2.5 0 016.5 17H20 M6.5 2H20v20H6.5A2.5 2.5 0 014 19.5v-15A2.5 2.5 0 016.5 2z' },
  { title: 'Comunicación directa', desc: 'Chat con docentes y directivos sin intermediarios.', icon: 'M21 15a2 2 0 01-2 2H7l-4 4V5a2 2 0 012-2h14a2 2 0 012 2z' },
  { title: 'Calendario de actividades', desc: 'Eventos, evaluaciones y reuniones siempre a la mano.', icon: 'M19 4H5a2 2 0 00-2 2v14a2 2 0 002 2h14a2 2 0 002-2V6a2 2 0 00-2-2z M16 2v4 M8 2v4 M3 10h18' },
  { title: 'Pagos y trámites', desc: 'Realiza pagos de pensión y solicita documentos en línea.', icon: 'M3 10h18 M5 6h14a2 2 0 012 2v10a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z' },
  { title: 'Geolocalización segura', desc: 'Verifica la ruta y ubicación del transporte escolar.', icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z M12 13a3 3 0 100-6 3 3 0 000 6z' },
];
---
<section id="app-padres" class="bg-white py-16 sm:py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-12">
      <div class="order-2 lg:order-1">
        <span class="text-sm font-bold uppercase tracking-wider text-brand-500">App para padres</span>
        <h2 class="mt-3 text-2xl font-extrabold text-navy-700 sm:text-3xl md:text-4xl">Galileo Connect · Tu colegio en el bolsillo</h2>
        <p class="mt-4 text-base text-slate-600 sm:text-lg">
          Aplicación móvil desarrollada por el Colegio Galileo para que las familias estén conectadas con la educación y bienestar de sus hijos en todo momento.
        </p>

        <div class="mt-6 grid gap-4 sm:mt-8 sm:grid-cols-2">
          {features.map(f => (
            <div class="flex items-start gap-3 rounded-xl bg-slate-50 p-4 transition hover:bg-brand-50">
              <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-lg bg-brand-500 text-white sm:h-10 sm:w-10">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 sm:h-5 sm:w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d={f.icon} />
                </svg>
              </div>
              <div>
                <p class="text-sm font-bold text-navy-700 sm:text-base">{f.title}</p>
                <p class="text-xs text-slate-600 sm:text-sm">{f.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
          <a href="#" class="inline-flex items-center gap-3 rounded-xl bg-navy-700 px-4 py-2.5 text-white transition hover:bg-navy-800 sm:px-5 sm:py-3">
            <svg class="h-6 w-6 sm:h-7 sm:w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.53 4.09zM12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25z"/></svg>
            <div class="text-left">
              <p class="text-[9px] uppercase tracking-wider text-navy-200 sm:text-[10px]">Descargar en</p>
              <p class="text-sm font-bold sm:text-base">App Store</p>
            </div>
          </a>
          <a href="#" class="inline-flex items-center gap-3 rounded-xl bg-navy-700 px-4 py-2.5 text-white transition hover:bg-navy-800 sm:px-5 sm:py-3">
            <svg class="h-6 w-6 sm:h-7 sm:w-7" viewBox="0 0 24 24" fill="currentColor"><path d="M3.18 23.67c.4.22.85.33 1.32.33h14.99c.47 0 .93-.11 1.32-.33L12 14.04 3.18 23.67zm-2.49-1.85L11.93 13 2.91 3.99a1.99 1.99 0 00-.22.98v17.03c0 .32.07.63.18.91zm20.6 0c.11-.28.18-.59.18-.91V4.97c0-.34-.07-.67-.22-.98L13.07 13l8.22 8.82zM19.99 2.86c-.4-.22-.85-.34-1.32-.34H3.68c-.47 0-.93.12-1.32.34L12 11.04l7.99-8.18z"/></svg>
            <div class="text-left">
              <p class="text-[9px] uppercase tracking-wider text-navy-200 sm:text-[10px]">Descargar en</p>
              <p class="text-sm font-bold sm:text-base">Google Play</p>
            </div>
          </a>
        </div>
      </div>

      <div class="order-1 flex justify-center lg:order-2">
        <div class="relative">
          <div class="absolute -inset-8 rounded-full bg-brand-200 opacity-30 blur-3xl"></div>
          <div class="relative mx-auto h-[480px] w-[240px] rounded-[3rem] bg-navy-700 p-3 shadow-2xl sm:h-[560px] sm:w-[280px]">
            <div class="absolute left-1/2 top-3 z-10 h-6 w-32 -translate-x-1/2 rounded-full bg-navy-900"></div>
            <div class="h-full w-full overflow-hidden rounded-[2.5rem] bg-gradient-to-br from-brand-50 to-navy-50 p-4 pt-10 sm:p-5">
              <div class="flex items-center gap-2">
                <img src="/escudo.png" alt="Galileo" class="h-7 w-7 sm:h-8 sm:w-8" />
                <p class="text-sm font-extrabold text-navy-700">Galileo Connect</p>
              </div>

              <div class="mt-4 rounded-2xl bg-white p-3 shadow-sm sm:mt-5 sm:p-4">
                <p class="text-[10px] font-bold uppercase text-brand-500 sm:text-xs">Buenos días</p>
                <p class="mt-1 text-base font-extrabold text-navy-700 sm:text-lg">Hola, María</p>
                <p class="text-[10px] text-slate-500 sm:text-xs">Tus hijos · 2</p>
              </div>

              <div class="mt-3 rounded-2xl bg-white p-3 shadow-sm sm:mt-4 sm:p-4">
                <div class="flex items-center justify-between">
                  <p class="text-[10px] font-bold text-slate-500 sm:text-xs">ASISTENCIA · HOY</p>
                  <span class="rounded-full bg-emerald-100 px-2 py-0.5 text-[9px] font-bold text-emerald-700 sm:text-[10px]">A tiempo</span>
                </div>
                <div class="mt-3 flex items-center gap-3">
                  <div class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-100 text-sm font-bold text-brand-600 sm:h-10 sm:w-10">JM</div>
                  <div class="flex-1 min-w-0">
                    <p class="text-sm font-bold text-navy-700">Juan Méndez</p>
                    <p class="text-[10px] text-slate-500 sm:text-xs">Ingresó 7:42 AM · 5° Primaria</p>
                  </div>
                </div>
              </div>

              <div class="mt-3 rounded-2xl bg-white p-3 shadow-sm sm:p-4">
                <p class="text-[10px] font-bold text-slate-500 sm:text-xs">ÚLTIMAS CALIFICACIONES</p>
                <div class="mt-2 flex items-center justify-between text-sm">
                  <span class="text-slate-700">Matemática</span>
                  <span class="font-extrabold text-brand-600">18</span>
                </div>
                <div class="mt-1 flex items-center justify-between text-sm">
                  <span class="text-slate-700">Comunicación</span>
                  <span class="font-extrabold text-emerald-600">19</span>
                </div>
                <div class="mt-1 flex items-center justify-between text-sm">
                  <span class="text-slate-700">Ciencia y Ambiente</span>
                  <span class="font-extrabold text-navy-700">17</span>
                </div>
              </div>

              <div class="mt-3 rounded-2xl bg-navy-700 p-3 text-white shadow-sm sm:p-4">
                <p class="text-[10px] font-bold uppercase text-brand-300 sm:text-xs">Próximo evento</p>
                <p class="mt-1 text-sm font-bold">Reunión de padres</p>
                <p class="text-[10px] text-navy-100 sm:text-xs">Viernes 21 · 7:00 PM</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>