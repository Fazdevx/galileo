---
/**
 * Editor de noticias para el panel /admin.
 *
 * Alta, edición y borrado contra la colección "noticias" de Firestore.
 * No sube imágenes: se pega el enlace de una imagen ya alojada.
 */
---

<section class="space-y-6">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div>
      <h2 class="text-lg font-extrabold text-navy-700 sm:text-xl">Noticias</h2>
      <p class="mt-1 text-sm text-slate-500">
        Lo que publiques aquí aparece en{' '}
        <a href="/noticias" class="font-semibold text-brand-600 hover:underline">
          /noticias
        </a>
        y las que marques como destacadas se ven también en la página principal.
      </p>
    </div>
    <button
      type="button"
      id="noticia-nueva"
      class="rounded-full bg-brand-500 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-600"
    >
      + Nueva noticia
    </button>
  </div>

  <p id="noticia-aviso" class="hidden rounded-xl px-4 py-3 text-sm font-semibold" role="status" aria-live="polite"></p>

  <!-- Formulario -->
  <form id="noticia-form" class="hidden rounded-2xl bg-slate-50 p-5 ring-1 ring-slate-200 sm:p-6">
    <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
      <span id="noticia-modo">Nueva noticia</span>
    </p>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <label class="block sm:col-span-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Titulo *</span>
        <input
          id="n-titulo"
          type="text"
          required
          placeholder="Aniversario institucional del Colegio Galileo"
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        />
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Fecha *</span>
        <input
          id="n-fecha"
          type="date"
          required
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        />
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Categoria</span>
        <select
          id="n-categoria"
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        >
          {['Aniversario', 'Olimpiadas', 'Desfile', 'Admisión', 'Académico', 'Deportes', 'Comunicados'].map((c) => (
            <option value={c}>{c}</option>
          ))}
        </select>
      </label>

      <label class="block sm:col-span-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Resumen (se ve en el home)</span>
        <textarea
          id="n-resumen"
          rows="2"
          placeholder="Una o dos lineas: es el texto que aparece en las tarjetas."
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        ></textarea>
      </label>

      <label class="block sm:col-span-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Cuerpo</span>
        <textarea
          id="n-cuerpo"
          rows="8"
          placeholder="Escribe los parrafos. Deja una linea en blanco entre cada parrafo."
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm leading-relaxed focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        ></textarea>
        <span class="mt-1 block text-xs text-slate-400">
          Cada bloque separado por una linea en blanco se convierte en un parrafo.
        </span>
      </label>

      <label class="block sm:col-span-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">URL de la imagen</span>
        <input
          id="n-imagen"
          type="url"
          placeholder="https://... (dejalo vacio si no hay imagen)"
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        />
      </label>

      <label class="block sm:col-span-2">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Texto alternativo de la imagen</span>
        <input
          id="n-imagen-alt"
          type="text"
          placeholder="Describe la imagen para quien no ve"
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        />
      </label>

      <label class="block">
        <span class="text-xs font-bold uppercase tracking-wider text-slate-600">Slug (URL)</span>
        <input
          id="n-slug"
          type="text"
          placeholder="se genera solo del titulo"
          class="mt-1.5 w-full rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200 focus:outline-none"
        />
        <span class="mt-1 block text-xs text-slate-400">Se completa solo. Cambialo solo si sabes lo que haces.</span>
      </label>

      <div class="flex items-end gap-5">
        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
          <input id="n-destacado" type="checkbox" class="h-4 w-4 rounded border-slate-300 text-brand-500" />
          Destacada
        </label>
        <label class="flex items-center gap-2 text-sm font-semibold text-slate-700">
          <input id="n-publicado" type="checkbox" checked class="h-4 w-4 rounded border-slate-300 text-brand-500" />
          Publicada
        </label>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center gap-3">
      <button
        type="submit"
        class="rounded-full bg-brand-500 px-6 py-2.5 text-sm font-bold text-white transition hover:bg-brand-600"
      >
        Guardar noticia
      </button>
      <button
        type="button"
        id="n-cancelar"
        class="rounded-full border border-slate-300 px-5 py-2.5 text-sm font-bold text-slate-600 transition hover:bg-slate-50"
      >
        Cancelar
      </button>
      <p class="text-xs text-slate-400">
        URL final:{' '}
        <span id="n-preview" class="font-mono">
          /noticias/
        </span>
      </p>
    </div>
  </form>

  <!-- Listado -->
  <div id="noticia-lista" class="grid gap-3"></div>
</section>

<script>
  import { esc } from '../../lib/text';
  import {
    fetchNoticiasAdmin,
    guardarNoticia,
    borrarNoticia,
    slugify,
    uniqueSlug,
    formatearFecha,
    type Noticia,
  } from '../../data/noticias';

  const $ = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;

  const form = $<HTMLFormElement>('noticia-form');
  const lista = $<HTMLDivElement>('noticia-lista');
  const aviso = $<HTMLParagraphElement>('noticia-aviso');
  const modo = $<HTMLParagraphElement>('noticia-modo');
  const preview = $<HTMLSpanElement>('n-preview');

  const f = {
    titulo: $<HTMLInputElement>('n-titulo'),
    fecha: $<HTMLInputElement>('n-fecha'),
    categoria: $<HTMLSelectElement>('n-categoria'),
    resumen: $<HTMLTextAreaElement>('n-resumen'),
    cuerpo: $<HTMLTextAreaElement>('n-cuerpo'),
    imagen: $<HTMLInputElement>('n-imagen'),
    imagenAlt: $<HTMLInputElement>('n-imagen-alt'),
    slug: $<HTMLInputElement>('n-slug'),
    destacado: $<HTMLInputElement>('n-destacado'),
    publicado: $<HTMLInputElement>('n-publicado'),
  };

  let editando: string | null = null;
  let listaActual: Noticia[] = [];

  function decir(mensaje: string, ok = true) {
    aviso.textContent = mensaje;
    aviso.className = `rounded-xl px-4 py-3 text-sm font-semibold ${
      ok ? 'bg-emerald-50 text-emerald-800 ring-1 ring-emerald-200' : 'bg-red-50 text-red-700 ring-1 ring-red-200'
    }`;
    aviso.classList.remove('hidden');
    window.setTimeout(() => aviso.classList.add('hidden'), 6000);
  }

  function slugPropuesto(): string {
    const manual = f.slug.value.trim();
    const base = manual || slugify(f.titulo.value) || 'noticia';
    const otros = listaActual.map((n) => n.slug).filter((s) => s !== editando);
    return otros.includes(base) ? uniqueSlug(base, otros) : base;
  }

  function refrescarPreview() {
    preview.textContent = `/noticias/${slugPropuesto() || ''}`;
  }

  function abrirFormulario(n: Noticia | null) {
    editando = n?.slug ?? null;
    modo.textContent = n ? `Editando: ${n.titulo}` : 'Nueva noticia';

    f.titulo.value = n?.titulo ?? '';
    f.fecha.value = n?.fecha ?? new Date().toISOString().slice(0, 10);
    f.categoria.value = n?.categoria ?? 'Comunicados';
    f.resumen.value = n?.resumen ?? '';
    f.cuerpo.value = (n?.cuerpo ?? []).join('\n\n');
    f.imagen.value = n?.imagen ?? '';
    f.imagenAlt.value = n?.imagenAlt ?? '';
    f.slug.value = n?.slug ?? '';
    f.destacado.checked = n?.destacado ?? false;
    f.publicado.checked = n?.publicado ?? true;

    form.classList.remove('hidden');
    refrescarPreview();
    f.titulo.focus();
    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
  }

  function cerrarFormulario() {
    editando = null;
    form.reset();
    f.publicado.checked = true;
    form.classList.add('hidden');
    modo.textContent = 'Nueva noticia';
  }

  function pintar() {
    if (!listaActual.length) {
      lista.innerHTML = `<p class="rounded-2xl bg-white p-8 text-center text-sm text-slate-500 ring-1 ring-slate-200">Todavia no hay noticias guardadas. Mientras tanto el sitio muestra el contenido de respaldo. Crea la primera.</p>`;
      return;
    }

    lista.innerHTML = listaActual
      .map((n) => {
        const fecha = formatearFecha(n.fecha) || 'sin fecha';
        return `<div class="flex flex-wrap items-center gap-4 rounded-2xl bg-white p-4 shadow-sm ring-1 ring-slate-200">
          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-slate-700">${esc(n.categoria)}</span>
              <span class="text-xs font-medium text-slate-500">${esc(fecha)}</span>
              ${n.destacado ? '<span class="rounded-full bg-brand-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-brand-700">Destacada</span>' : ''}
              ${n.publicado ? '' : '<span class="rounded-full bg-amber-100 px-2.5 py-1 text-[10px] font-bold uppercase tracking-wide text-amber-800">Oculta</span>'}
            </div>
            <p class="mt-1.5 font-extrabold text-navy-800">${esc(n.titulo)}</p>
            <p class="truncate font-mono text-xs text-slate-400">/noticias/${esc(n.slug)}</p>
          </div>
          <div class="flex shrink-0 gap-2">
            <a href="/noticias/${esc(n.slug)}" target="_blank" rel="noopener" class="rounded-full border border-slate-300 px-3 py-1.5 text-xs font-bold text-slate-600 hover:bg-slate-50">Ver</a>
            <button type="button" data-editar="${esc(n.slug)}" class="rounded-full bg-navy-700 px-3 py-1.5 text-xs font-bold text-white hover:bg-navy-800">Editar</button>
            <button type="button" data-borrar="${esc(n.slug)}" class="rounded-full bg-red-50 px-3 py-1.5 text-xs font-bold text-red-700 ring-1 ring-red-200 hover:bg-red-100">Borrar</button>
          </div>
        </div>`;
      })
      .join('');
  }

  async function cargar() {
    try {
      listaActual = await fetchNoticiasAdmin();
      pintar();
    } catch (error) {
      console.error(error);
      decir('No se pudieron cargar las noticias. Revisa la conexion.', false);
    }
  }

  $('noticia-nueva').addEventListener('click', () => abrirFormulario(null));
  $('n-cancelar').addEventListener('click', cerrarFormulario);

  f.titulo.addEventListener('input', refrescarPreview);
  f.slug.addEventListener('input', refrescarPreview);

  form.addEventListener('submit', async (e) => {
    e.preventDefault();

    const titulo = f.titulo.value.trim();
    if (!titulo) {
      decir('El titulo es obligatorio.', false);
      return;
    }

    const slug = slugPropuesto();
    const noticia: Noticia = {
      slug,
      titulo,
      fecha: f.fecha.value,
      resumen: f.resumen.value.trim(),
      destacado: f.destacado.checked,
      publicado: f.publicado.checked,
      imagen: f.imagen.value.trim(),
      imagenAlt: f.imagenAlt.value.trim(),
      categoria: f.categoria.value,
      cuerpo: f.cuerpo.value
        .split(/\n\s*\n/)
        .map((p) => p.trim())
        .filter(Boolean),
      actualizado: new Date().toISOString(),
    };

    const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    boton.disabled = true;
    boton.textContent = 'Guardando...';

    const ok = await guardarNoticia(noticia);
    boton.disabled = false;
    boton.textContent = 'Guardar noticia';

    if (!ok) {
      decir('No se pudo guardar. Revisa la conexion a Firebase.', false);
      return;
    }

    decir(editando ? 'Noticia actualizada.' : 'Noticia creada.');
    cerrarFormulario();
    await cargar();
  });

  lista.addEventListener('click', async (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;

    const slugEditar = btn.getAttribute('data-editar');
    if (slugEditar) {
      abrirFormulario(listaActual.find((n) => n.slug === slugEditar) ?? null);
      return;
    }

    const slugBorrar = btn.getAttribute('data-borrar');
    if (slugBorrar) {
      const n = listaActual.find((x) => x.slug === slugBorrar);
      if (!confirm(`¿Borrar "${n?.titulo ?? slugBorrar}"? Esta accion no se puede deshacer.`)) return;
      const ok = await borrarNoticia(slugBorrar);
      decir(ok ? 'Noticia borrada.' : 'No se pudo borrar.', ok);
      if (ok) await cargar();
    }
  });

  cargar();
</script>
