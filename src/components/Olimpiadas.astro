    ---
import { DEFAULT_DATA } from "../data/olimpiadasStore";
import { fetchData } from "../data/api";

let data = DEFAULT_DATA;
const sections = DEFAULT_DATA.sections;
const sports = DEFAULT_DATA.sports;
const games = DEFAULT_DATA.games;
const heroStats = DEFAULT_DATA.heroStats;

// Try to fetch from Firebase on server side
try {
  const firebaseData = await fetchData();
  if (firebaseData && (firebaseData.sections.length > 0 || firebaseData.sports.length > 0 || firebaseData.games.length > 0)) {
    data = firebaseData;
  }
} catch (e) {
  console.log('[Olimpiadas] Using default data, Firebase fetch failed:', e);
}
---

<section id="olimpiadas" class="bg-navy-700 py-16 text-white sm:py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div class="grid items-center gap-10 md:grid-cols-2 md:gap-12">
            <div>
                <span
                    class="inline-flex items-center gap-2 rounded-full bg-brand-500/20 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-brand-300 sm:px-4 sm:text-xs"
                >
                    <span
                        class="h-2 w-2 rounded-full bg-brand-400 animate-pulse"
                    ></span>
                    Olimpiadas Internas · 2026
                </span>
                <h2
                    class="mt-4 text-2xl font-extrabold leading-tight sm:text-3xl md:text-5xl"
                >
                    La competencia entre <span class="text-brand-400"
                        >secciones</span
                    >
                </h2>
                <p class="mt-4 text-base text-navy-100 sm:text-lg">
                    La gran jornada deportiva interna donde las cuatro secciones
                    del colegio compiten por la gloria. Fútbol y vóley,
                    integración y espíritu galileano.
                </p>
                <div
                    class="mt-6 grid grid-cols-3 gap-3 sm:mt-8 sm:gap-4"
                    data-hero-stats
                >
                    <div class="rounded-2xl bg-navy-800 p-3 text-center sm:p-5">
                        <p
                            class="text-2xl font-extrabold text-brand-400 sm:text-3xl"
                            data-stat="secciones"
                        >
                            {heroStats.secciones}
                        </p>
                        <p
                            class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-white sm:text-xs"
                        >
                            Secciones
                        </p>
                    </div>
                    <div class="rounded-2xl bg-navy-800 p-3 text-center sm:p-5">
                        <p
                            class="text-2xl font-extrabold text-brand-400 sm:text-3xl"
                            data-stat="disciplinas"
                        >
                            {heroStats.disciplinas}
                        </p>
                        <p
                            class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-white sm:text-xs"
                        >
                            Disciplinas
                        </p>
                    </div>
                    <div class="rounded-2xl bg-navy-800 p-3 text-center sm:p-5">
                        <p
                            class="text-2xl font-extrabold text-brand-400 sm:text-3xl"
                            data-stat="dias"
                        >
                            {heroStats.dias}
                        </p>
                        <p
                            class="mt-1 text-[10px] font-semibold uppercase tracking-wider text-white sm:text-xs"
                        >
                            Días
                        </p>
                    </div>
                </div>

                <div class="mt-6 sm:mt-8">
                    <p
                        class="text-xs font-bold uppercase tracking-widest text-brand-300"
                    >
                        Secciones en competencia
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2" data-sections-list>
                        {
                            sections.map((s) => (
                                <span
                                    class={`inline-flex items-center gap-2 rounded-full ${s.color} px-3 py-1.5 text-xs font-bold text-white`}
                                >
                                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-white/20 text-[10px]">
                                        {s.initial}
                                    </span>
                                    {s.name}
                                </span>
                            ))
                        }
                    </div>
                </div>

                <div class="mt-6 flex flex-wrap gap-3 sm:mt-8">
                    <a
                        href="#contacto"
                        class="rounded-full bg-brand-500 px-5 py-2.5 text-sm font-bold transition hover:bg-brand-600 sm:px-7 sm:py-3"
                        >Inscribe a tu sección</a
                    >
                    <a
                        href="#scorer"
                        class="rounded-full border-2 border-white/30 px-5 py-2.5 text-sm font-bold transition hover:bg-white/10 sm:px-7 sm:py-3"
                        >Ver resultados</a
                    >
                </div>
            </div>
            <div><div
                    class="flex items-center justify-between border-b border-slate-100 pb-4"
                >
                    <div>
                        <p
                            class="text-xs font-bold uppercase tracking-widest text-white"
                        >
                            Disciplinas
                        </p>
                        <p
                            class="text-base font-extrabold text-white sm:text-lg"
                        >
                            Catálogo deportivo
                        </p>
                    </div>
                    <div
                        class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-500 text-white sm:h-10 sm:w-10"
                    >
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-4 w-4 sm:h-5 sm:w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            ><path d="M12 5v14 M5 12l7 7 7-7"></path></svg
                        >
                    </div>
                </div>
                <div
                    class="mt-4 grid grid-cols-2 gap-2 pb-4 sm:mt-5 sm:gap-3"
                    data-sports-list
                >
                    {
                        sports.map((s) => (
                            <div class="flex items-center gap-2 rounded-xl bg-slate-50 p-2.5 transition  hover:bg-brand-50 sm:gap-3 sm:p-3">
                                <div class="flex h-8 w-8 flex-shrink-0 items-center justify-center rounded-lg bg-brand-100 text-brand-600 sm:h-9 sm:w-9">
                                    <svg
                                        xmlns="http://www.w3.org/2000/svg"
                                        class="h-4 w-4"
                                        fill="none"
                                        viewBox="0 0 24 24"
                                        stroke="currentColor"
                                        stroke-width="2.5"
                                    >
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                </div>
                                <span class="text-xs font-semibold text-navy-700 sm:text-sm">
                                    {s}
                                </span>
                            </div>
                        ))
                    }
                </div>
            <div
                class="rounded-3xl bg-white p-5 text-slate-800 shadow-2xl sm:p-6"
            >
                

                <div class="mt-4 grid grid-cols-2 gap-3">
                    <div class="overflow-hidden rounded-2xl">
                        <img src="/CAMPO DE GRASS.png" alt="Campo de deportes" class="h-full w-full object-cover" />
                    </div>
                    <div class="overflow-hidden rounded-2xl">
                        <img src="/copas olimpiadas.png" alt="Copas olimpiadas" class="h-full w-full object-cover" />
                    </div>
                    <div class="overflow-hidden rounded-2xl">
                        <img src="/deporte (1).png" alt="Deporte Galileo" class="h-full w-full object-cover" />
                    </div>
                    <div class="overflow-hidden rounded-2xl">
                        <img src="/deporte (2).png" alt="Deporte Galileo" class="h-full w-full object-cover" />
                    </div>
                </div>
            </div>
            </div>
        </div>
    </div>
</section>

<section id="scorer" class="bg-slate-50 py-16 sm:py-20 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <div
            class="flex flex-col items-start justify-between gap-4 md:flex-row md:items-end"
        >
            <div>
                <span
                    class="text-sm font-bold uppercase tracking-wider text-brand-500"
                    >Scorer en vivo</span
                >
                <h2
                    class="mt-2 text-2xl font-extrabold text-navy-700 sm:text-3xl md:text-4xl"
                >
                    Resultados entre secciones
                </h2>
                <p class="mt-2 text-sm text-slate-600 sm:text-base">
                    Sigue el marcador en tiempo real de las olimpiadas internas.
                </p>
            </div>
            <div
                class="flex items-center gap-2 rounded-full bg-emerald-100 px-3 py-1.5 text-xs font-semibold text-emerald-700 sm:px-4 sm:py-2 sm:text-sm"
                data-live-indicator
            >
                <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"
                ></span>
                <span data-live-count>0 partidos en vivo</span>
            </div>
        </div>

        <div
            class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-4"
            data-games-list
        >
            {
                games.map((g) => {
                    const localSec = sections.find((s) => s.name === g.local);
                    const visitSec = sections.find((s) => s.name === g.visit);
                    return (
                        <article
                            data-game-id={g.id}
                            class={`overflow-hidden rounded-2xl bg-white p-5 shadow-sm ring-1 ring-slate-200 transition hover:shadow-lg sm:p-6 ${g.status.includes("En vivo") ? "ring-2 ring-brand-400" : ""}`}
                        >
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-3">
                                <span class="rounded-full bg-slate-100 px-3 py-1 text-xs font-bold uppercase text-slate-600">
                                    {g.sport}
                                </span>
                                <span
                                    class={`rounded-full px-3 py-1 text-xs font-bold ${g.status.includes("En vivo") ? "bg-brand-500 text-white" : "bg-slate-100 text-slate-600"}`}
                                >
                                    {g.status}
                                </span>
                            </div>
                            <div class="mt-4 grid grid-cols-3 items-center gap-2 sm:gap-3">
                                <div class="text-center">
                                    <div
                                        class={`mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full ${localSec?.color} text-lg font-extrabold text-white sm:h-14 sm:w-14 sm:text-xl`}
                                    >
                                        {localSec?.initial ?? g.local[8]}
                                    </div>
                                    <p class="text-xs font-bold text-navy-700 sm:text-sm">
                                        {g.local}
                                    </p>
                                </div>
                                <div class="text-center">
                                    <p class="text-3xl font-black text-navy-700 tabular-nums sm:text-5xl">
                                        {g.localScore}{" "}
                                        <span class="text-xl text-slate-400 sm:text-2xl">
                                            -
                                        </span>{" "}
                                        {g.visitScore}
                                    </p>
                                    <p class="mt-1 text-[10px] text-slate-500 sm:text-xs">
                                        {g.date}
                                    </p>
                                </div>
                                <div class="text-center">
                                    <div
                                        class={`mx-auto mb-2 flex h-12 w-12 items-center justify-center rounded-full ${visitSec?.color} text-lg font-extrabold text-white sm:h-14 sm:w-14 sm:text-xl`}
                                    >
                                        {visitSec?.initial ?? g.visit[8]}
                                    </div>
                                    <p class="text-xs font-bold text-navy-700 sm:text-sm">
                                        {g.visit}
                                    </p>
                                </div>
                            </div>
                        </article>
                    );
                })
            }
        </div>

        <div
            class="mt-8 overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 sm:mt-10"
        >
            <div
                class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 px-5 py-4 sm:px-6"
            >
                <h3 class="text-base font-extrabold text-navy-700 sm:text-lg">
                    Tabla general por sección
                </h3>
                <span class="text-xs text-slate-500"
                    >Actualizado hace 5 min</span
                >
            </div>
            <div class="overflow-x-auto" data-standings>
                <table class="w-full min-w-[480px] text-sm">
                    <thead
                        class="bg-slate-50 text-xs uppercase tracking-wider text-slate-500"
                    >
                        <tr>
                            <th class="px-4 py-3 text-left sm:px-6">#</th>
                            <th class="px-4 py-3 text-left sm:px-6">Sección</th>
                            <th class="px-4 py-3 text-center sm:px-6">PJ</th>
                            <th class="px-4 py-3 text-center sm:px-6">G</th>
                            <th class="px-4 py-3 text-center sm:px-6">E</th>
                            <th class="px-4 py-3 text-center sm:px-6">P</th>
                            <th class="px-4 py-3 text-center sm:px-6">Pts</th>
                        </tr>
                    </thead>
                    <tbody
                        class="divide-y divide-slate-100"
                        data-standings-body
                    >
                        {
                            sections.map((s, idx) => {
                                const stats = [
                                    { pj: 6, g: 5, e: 1, p: 0, pts: 16 },
                                    { pj: 6, g: 3, e: 2, p: 1, pts: 11 },
                                    { pj: 6, g: 2, e: 2, p: 2, pts: 8 },
                                    { pj: 6, g: 1, e: 1, p: 4, pts: 4 },
                                ][idx] ?? { pj: 0, g: 0, e: 0, p: 0, pts: 0 };
                                return (
                                    <tr
                                        data-standings-row={s.id}
                                        class={idx === 0 ? "bg-brand-50" : ""}
                                    >
                                        <td class="px-4 py-3 font-bold text-navy-700 sm:px-6">
                                            {idx + 1}
                                        </td>
                                        <td class="px-4 py-3 sm:px-6">
                                            <div class="flex items-center gap-2 sm:gap-3">
                                                <span
                                                    class={`flex h-7 w-7 flex-shrink-0 items-center justify-center rounded-full ${s.color} text-xs font-extrabold text-white sm:h-8 sm:w-8`}
                                                >
                                                    {s.initial}
                                                </span>
                                                <span class="font-semibold text-slate-700">
                                                    {s.name}
                                                </span>
                                            </div>
                                        </td>
                                        <td class="px-4 py-3 text-center tabular-nums sm:px-6">
                                            {stats.pj}
                                        </td>
                                        <td class="px-4 py-3 text-center tabular-nums sm:px-6">
                                            {stats.g}
                                        </td>
                                        <td class="px-4 py-3 text-center tabular-nums sm:px-6">
                                            {stats.e}
                                        </td>
                                        <td class="px-4 py-3 text-center tabular-nums sm:px-6">
                                            {stats.p}
                                        </td>
                                        <td class="px-4 py-3 text-center font-bold tabular-nums text-navy-700 sm:px-6">
                                            {stats.pts}
                                        </td>
                                    </tr>
                                );
                            })
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>


<script></script>

