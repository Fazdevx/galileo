---
import { waLink, SITE, TRAYECTORIA, mapsLinkUrl } from '../data/site';

/**
 * Asistente de WhatsApp.
 *
 * Este panel no finge ser un chatbot que responde cualquier cosa. Los temas y
 * sus respuestas salen de aquí, se entregan al script como JSON (#wa-datos) y
 * se arman con los mismos datos que el resto del sitio (SITE, TRAYECTORIA),
 * así que no pueden contradecerse: si cambia el teléfono, el horario o la
 * antigüedad, cambian los dos a la vez.
 *
 * Cada tema trae `keywords`: la lista de palabras con las que se reconoce la
 * pregunta si la persona escribe en vez de tocar un chip. Se comparan sin
 * tildes ni mayúsculas.
 *
 * El bot NO intenta resolver nada que no esté en esta lista. Cuando la
 * pregunta se le escapa, pasa el turno al equipo por WhatsApp, que es lo
 * único honesto que puede hacer: detrás no hay nadie leyendo.
 */

const academiaWa = waLink(
  'Hola, quisiera información sobre la Academia Preuniversitaria del Colegio Galileo.',
  SITE.phoneAcademia.digits,
);
const admisionWa = waLink('Hola, quisiera información sobre el proceso de admisión.');
const contactoWa = waLink('Hola, quisiera hacer una consulta sobre el Colegio Galileo.');

const horariosTexto = SITE.hours
  .map((h) => `${h.days} de ${h.opens} a ${h.closes}`)
  .join('<br>');

const temas = [
  {
    clave: 'admision',
    chip: 'Admisión',
    pregunta: 'Quiero información sobre la admisión',
    keywords: ['admision', 'inscri', 'matricul', 'postul', 'nuevo ingreso', 'ingreso', 'vacante'],
    respuesta: `<strong>La admisión está abierta.</strong> El proceso son cuatro pasos: agendar una visita al colegio, presentar los documentos, la evaluación diagnóstica y la confirmación de la matrícula.<br><br>Si prefieres que te llamemos, cuéntanos por WhatsApp al <a href="${admisionWa}" target="_blank" rel="noopener noreferrer">${SITE.phone.display}</a>.`,
    accion: { texto: 'Ver el proceso de admisión', href: '/admision' },
  },
  {
    clave: 'niveles',
    chip: 'Niveles',
    pregunta: 'Qué niveles ofrecen',
    keywords: ['nivel', 'programa', 'inicial', 'primaria', 'secundaria', 'que estudian', 'materia', 'curso'],
    respuesta: `<strong>Tenemos Inicial, Primaria y Secundaria</strong> en el colegio, más la Academia Preuniversitaria.<br><br><strong>Inicial</strong> (3 a 5 años), <strong>Primaria</strong> (6 a 11) y <strong>Secundaria</strong> (12 a 16), con programa bilingüe, talleres de ciencia, robótica, arte y deportes. La Academia prepara para el ingreso a la universidad.`,
    accion: { texto: 'Ver los programas', href: '/#programas' },
  },
  {
    clave: 'academia',
    chip: 'Academia',
    pregunta: 'Información sobre la Academia',
    keywords: ['academia', 'preunivers', 'universidad', 'ingenier', 'medicina', 'cachimbo', 'postgrado'],
    respuesta: `<strong>La Academia Preuniversitaria</strong> prepara para el ingreso a la universidad: ciclos regulares e intensivos, simulacros tipo examen y docentes especialistas por materia. Hoy suma ${TRAYECTORIA}.<br><br>Tiene su propio número para consultas de matrícula y horarios: <a href="${academiaWa}" target="_blank" rel="noopener noreferrer">${SITE.phoneAcademia.display}</a>.`,
    accion: { texto: 'Ir a la página de la Academia', href: '/academia' },
  },
  {
    clave: 'mensualidad',
    chip: 'Mensualidades',
    pregunta: 'Cuánto cuesta la matrícula y las mensualidades',
    keywords: ['mensualidad', 'precio', 'pension', 'cuanto cuesta', 'costo', 'tarifa', 'matricula', 'beca', 'becas'],
    respuesta:
      'No publicamos los importes en la web porque cambian según el nivel. Un asesor del colegio te confirma el importe de cada concepto y si hay becas disponibles.',
    accion: { texto: 'Consultar por WhatsApp', href: admisionWa },
  },
  {
    clave: 'horarios',
    chip: 'Horarios',
    pregunta: 'A qué hora dan clases',
    keywords: ['horario', 'hora', 'entrada', 'salida', 'clase', 'tarde'],
    respuesta: `<strong>Nuestro horario de atención es:</strong><br><br>${horariosTexto}<br><br>La entrada y la salida de los estudiantes se organizan según el nivel y el turno de cada sección.`,
    accion: { texto: 'Ver el contacto completo', href: '/#contacto' },
  },
  {
    clave: 'ubicacion',
    chip: 'Ubicación',
    pregunta: 'Dónde están ubicados',
    keywords: ['ubicacion', 'direccion', 'donde estan', 'donde queda', 'mapa', 'como llego', 'direcc', 'transporte'],
    respuesta: `<strong>Estamos en ${SITE.address.street}, ${SITE.address.city}</strong>.<br><br>Si vienes de Lima o de otra ciudad, confírmanos tu llegada por WhatsApp y coordinamos el acceso a la puerta.`,
    accion: { texto: 'Ver el mapa', href: mapsLinkUrl },
  },
  {
    clave: 'noticias',
    chip: 'Noticias',
    pregunta: 'Qué noticias hay',
    keywords: ['noticia', 'aniversario', 'olimpiad', 'desfile', 'evento', 'comunicado', 'galeria', 'foto'],
    respuesta:
      'Publicamos las noticias de la comunidad: el aniversario con sus actividades, los desfiles, las olimpiadas y los comunicados. También hay una galería con fotos de la vida escolar.',
    accion: { texto: 'Ver las noticias', href: '/noticias' },
  },
  {
    clave: 'contacto',
    chip: 'Contacto',
    pregunta: 'Datos de contacto',
    keywords: ['contacto', 'telefono', 'whatsapp', 'numero', 'correo', 'email', 'escribir', 'llamar', 'direccion del colegio'],
    respuesta: `<strong>Estos son nuestros datos:</strong><br><br><strong>Colegio</strong><br>${SITE.phone.display}<br><br><strong>Academia</strong><br>${SITE.phoneAcademia.display}<br><br><strong>Correo</strong><br>${SITE.email}<br><br><strong>Dirección</strong><br>${SITE.address.street}, ${SITE.address.city}<br><br><strong>Horario</strong><br>${SITE.hoursDisplay}`,
    accion: { texto: 'Ver el contacto completo', href: '/#contacto' },
  },
  {
    clave: 'otra',
    chip: 'Otra consulta',
    pregunta: 'Tengo otra consulta',
    keywords: [],
    respuesta: `Claro. Para eso está el equipo del colegio, que sí te va a poder responder.<br><br>Escríbenos por WhatsApp al <a href="${contactoWa}" target="_blank" rel="noopener noreferrer">${SITE.phone.display}</a> y te contestamos en horario de atención.`,
  },
];

const config = {
  nombre: 'Galileo Info',
  subtitulo: 'Asistente del colegio',
  aviso: `Esta conversación es un asistente automático con la información del colegio. Para una atención personalizada, escríbenos al ${SITE.phone.display}.`,
  saludo: `Hola 👋 Soy el asistente del <strong>Colegio y Academia Galileo</strong>, en Huacho. Te puedo informar sobre:`,
  temas,
  /** Si la pregunta no cae en ningún tema, se pasa el turno al equipo. */
  fueraDeLista: `Esa consulta no la tengo aquí, pero el equipo del colegio sí te la puede responder. Escríbenos por WhatsApp al <a href="${contactoWa}" target="_blank" rel="noopener noreferrer">${SITE.phone.display}</a> y te contestamos en horario de atención.`,
  /** Destino del botón de enviar: el WhatsApp real. */
  envio: `Hola, escribo desde la web del Colegio y Academia Galileo. Mi consulta es: `,
};
---

<!-- Botón flotante -->
<button
  id="wa-toggle-btn"
  aria-label="Abrir asistente de información del colegio"
  aria-expanded="false"
  aria-controls="wa-chat-panel"
  class="group fixed bottom-4 right-3 z-[60] flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl shadow-emerald-900/20 ring-1 ring-black/5 transition-all duration-200 hover:scale-105 hover:bg-[#1ebe5b] focus:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300 motion-reduce:transition-none motion-reduce:hover:scale-100 sm:bottom-5 sm:right-5 sm:h-16 sm:w-16 md:bottom-6 md:right-6"
>
  <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-[#25D366] opacity-40 motion-reduce:hidden"></span>
  <span
    id="wa-badge"
    class="absolute -top-0.5 -right-0.5 hidden h-5 min-w-5 items-center justify-center rounded-full bg-navy-800 px-1.5 text-[11px] font-bold text-white ring-2 ring-white"
  ></span>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 32 32"
    class="h-7 w-7 fill-current sm:h-8 sm:w-8"
    aria-hidden="true"
  >
    <path d="M16 .4C7.4.4.4 7.4.4 16c0 2.8.7 5.4 2.1 7.8L0 32l8.4-2.4c2.3 1.3 4.9 2 7.6 2 8.6 0 15.6-7 15.6-15.6S24.6.4 16 .4zm0 28.4c-2.4 0-4.7-.6-6.7-1.8l-.5-.3-5 1.4 1.4-4.9-.3-.5C3.7 21 3 18.5 3 16 3 8.3 8.3 3 16 3s13 5.3 13 13-5.8 12.8-13 12.8zm7.2-9.7c-.4-.2-2.3-1.1-2.6-1.2-.4-.1-.6-.2-.9.2-.3.4-1 1.2-1.3 1.4-.2.3-.5.3-.9.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.5.6-.7.2-.2.3-.4.4-.6.1-.2 0-.5-.1-.7-.1-.2-.9-2.2-1.3-3-.3-.8-.7-.7-.9-.7h-.8c-.3 0-.7.1-1.1.5-.4.4-1.4 1.4-1.4 3.4s1.5 4 1.7 4.3c.2.3 2.9 4.5 7.1 6.3 1 .4 1.8.7 2.4.8 1 .3 1.9.3 2.6.2.8-.1 2.3-.9 2.7-1.8.3-.9.3-1.7.2-1.8-.1-.2-.4-.3-.8-.5z"></path>
  </svg>
</button>

<!-- Panel -->
<div
  id="wa-chat-panel"
  class="fixed bottom-24 right-3 z-[50] hidden w-[360px] max-w-[calc(100vw-1.5rem)] flex-col overflow-hidden rounded-3xl border border-slate-200 bg-white shadow-2xl shadow-slate-900/20 sm:right-5 sm:w-[400px] md:bottom-28 md:right-6 max-h-[calc(100dvh-7rem)]"
  role="dialog"
  aria-modal="false"
  aria-labelledby="wa-chat-name"
>
  <!-- Encabezado -->
  <div class="relative flex shrink-0 items-center gap-3 bg-navy-800 px-4 py-3 text-white">
    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-brand-500">
      <span class="text-sm font-bold">GI</span>
    </div>
    <div class="min-w-0 flex-1">
      <p id="wa-chat-name" class="truncate text-sm font-bold">
        {config.nombre}
      </p>
      <p class="truncate text-[11px] text-navy-200">{config.subtitulo}</p>
    </div>
    <button
      id="wa-close-btn"
      aria-label="Cerrar asistente"
      class="rounded-full p-1.5 text-white/70 transition hover:bg-white/10 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
    >
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
        <path
          fill-rule="evenodd"
          d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z"
          clip-rule="evenodd"
        ></path>
      </svg>
    </button>
  </div>

  <!-- Aviso: es un bot, no una persona. Sin esto es engañoso. -->
  <p class="shrink-0 border-b border-amber-200 bg-amber-50 px-4 py-2 text-[11px] leading-snug text-amber-900">
    {config.aviso}
  </p>

  <!-- Mensajes -->
  <!-- El alto va en clases y no en style. El min-height fijo de 260px hacia que
       en pantallas bajas (movil en horizontal) el panel creciese hacia arriba y
       la cabecera, con el boton de cerrar, quedase fuera de la pantalla. Con
       dvh el panel nunca pasa del alto disponible. -->
  <!--
    `min-h-0` + `max-h-*` son lo que hacen que exista la barra: como hijo flex
    con flex-basis 0 dentro de un panel que solo tiene max-height, crecía con
    el texto en vez de recortarse, y el overflow-hidden del panel tapaba los
    mensajes sin dejar scroll. Con un alto máximo propio la lista desborda de
    verdad y aparece el scroll.
  -->
  <div
    id="wa-messages"
    class="wa-scroll min-h-0 max-h-[60dvh] flex-1 space-y-3 overflow-y-auto overscroll-contain bg-slate-50 px-4 py-4 sm:max-h-[22rem]"
    style="scroll-behavior: smooth"
    role="log"
    aria-live="polite"
    aria-label="Mensajes del asistente"
  ></div>

  <!-- Escribir: no finge un chat, pasa a WhatsApp -->
  <div class="flex shrink-0 items-center gap-2 border-t border-slate-200 bg-white px-3 py-2.5">
    <label for="wa-input" class="sr-only">
      Escribe tu consulta para enviar por WhatsApp
    </label>
    <input
      id="wa-input"
      type="text"
      placeholder="Escribe tu consulta…"
      autocomplete="off"
      class="min-w-0 flex-1 rounded-full bg-slate-100 px-4 py-2.5 text-sm text-slate-700 placeholder-slate-400 focus:bg-white focus:outline-none focus:ring-2 focus:ring-brand-200"
    />
    <a
      id="wa-send-btn"
      href={waLink('Hola, escribo desde la web del Colegio y Academia Galileo.')}
      data-digits={SITE.phone.digits}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Enviar la consulta por WhatsApp"
      title="Enviar por WhatsApp"
      class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#25D366] text-white transition hover:bg-[#1ebe5b] focus:outline-none focus-visible:ring-4 focus-visible:ring-emerald-300"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="h-5 w-5"
        aria-hidden="true"
      >
        <path d="M5 12h14M13 6l6 6-6 6"></path>
      </svg>
    </a>
  </div>
</div>

<div id="wa-overlay" class="fixed inset-0 z-[40] hidden bg-navy-900/30 backdrop-blur-[1px]"></div>

<!--
  Los datos se entregan como JSON y los lee /js/whatsapp-chat.js. Así el texto
  vive aquí, con tipaje y usando SITE, en vez de duplicado en un JS suelto.
-->
<script type="application/json" id="wa-datos" set:html={JSON.stringify(config)} is:inline></script>
<script src="/js/whatsapp-chat.js" is:inline></script>

<style>
  /*
    Los enlaces van dentro del texto que pinta el bot, no como elemento propio:
    sin esto saldrían con el color del párrafo y no se leerían como enlaces.
  */
  #wa-messages a {
    color: #1b2a4e;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #wa-messages a:hover {
    color: #f04e00;
  }

  /*
    Barra de scroll del chat. La de Chrome y Safari sale invisible hasta que
    pasas el mouse por encima, así que en escritorio no había ninguna señal de
    que la conversación seguía hacia arriba. Ahora siempre se ve.
  */
  .wa-scroll {
    scrollbar-width: thin;
    scrollbar-color: #94a3b8 #e2e8f0;
  }

  .wa-scroll::-webkit-scrollbar {
    width: 10px;
  }

  .wa-scroll::-webkit-scrollbar-track {
    background: #e2e8f0;
    border-radius: 9999px;
  }

  .wa-scroll::-webkit-scrollbar-thumb {
    background: #94a3b8;
    border: 2px solid #e2e8f0;
    border-radius: 9999px;
  }

  .wa-scroll::-webkit-scrollbar-thumb:hover {
    background: #64748b;
  }
</style>
