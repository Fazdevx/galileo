---
const phone = "51997394157";
const botName = "Galileo Info";
---

<!-- Botón flotante de WhatsApp -->
<button
    id="wa-toggle-btn"
    aria-label="Abrir chat de WhatsApp"
    class="fixed bottom-4 right-3 z-[60] flex h-12 w-12 items-center justify-center rounded-full bg-[#25D366] text-white shadow-lg shadow-emerald-500/30 transition hover:scale-110 hover:bg-[#1ebe5b] sm:bottom-5 sm:right-4 sm:h-14 sm:w-14 md:bottom-6 md:right-6 md:h-16 md:w-16"
>
    <span class="absolute inset-0 -z-10 animate-ping rounded-full bg-[#25D366] opacity-60"></span>
    <span
        id="wa-badge"
        class="absolute -top-1 -right-1 flex h-4 w-4 items-center justify-center rounded-full bg-red-500 text-[10px] font-bold ring-2 ring-white"
    >
        1
    </span>
    <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 32 32"
        class="h-6 w-6 fill-current sm:h-7 sm:w-7 md:h-8 md:w-8"
    >
        <path
            d="M16 .4C7.4.4.4 7.4.4 16c0 2.8.7 5.4 2.1 7.8L0 32l8.4-2.4c2.3 1.3 4.9 2 7.6 2 8.6 0 15.6-7 15.6-15.6S24.6.4 16 .4zm0 28.4c-2.4 0-4.7-.6-6.7-1.8l-.5-.3-5 1.4 1.4-4.9-.3-.5C3.7 21 3 18.5 3 16 3 8.3 8.3 3 16 3s13 5.3 13 13-5.8 12.8-13 12.8zm7.2-9.7c-.4-.2-2.3-1.1-2.6-1.2-.4-.1-.6-.2-.9.2-.3.4-1 1.2-1.3 1.4-.2.3-.5.3-.9.1-.4-.2-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.5.6-.7.2-.2.3-.4.4-.6.1-.2 0-.5-.1-.7-.1-.2-.9-2.2-1.3-3-.3-.8-.7-.7-.9-.7h-.8c-.3 0-.7.1-1.1.5-.4.4-1.4 1.4-1.4 3.4s1.5 4 1.7 4.3c.2.3 2.9 4.5 7.1 6.3 1 .4 1.8.7 2.4.8 1 .3 1.9.3 2.6.2.8-.1 2.3-.9 2.7-1.8.3-.9.3-1.7.2-1.8-.1-.2-.4-.3-.8-.5z"
        ></path>
    </svg>
</button>

<!-- Panel de chat -->
<div
    id="wa-chat-panel"
    class="fixed bottom-24 right-3 z-[50] hidden w-[350px] max-w-[calc(100vw-2rem)] flex flex-col rounded-2xl border border-slate-200 bg-white shadow-2xl shadow-black/20 transition-all duration-300 sm:bottom-24 sm:right-4 sm:w-[380px] md:bottom-28 md:right-6 md:w-[400px]"
    role="dialog"
    aria-label="Chat de WhatsApp"
>
    <!-- Encabezado -->
    <div class="flex items-center gap-3 border-b rounded-2xl border-slate-200 bg-white px-4 py-3">
        <div class="relative flex h-10 w-10 items-center justify-center overflow-hidden rounded-full bg-brand-500 text-white">
            <span class="text-sm font-bold">GI</span>

        </div>
        <div class="flex-1 min-w-0">
            <p id="wa-chat-name" class="text-sm font-semibold text-slate-800 truncate">Galileo Info</p>
            <p id="wa-chat-status" class="text-[10px] font-semibold text-navy-800">En línea</p>
        </div>
        <button
            id="wa-close-btn"
            aria-label="Cerrar chat"
            class="rounded-full p-1 text-slate-400 hover:bg-slate-100 hover:text-slate-600"
        >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5">
                <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
        </button>
        <a
            id="wa-whatsapp-link"
            href={`https://wa.me/${phone}`}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Abrir chat de WhatsApp"
            class="ml-2 rounded-full p-1 text-emerald-500 hover:bg-slate-100 hover:text-emerald-600 transition-colors"
            title="Abrir en WhatsApp"
        >
            <i class="fab fa-whatsapp text-xl"></i>
        </a>
    </div>

    <!-- Mensajes (se llenan dinámicamente por el JS) -->
    <div
        id="wa-messages"
        class="flex-1 overflow-y-auto p-4 space-y-4 bg-white"
        style="min-height: 300px; max-height: 450px; scroll-behavior: smooth;"
        role="log"
        aria-live="polite"
        aria-label="Historial de mensajes"
    ></div>

    <!-- Input -->
    <div class="flex items-center gap-2 border-t border-slate-200 rounded-b-2xl bg-white px-3 py-2">
        <button
            id="wa-attach-btn"
            aria-label="Adjuntar"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-navy-800 text-slate-400 hover:bg-slate-200"
        >
             <svg class="text-orange-500 w-3 h-3"
xmlns="http://www.w3.org/2000/svg" width="24"  height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor">
  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
</svg>

        </button>
        <input
            id="wa-input"
            type="text"
            placeholder="Escribe un mensaje..."
            autocomplete="off"
            class="flex-1 bg-zinc-100 rounded-full px-2 py-2 text-sm text-slate-700 placeholder-slate-400 focus:outline-none"
            aria-label="Mensaje"
        />
        <button
            id="wa-send-btn"
            aria-label="Enviar mensaje"
            class="flex h-7 w-7 items-center justify-center rounded-full bg-brand-500 text-navy-800 hover:bg-brand-600 disabled:cursor-not-allowed disabled:opacity-50 transition"
            disabled
        >
            <svg class=" w-4 h-4"
xmlns="http://www.w3.org/2000/svg" width="24"  height="24"   viewBox="0 0 24 24"  stroke-width="2" stroke="currentColor" fill="none" stroke-linecap="round" stroke-linejoin="round">  <path stroke="none" d="M0 0h24v24H0z"/>  <line x1="10" y1="14" x2="21" y2="3" />  <path d="M21 3L14.5 21a.55 .55 0 0 1 -1 0L10 14L3 10.5a.55 .55 0 0 1 0 -1L21 3" /></svg>
        </button>
    </div>
</div>

<!-- Overlay -->
<div
    id="wa-overlay"
    class="fixed inset-0 z-[40] hidden bg-black/30 transition-opacity"
    aria-hidden="true"
></div>

<script src="/js/whatsapp-chat.js" is:inline></script>
