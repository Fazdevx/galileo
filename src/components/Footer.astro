---
import Logo from './Logo.astro';
import { SITE, ACADEMIA_SOCIAL, TRAYECTORIA, waLink } from '../data/site';

/**
 * Redes del sitio. Las que tengan URL se muestran solas; Instagram queda
 * oculta mientras no haya enlace. WhatsApp no va en SITE.social porque no es
 * un perfil público (sameAs no lo quiere), pero sí aquí como vía de contacto
 * directo. Colegio y Academia tienen cuentas y teléfonos distintos, así que
 * cada uno arma su propia lista.
 */
const svgFacebook =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>';
const svgYouTube =
  '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>';
const svgTikTok =
  '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true"><path d="M16.656 1.029c1.637-0.025 3.262-0.012 4.886-0.025 0.054 2.031 0.878 3.859 2.189 5.213l-0.002-0.002c1.411 1.271 3.247 2.095 5.271 2.235l0.028 0.002v5.036c-1.912-0.048-3.71-0.489-5.331-1.247l0.082 0.034c-0.784-0.377-1.447-0.764-2.077-1.196l0.052 0.034c-0.012 3.649 0.012 7.298-0.025 10.934-0.103 1.853-0.719 3.543-1.707 4.954l0.020-0.031c-1.652 2.366-4.328 3.919-7.371 4.011l-0.014 0c-0.123 0.006-0.268 0.009-0.414 0.009-1.73 0-3.347-0.482-4.725-1.319l0.040 0.023c-2.508-1.509-4.238-4.091-4.558-7.094l-0.004-0.041c-0.025-0.625-0.037-1.25-0.012-1.862 0.49-4.779 4.494-8.476 9.361-8.476 0.547 0 1.083 0.047 1.604 0.136l-0.056-0.008c0.025 1.849-0.050 3.699-0.050 5.548-0.423-0.153-0.911-0.242-1.42-0.242-1.868 0-3.457 1.194-4.045 2.861l-0.009 0.030c-0.133 0.427-0.21 0.918-0.21 1.426 0 0.206 0.013 0.41 0.037 0.61l-0.002-0.024c0.332 2.046 2.086 3.59 4.201 3.59 0.061 0 0.121-0.001 0.181-0.004l-0.009 0c1.463-0.044 2.733-0.831 3.451-1.994l0.010-0.018c0.267-0.372 0.45-0.822 0.511-1.311l0.001-0.014c0.125-2.237 0.075-4.461 0.087-6.698 0.012-5.036-0.012-10.060 0.025-15.083z"/></svg>';
const svgWhatsApp =
  '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0 0 20.463 3.488 11.815 11.815 0 0 0 12.05 0z"/></svg>';

const armarRedes = (
  social: { facebook: string; youtube: string; tiktok: string },
  waMensaje: string,
  waDigitos: string,
) => [
  { nombre: 'Facebook', href: social.facebook, clase: 'bg-blue-600 hover:bg-blue-500', svg: svgFacebook },
  { nombre: 'YouTube', href: social.youtube, clase: 'bg-red-600 hover:bg-red-500', svg: svgYouTube },
  { nombre: 'TikTok', href: social.tiktok, clase: 'bg-black hover:bg-neutral-800', svg: svgTikTok },
  {
    nombre: 'WhatsApp',
    href: waLink(waMensaje, waDigitos),
    clase: 'bg-green-500 hover:bg-green-400',
    svg: svgWhatsApp,
  },
].filter((red) => red.href);

const gruposRedes = [
  {
    titulo: 'Colegio',
    redes: armarRedes(SITE.social, 'Hola, quisiera hacer una consulta sobre el Colegio Galileo.', SITE.phone.digits),
  },
  {
    titulo: 'Academia',
    redes: armarRedes(
      ACADEMIA_SOCIAL,
      'Hola! 🐯 Quisiera pedir más información sobre: ',
      SITE.phoneAcademia.digits,
    ),
  },
];
---

<footer class="bg-navy-700 text-navy-100">
  <div class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12">
    <div class="grid gap-6 grid-cols-2 sm:grid-cols-2 md:grid-cols-4">
      <div class="col-span-2 sm:col-span-2 md:col-span-1">
        <Logo mark="logo" size="(min-width: 768px) 160px, 128px" class="h-8 w-auto sm:h-10 md:h-12" />
        <p class="mt-2 text-xs text-navy-100 sm:text-sm">
          Formando líderes con valores y excelencia académica desde {SITE.fundacion}.
        </p>
        <p class="mt-1 text-xs text-brand-300">{TRAYECTORIA}.</p>
      </div>
      <div>
        <h4 class="font-bold text-white text-sm sm:text-base">Programas</h4>
        <ul class="mt-2 space-y-1.5 text-xs sm:mt-3 sm:space-y-2 sm:text-sm">
          <li>
            <a href="/#programas" class="hover:text-brand-300">
              Inicial
            </a>
          </li>
          <li>
            <a href="/#programas" class="hover:text-brand-300">
              Primaria
            </a>
          </li>
          <li>
            <a href="/#programas" class="hover:text-brand-300">
              Secundaria
            </a>
          </li>
          <li>
            <a href="/academia" class="hover:text-brand-300">
              Academia
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h4 class="font-bold text-white text-sm sm:text-base">Enlaces</h4>
        <ul class="mt-2 space-y-1.5 text-xs sm:mt-3 sm:space-y-2 sm:text-sm">
          <li>
            <a href="/nosotros" class="hover:text-brand-300">
              Nosotros
            </a>
          </li>
          <li>
            <a href="/#opiniones" class="hover:text-brand-300">
              Opiniones
            </a>
          </li>
          <li>
            <a href="/#contacto" class="hover:text-brand-300">
              Contacto
            </a>
          </li>
          <li>
            <a href="#" class="hover:text-brand-300">
              Política de privacidad
            </a>
          </li>
        </ul>
      </div>
      <div class="col-span-2 sm:col-span-2 md:col-span-1">
        <h4 class="font-bold text-white text-sm sm:text-base">Síguenos</h4>
        <div class="mt-2 space-y-3 sm:mt-3">
          {gruposRedes.map((grupo) => (
            <div>
              <p class="text-[11px] font-bold uppercase tracking-widest text-brand-300">{grupo.titulo}</p>
              <div class="mt-1.5 flex justify-center gap-2 sm:gap-3 md:justify-start">
                {grupo.redes.map((red) => (
                  <a
                    href={red.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={red.nombre}
                    class={`flex h-8 w-8 items-center justify-center rounded-full text-white transition sm:h-9 sm:w-9 md:h-10 md:w-10 ${red.clase}`}
                    set:html={red.svg}
                  />
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
    <div class="mt-6 border-t border-navy-800 pt-4 text-center text-[10px] text-navy-200 sm:mt-8 sm:pt-6 sm:text-xs">
      © {new Date().getFullYear()} Colegio y Academia Galileo. Todos los derechos reservados.
    </div>
  </div>
</footer>
