---
/**
 * Formulario de reclamo del premio.
 *
 * Se usa en los dos juegos (ruleta y baraja), así que los ids llevan el
 * prefijo del modo para no colisionar y `showWinForm()` los busca con
 * `${mode}-...`.
 */
interface Props {
  /** 'spin' para la ruleta, 'deck' para la baraja. */
  mode: 'spin' | 'deck';
}

const { mode } = Astro.props;
---

<div class="rounded-xl bg-navy-900/20 p-4 text-left ring-2 ring-brand-500/30 backdrop-blur-sm">
  <div
    data-prize-summary
    class="mb-4 flex items-center gap-3 rounded-lg bg-brand-500/15 p-3 ring-1 ring-brand-500/30"
  >
    <span data-prize-icon class="shrink-0 text-brand-400" aria-hidden="true"></span>
    <div class="min-w-0">
      <p class="text-[11px] font-bold uppercase tracking-wider text-brand-300">Tu premio</p>
      <p data-prize-name class="truncate text-sm font-extrabold text-white"></p>
      <p data-prize-desc class="truncate text-xs text-white/70"></p>
    </div>
  </div>

  <p class="mb-1 flex items-center gap-2 text-sm font-bold text-white">
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      class="h-4 w-4 shrink-0 text-brand-400"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="M22 2 11 13"></path>
      <path d="M22 2l-7 20-4-9-9-4z"></path>
    </svg>
    Reclama tu premio
  </p>
  <p class="mb-4 text-sm text-white/80">
    Completa tus datos y te contactamos por WhatsApp para entregarte el premio en oficina.
  </p>

  <form id={`${mode}-win-form-el`} novalidate>
    <div class="mb-3">
      <label class="mb-1 block text-xs font-bold text-white/80" for={`${mode}-parent-name`}>
        Nombre del padre o madre
      </label>
      <input
        id={`${mode}-parent-name`}
        name="nombre"
        type="text"
        autocomplete="name"
        placeholder="Ej: Juan Pérez"
        required
        class="w-full rounded-lg border-2 border-brand-500/50 bg-navy-900/30 px-3 py-2 text-sm text-white placeholder:text-white/40 focus:border-brand-500 focus:outline-none"
      />
    </div>

    <div class="mb-3">
      <label class="mb-1 block text-xs font-bold text-white/80" for={`${mode}-phone`}>
        Tu número de WhatsApp
      </label>
      <div class="flex items-stretch">
        <span
          class="flex items-center rounded-l-lg border-2 border-r-0 border-brand-500/50 bg-navy-900/50 px-3 text-sm text-white/70"
        >
          +51
        </span>
        <input
          id={`${mode}-phone`}
          name="telefono"
          type="tel"
          inputmode="numeric"
          autocomplete="tel"
          maxlength="9"
          placeholder="9 dígitos"
          required
          class="w-full rounded-r-lg border-2 border-brand-500/50 bg-navy-900/30 px-3 py-2 text-sm text-white placeholder:text-white/40 focus:border-brand-500 focus:outline-none"
        />
      </div>
      <p class="mt-1 text-[11px] text-white/60">Sin espacios. Ej: 987654321</p>
    </div>

    <div class="mb-3">
      <label class="mb-1 block text-xs font-bold text-white/80" for={`${mode}-ticket-number`}>
        Número de tu último comprobante de pago
      </label>
      <input
        id={`${mode}-ticket-number`}
        name="comprobante"
        type="text"
        inputmode="numeric"
        placeholder="Ej: B001-0012345"
        required
        class="w-full rounded-lg border-2 border-brand-500/50 bg-navy-900/30 px-3 py-2 text-sm text-white placeholder:text-white/40 focus:border-brand-500 focus:outline-none"
      />
      <p class="mt-1 text-[11px] text-white/60">
        Con esto validamos que la matrícula o mensualidad esté al día.
      </p>
    </div>

    <p
      id={`${mode}-form-error`}
      role="alert"
      aria-live="polite"
      class="mb-3 hidden rounded-lg bg-red-500/20 px-3 py-2 text-xs font-bold text-red-200"
    >
    </p>

    <div class="flex flex-col gap-2 sm:flex-row">
      <button
        id={`${mode}-whatsapp-btn`}
        type="submit"
        class="flex flex-1 items-center justify-center gap-2 rounded-lg bg-green-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-green-700 focus:outline-none focus:ring-4 focus:ring-green-500/40"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 32 32"
          class="h-5 w-5 fill-current"
          aria-hidden="true"
        >
          <path
            d="M16 .4C7.4.4.4 7.4.4 16c0 2.8.7 5.4 2.1 7.8L0 32l8.4-2.4c2.3 1.3 4.9 2 7.6 2 8.6 0 15.6-7 15.6-15.6S24.6.4 16 .4zm0 28.4c-2.4 0-4.7-.6-6.7-1.8l-.5-.3-5 1.4 1.4-4.9-.3-.5C3.7 21 3 18.5 3 16 3 8.3 8.3 3 16 3s13 5.3 13 13-5.8 12.8-13 12.8zm7.2-9.7c-.4-.2-2.3-1.1-2.6-1.2-.4-.1-.6-.2-.9.2-.3.4-1.6-.6-3.1-1.9-1.1-1-1.9-2.3-2.1-2.7-.2-.4 0-.6.2-.8.2-.2.4-.5.6-.7.2-.2.3-.4.4-.6.1-.2 0-.5-.1-.7-.1-.2-.9-2.2-1.3-3-.3-.8-.7-.7-.9-.7h-.8c-.3 0-.7.1-1.1.5-.4.4-1.4 1.4-1.4 3.4s1.5 4 1.7 4.3c.2.3 2.9 4.5 7.1 6.3 1 .4 1.8.7 2.4.8 1 .3 1.9.3 2.6.2.8-.1 2.3-.9 2.7-1.8.3-.9.3-1.7.2-1.8-.1-.2-.4-.3-.8-.5z"
          ></path>
        </svg>
        Enviar por WhatsApp
      </button>
      <button
        id={`${mode}-close-btn`}
        type="button"
        class="rounded-lg bg-navy-600 px-4 py-2.5 text-sm font-bold text-white transition hover:bg-navy-700 focus:outline-none focus:ring-4 focus:ring-white/20"
      >
        Cerrar
      </button>
    </div>

    <p class="mt-3 flex items-start gap-1.5 text-[11px] text-white/50">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        viewBox="0 0 24 24"
        class="mt-px h-3.5 w-3.5 shrink-0"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
      >
        <rect x="8" y="2" width="8" height="4" rx="1"></rect>
        <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"></path>
      </svg>
      Solo se guarda en este dispositivo hasta que envías el mensaje. No compartimos datos con terceros.
    </p>
  </form>
</div>