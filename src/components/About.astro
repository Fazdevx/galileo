---
import { Image } from 'astro:assets';
import frontis from '../assets/frontis.webp';
import victorImg from '../assets/retratos/victor-loyola-retrato.webp';
import hildaImg from '../assets/retratos/hilda-olivares-retrato.webp';
import directorImg from '../assets/retratos/giovani-estupinan-card.webp';
import humbertoImg from '../assets/retratos/humberto-jara-card.webp';
import nicolImg from '../assets/retratos/nicol-isidro-card.webp';
import juliImg from '../assets/retratos/juliana-chunga-card.webp';
import rosaImg from '../assets/retratos/rosa-lalupu-card.webp';
import gustavoImg from '../assets/retratos/gustavo-melgarejo-card.webp';
import rayImg from '../assets/retratos/ray-argomedo-card.webp';
import rafaelImg from '../assets/retratos/rafael-castillo-card.webp';
import karlaImg from '../assets/retratos/karla-vasquez-card.webp';
import { TRAYECTORIA } from '../data/site';

/**
 * Retratos del personal, ya en WebP y tamaños razonables. Los masters (PNG de
 * 4000x6000 y hasta 27 MB) se procesan en scripts/gen-retratos-assets.mjs con
 * `-card` (512x512, circulos) y `-retrato` (640x854, tarjetas de fundadores).
 * Importar los masters directamente hace que /nosotros tarde una eternidad.
 * En Astro 5+ el import de un asset devuelve metadata: `.src` da la URL final.
 */
const url = (img: { src: string }) => img.src;

/** "Hilda Olivares Roca" -> "HO". Respaldo para quien no tiene retrato. */
const iniciales = (nombre: string) =>
  nombre
    .split(' ')
    .filter(Boolean)
    .slice(0, 2)
    .map((p) => p.charAt(0).toUpperCase())
    .join('');

/**
 * Fundadores de la institucion. Son la maxima autoridad: crearon y sostienen el
 * proyecto, asi que van por encima del organigrama.
 *
 * `foto` es null cuando no hay retrato. En vez de un hueco roto se dibuja un
 * circulo con las iniciales; cuando llegue la foto, solo se agrega aqui.
 */
const fundadores = [
  {
    nombre: 'Víctor Loyola Padilla',
    cargo: 'Fundador y promotor del Colegio y Academia Galileo',
    foto: url(victorImg),
  },
  {
    nombre: 'Hilda Olivares Roca',
    cargo: 'Fundadora del Colegio y Academia Galileo',
    foto: url(hildaImg),
  },
];

/**
 * Organigrama en dos ejes. La dirección va arriba (hero) y de ahí salen dos
 * ramas: el eje académico (pedagógico -> coordinadores por grado -> psicología)
 * y el eje administrativo y de apoyo (administrativo -> enfermería -> soporte).
 *
 * Dentro de cada eje, `lead` es la persona responsable del eje (fila destacada)
 * y `grupos` son las sub-áreas con sus personas, en orden jerárquico.
 *
 * `personas` lleva nombre propio; `cargos` son roles sin titular nominado.
 */
const direccion = {
  area: 'Dirección',
  resumen: 'Liderazgo de la institución y de la operación académica.',
  personas: [{ nombre: 'Giovani Estupiñán', cargo: 'Director de la Institución Educativa Galileo', foto: url(directorImg) }],
};
const director = direccion.personas[0];

const ejes = [
  {
    titulo: 'Eje Académico',
    resumen: 'Coordinación pedagógica, niveles educativos y acompañamiento socioemocional.',
    lead: { nombre: 'Humberto Jara', cargo: 'Responsable pedagógico', foto: url(humbertoImg) },
    grupos: [
      {
        titulo: 'Coordinadores de nivel',
        personas: [
          { nombre: 'Juliana Chunga', cargo: 'Coordinadora de Nivel Inicial', foto: url(juliImg) },
          { nombre: 'Rosa Lalupu', cargo: 'Coordinadora de Nivel Primaria', foto: url(rosaImg) },
          { nombre: 'Gustavo Melgarejo', cargo: 'Coordinador de Nivel Secundaria', foto: url(gustavoImg) },
        ],
      },
      {
        titulo: 'Psicología',
        personas: [
          { nombre: 'Ray Argomedo', cargo: 'Psicólogo', foto: url(rayImg) },
          { nombre: 'Rafael Castillo', cargo: 'Psicólogo', foto: url(rafaelImg) },
        ],
      },
    ],
  },
  {
    titulo: 'Eje Administrativo y de Apoyo',
    resumen: 'Gestión administrativa, salud escolar y servicios generales.',
    lead: { nombre: 'Nicol Isidro', cargo: 'Responsable administrativo', foto: url(nicolImg) },
    grupos: [
      {
        titulo: 'Enfermería',
        personas: [{ nombre: 'Karla Vásquez', cargo: 'Enfermera escolar', foto: url(karlaImg) }],
      },
      {
        titulo: 'Soporte',
        personas: [],
        cargos: ['Personal de soporte'],
      },
    ],
  },
];

const items = [
  {
    title: 'Misión',
    desc: 'Brindar una educación integral, inclusiva y de calidad que forme ciudadanos críticos, creativos y comprometidos con su entorno, a través de metodologías activas y un acompañamiento cercano a cada estudiante.',
    icon: 'M12 2L2 7l10 5 10-5-10-5z M2 17l10 5 10-5 M2 12l10 5 10-5',
  },
  {
    title: 'Visión',
    desc: 'Ser al 2030 una institución educativa líder e innovadora en Latinoamérica, reconocida por la excelencia académica, la formación en valores y el impacto positivo en la sociedad.',
    icon: 'M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z M12 15a3 3 0 100-6 3 3 0 000 6z',
  },
  {
    title: 'Valores',
    desc: 'Respeto, responsabilidad, honestidad, solidaridad y excelencia son los pilares que guían cada acción de nuestra comunidad educativa y que cultivamos día a día.',
    icon: 'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z',
  },
  {
    title: 'Compromiso',
    desc: 'Acompañamos a cada estudiante y su familia en su camino de crecimiento personal y académico, construyendo vínculos duraderos basados en la confianza y la comunicación.',
    icon: 'M9 12l2 2 4-4 M12 22a10 10 0 100-20 10 10 0 000 20z',
  },
];
---

<section id="nosotros" class="bg-slate-50 py-16 sm:py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-700 to-navy-800 px-6 py-10 text-center shadow-xl sm:px-12 sm:py-14 md:py-16">
      <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-brand-500/15 blur-3xl"></div>
      <div class="absolute -bottom-12 -left-12 h-44 w-44 rounded-full bg-brand-500/10 blur-3xl"></div>
      <span class="relative inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-xs font-bold uppercase tracking-widest text-brand-300 sm:text-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        Sobre nosotros
      </span>
      <h1 class="relative mx-auto mt-3 max-w-2xl text-2xl font-extrabold text-white sm:text-3xl md:text-4xl">
        Una institución con valores sólidos
      </h1>
      <p class="relative mx-auto mt-4 max-w-2xl text-base text-navy-100 sm:text-lg">
        En el Colegio y Academia Galileo creemos en una educación integral que combina la excelencia académica con la
        formación en valores.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4 md:mt-14">
      {items.map((item) => (
        <article class="group relative rounded-2xl bg-white p-6 shadow-sm ring-1 ring-slate-200 transition-all hover:-translate-y-1 hover:shadow-xl hover:ring-brand-300 sm:p-8">
          <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-xl bg-brand-50 text-brand-500 transition-colors group-hover:bg-brand-500 group-hover:text-white">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={item.icon} />
            </svg>
          </div>
          <h3 class="text-xl font-extrabold text-navy-700">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.desc}</p>
        </article>
      ))}
    </div>

    <div id="autoridades" class="mt-14 sm:mt-16 md:mt-20">
      <div class="mx-auto max-w-2xl text-center">
        <span class="text-sm font-bold uppercase tracking-wider text-brand-500">Autoridades</span>
        <h3 class="mt-3 text-2xl font-extrabold text-navy-700 sm:text-3xl">Las autoridades educativas del Galileo</h3>
        <p class="mt-4 text-slate-600">
          Quienes fundaron y dirigen la institución, con el cargo que les corresponde dentro de la comunidad Galileana.
        </p>
      </div>

      <div
        class="mx-auto mt-8 flex max-w-2xl items-center gap-2"
        role="tablist"
        aria-label="Autoridades y organización"
      >
        <button
          id="tab-fundadores"
          type="button"
          role="tab"
          aria-selected="true"
          aria-controls="panel-fundadores"
          class="flex-1 rounded-full bg-navy-800 px-5 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-navy-700"
        >
          Fundadores
        </button>
        <button
          id="tab-organigrama"
          type="button"
          role="tab"
          aria-selected="false"
          aria-controls="panel-organigrama"
          tabindex="-1"
          class="flex-1 rounded-full px-5 py-2.5 text-sm font-bold text-white transition hover:bg-white hover:text-brand-600"
        >
          Organización
        </button>
      </div>

      <div
        id="panel-fundadores"
        role="tabpanel"
        aria-labelledby="tab-fundadores"
        class="mx-auto mt-8 grid max-w-2xl gap-6 sm:grid-cols-2 sm:gap-8"
      >
        {fundadores.map((persona) => (
          <article class="overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-slate-200 transition-all hover:-translate-y-1 hover:shadow-xl hover:ring-brand-300">
            <div class="aspect-3/4 overflow-hidden bg-slate-100">
              {persona.foto ? (
                <img
                  src={persona.foto}
                  alt={`Retrato de ${persona.nombre}, ${persona.cargo.toLowerCase()} del Colegio y Academia Galileo`}
                  width="640"
                  height="854"
                  class="h-full w-full object-cover object-top"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-navy-700 to-navy-800">
                  <span
                    class="flex h-28 w-28 items-center justify-center rounded-full border-4 border-white/20 bg-white/10 text-4xl font-black tracking-wider text-white sm:h-32 sm:w-32 sm:text-5xl"
                    aria-hidden="true"
                  >
                    {iniciales(persona.nombre)}
                  </span>
                </div>
              )}
            </div>
            <div class="border-t border-slate-100 px-6 py-5 text-center">
              <p class="text-xl font-extrabold text-navy-700 sm:text-2xl">{persona.nombre}</p>
              <p class="mt-1 text-sm font-semibold text-brand-600">{persona.cargo}</p>
            </div>
          </article>
        ))}
      </div>

      <div
        id="panel-organigrama"
        role="tabpanel"
        aria-labelledby="tab-organigrama"
        class="mx-auto mt-8 hidden max-w-6xl"
      >
        <div class="space-y-0">
          <div class="mx-auto max-w-3xl overflow-hidden rounded-3xl bg-gradient-to-br from-navy-700 via-navy-800 to-navy-900 p-5 shadow-xl ring-1 ring-navy-800/50 sm:p-6">
            <div class="flex items-center gap-5 sm:gap-8">
              <div class="h-48 w-48 flex-shrink-0 overflow-hidden rounded-full bg-navy-900 ring-4 ring-white/15 sm:h-56 sm:w-56">
                {director.foto ? (
                  <img
                    src={director.foto}
                    alt={`Foto de ${director.nombre}`}
                    width="512"
                    height="512"
                    class="h-full w-full object-cover object-top"
                    loading="lazy"
                    decoding="async"
                  />
                ) : (
                  <div class="flex h-full w-full items-center justify-center">
                    <span class="text-6xl font-black tracking-wider text-white" aria-hidden="true">{iniciales(director.nombre)}</span>
                  </div>
                )}
              </div>
              <div class="min-w-0">
                <span class="text-xs font-bold uppercase tracking-widest text-brand-400">{direccion.area}</span>
                <p class="mt-1 text-xl font-extrabold text-white sm:text-2xl">{director.nombre}</p>
                <p class="mt-0.5 text-sm font-semibold text-brand-300">{director.cargo}</p>
                <p class="mt-2 text-sm leading-relaxed text-navy-200 sm:text-base">{direccion.resumen}</p>
              </div>
            </div>
          </div>

          {/* Líneas del organigrama: baja del director y se divide en dos ejes. */}
          <div class="relative hidden h-10 sm:block" aria-hidden="true">
            <span class="absolute left-1/2 top-0 h-5 w-px -translate-x-1/2 bg-slate-300"></span>
            <span class="absolute left-1/4 right-1/4 top-5 h-px bg-slate-300"></span>
            <span class="absolute left-1/4 top-5 h-5 w-px bg-slate-300"></span>
            <span class="absolute right-1/4 top-5 h-5 w-px bg-slate-300"></span>
          </div>

          <div class="grid gap-6 sm:grid-cols-2">
            {ejes.map((eje) => (
              <section class="rounded-3xl bg-white p-5 shadow-sm ring-1 ring-slate-200 sm:p-6">
                <header class="border-b border-slate-100 pb-4">
                  <span class="text-sm font-extrabold uppercase tracking-widest text-navy-700">{eje.titulo}</span>
                  <p class="mt-1 text-sm text-slate-500">{eje.resumen}</p>
                </header>

                <div class="mt-4 flex items-center gap-4 rounded-2xl bg-brand-50/60 p-4 ring-2 ring-brand-200">
                  <div class="h-28 w-28 flex-shrink-0 overflow-hidden rounded-full bg-slate-100 ring-2 ring-brand-300 sm:h-32 sm:w-32">
                    {eje.lead.foto ? (
                      <img
                        src={eje.lead.foto}
                        alt={`Foto de ${eje.lead.nombre}`}
                        width="512"
                        height="512"
                        class="h-full w-full object-cover object-top"
                        loading="lazy"
                        decoding="async"
                      />
                    ) : (
                      <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-50 to-brand-100">
                        <span class="text-4xl font-black text-brand-500" aria-hidden="true">{iniciales(eje.lead.nombre)}</span>
                      </div>
                    )}
                  </div>
                  <div class="min-w-0">
                    <p class="text-base font-extrabold text-navy-700 sm:text-lg">{eje.lead.nombre}</p>
                    <p class="text-sm leading-snug text-slate-600">{eje.lead.cargo}</p>
                  </div>
                </div>

                {eje.grupos.map((grupo) => (
                  <div class="mt-5">
                    <h5 class="text-[11px] font-bold uppercase tracking-wider text-brand-500">{grupo.titulo}</h5>
                    <ul class="mt-3 space-y-3">
                      {grupo.personas.map((persona) => (
                        <li class="flex items-center gap-4 rounded-2xl bg-slate-50 p-4 ring-1 ring-slate-100 transition hover:ring-brand-300">
                          <div class="h-24 w-24 flex-shrink-0 overflow-hidden rounded-full bg-slate-100 ring-2 ring-brand-100 sm:h-28 sm:w-28">
                            {persona.foto ? (
                              <img
                                src={persona.foto}
                                alt={`Foto de ${persona.nombre}`}
                                width="512"
                                height="512"
                                class="h-full w-full object-cover object-top"
                                loading="lazy"
                                decoding="async"
                              />
                            ) : (
                              <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-50 to-brand-100">
                                <span class="text-3xl font-black text-brand-500" aria-hidden="true">{iniciales(persona.nombre)}</span>
                              </div>
                            )}
                          </div>
                          <div class="min-w-0">
                            <p class="text-sm font-extrabold leading-tight text-navy-700 sm:text-base">{persona.nombre}</p>
                            <p class="text-xs leading-snug text-slate-600 sm:text-sm">{persona.cargo}</p>
                          </div>
                        </li>
                      ))}
                      {(grupo.cargos ?? []).map((cargo) => (
                        <li class="rounded-2xl bg-slate-50 px-4 py-3 text-sm font-semibold text-navy-700 ring-1 ring-slate-100">
                          {cargo}
                        </li>
                      ))}
                    </ul>
                  </div>
                ))}
              </section>
            ))}
          </div>
        </div>
      </div>
    </div>

    <div class="mt-14 grid items-center gap-10 sm:mt-16 md:mt-20 md:grid-cols-2 md:gap-12">
      <div>
        <span class="text-sm font-bold uppercase tracking-wider text-brand-500">Lo que nos distingue</span>
        <h3 class="mt-3 text-2xl font-extrabold text-navy-700 sm:text-3xl">Educación que transforma vidas</h3>
        <p class="mt-4 text-slate-600">
          Con {TRAYECTORIA} de trayectoria formamos estudiantes con una propuesta educativa innovadora, cercana y
          comprometida con el futuro de cada uno.
        </p>
        <div class="mt-4 overflow-hidden rounded-2xl">
          <Image
            src={frontis}
            alt="Frontis del comedor y aulas del colegio Galileo"
            widths={[640, 960, 1200]}
            sizes="(max-width: 1024px) 100vw, 50vw"
            class="h-auto w-full"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
      <ul class="space-y-3">
        {[
          { title: 'Docentes altamente capacitados', desc: 'En constante actualización pedagógica y disciplinar.' },
          { title: 'Metodología activa', desc: 'Aprendizaje significativo basado en proyectos y problemas.' },
          { title: 'Acompañamiento psicoeducativo', desc: 'Departamento de orientación y tutorías personalizadas.' },
          { title: 'Infraestructura moderna y segura', desc: 'Aulas equipadas, laboratorios y áreas verdes.' },
          { title: 'Programa bilingüe', desc: 'Inglés desde inicial con certificación internacional.' },
        ].map((item) => (
          <li class="flex items-start gap-3 rounded-xl bg-white p-4 ring-1 ring-slate-200 transition hover:ring-brand-300 sm:gap-4 sm:p-5">
            <div class="flex h-9 w-9 flex-shrink-0 items-center justify-center rounded-full bg-brand-500 text-white sm:h-10 sm:w-10">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-4 w-4 sm:h-5 sm:w-5"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <div class="min-w-0">
              <p class="font-bold text-navy-700">{item.title}</p>
              <p class="text-sm text-slate-600">{item.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script is:inline>
  /**
   * Alterna entre las dos vistas de Autoridades: los fundadores y el
   * organigrama. No hay modal; el bloque se queda en la pagina y solo cambia lo
   * que se ve.
   *
   * Las dos vistas quedan siempre en el HTML (una con `hidden`), asi que los
   * nombres y los cargos se leen igual aunque la persona nunca pulse. Eso si
   * se cambia a display:none en el servidor, Google se los pierde.
   */
  (() => {
    const ACTIVO = ['bg-navy-800', 'text-white', 'shadow-sm'];
    const INACTIVO = ['text-navy-700', 'hover:bg-white', 'hover:text-brand-600'];

    const pintar = (btn, activo) => {
      btn.classList.toggle(...ACTIVO, activo);
      btn.classList.toggle(...INACTIVO, !activo);
      btn.setAttribute('aria-selected', String(activo));
      // Solo la pestana activa entra en el orden del teclado.
      btn.tabIndex = activo ? 0 : -1;
    };

    const tabs = Array.from(document.querySelectorAll('[role="tab"]'));

    tabs.forEach((btn) => {
      const panel = document.getElementById(btn.getAttribute('aria-controls'));
      if (!panel) return;

      pintar(btn, btn.getAttribute('aria-selected') === 'true');

      btn.addEventListener('click', () => {
        tabs.forEach((otro) => {
          const otroPanel = document.getElementById(otro.getAttribute('aria-controls'));
          pintar(otro, otro === btn);
          otroPanel?.classList.toggle('hidden', otro !== btn);
        });
      });
    });

    // Flechas izquierda/derecha: es lo que se espera de un tablist con teclado.
    document.querySelector('[role="tablist"]')?.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      const i = tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true');
      const siguiente = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
      if (!siguiente) return;
      e.preventDefault();
      siguiente.click();
      siguiente.focus();
    });
  })();
</script>
