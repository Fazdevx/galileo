---
const reasons = [
  {
    title: 'Excelencia académica',
    desc: 'Resultados comprobados en pruebas nacionales e internacionales.',
    icon: 'M8 21h8 M12 17v4 M7 4h10v5a5 5 0 11-10 0V4z M3 4h4v4H3z M17 4h4v4h-4z'
  },
  {
    title: 'Docentes calificados',
    desc: 'Profesores con maestría y experiencia en metodología activa.',
    icon: 'M16 7a4 4 0 11-8 0 4 4 0 018 0z M12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z M19 11l2 2 4-4'
  },
  {
    title: 'Acompañamiento integral',
    desc: 'Departamento psicopedagógico y tutorías personalizadas.',
    icon: 'M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z M9 12l2 2 4-4'
  },
  {
    title: 'Tecnología educativa',
    desc: 'Aulas digitales, plataformas virtuales y robótica.',
    icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z'
  },
  {
    title: 'Actividades extracurriculares',
    desc: 'Deportes, artes, ciencia y liderazgo.',
    icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z M12 6v6l4 2'
  },
  {
    title: 'Comunidad educativa',
    desc: 'Eventos, integración familiar y valores compartidos.',
    icon: 'M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2 M9 11a4 4 0 100-8 4 4 0 000 8z M23 21v-2a4 4 0 00-3-3.87 M16 3.13a4 4 0 010 7.75'
  },
];
---
<section id="por-que-elegirnos" class="bg-white py-16 sm:py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <span class="text-sm font-bold uppercase tracking-wider text-brand-500">¿Por qué elegirnos?</span>
      <h2 class="mt-3 text-2xl font-extrabold text-navy-700 sm:text-3xl md:text-4xl">Una educación que marca la diferencia</h2>
    </div>
    <div class="mt-10 grid gap-6 sm:mt-12 sm:grid-cols-2 sm:gap-8 lg:grid-cols-3">
      {reasons.map(r => (
        <div class="flex gap-3 sm:gap-4">
          <div class="flex h-12 w-12 flex-shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-600 sm:h-14 sm:w-14">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 sm:h-7 sm:w-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d={r.icon} />
            </svg>
          </div>
          <div>
            <h3 class="text-base font-bold text-navy-700 sm:text-lg">{r.title}</h3>
            <p class="mt-1 text-sm text-slate-600">{r.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>