---
import { Image, getImage } from 'astro:assets';
import frontis from '../assets/frontis.png';
import campoGrass from '../assets/campo-grass.png';
import desfileImg from '../assets/desfile.jpg';
import ganadores from '../assets/ganadores-desfile.png';
import deporte1 from '../assets/deporte-1.png';
import deporte2 from '../assets/deporte-2.png';
import copas from '../assets/copas.png';
import ingresantes from '../assets/ingresantes.png';

const fotos = [
  { src: frontis, alt: 'Frontis del comedor y aulas del colegio Galileo', caption: 'Nuestras instalaciones' },
  { src: campoGrass, alt: 'Campo de grass del colegio Galileo', caption: 'Campo deportivo' },
  { src: desfileImg, alt: 'Desfile escolar del colegio Galileo', caption: 'Desfile cívico escolar' },
  { src: ganadores, alt: 'Ganadores del desfile escolar del colegio Galileo', caption: 'Ganadores del desfile' },
  { src: deporte1, alt: 'Estudiantes participando en las olimpiadas internas', caption: 'Olimpiadas internas' },
  { src: deporte2, alt: 'Estudiantes durante las competencias deportivas', caption: 'Competencias deportivas' },
  { src: copas, alt: 'Copas de las olimpiadas internas', caption: 'Nuestras olimpiadas' },
  {
    src: ingresantes,
    alt: 'Foto grupal de los cachimbos que ingresaron a la universidad',
    caption: 'Cachimbos ingresantes a la universidad',
  },
];

/**
 * Plain-object copy for the lightbox script.
 *
 * The grid below uses <Image>, which emits a responsive srcset. A lightbox
 * shows exactly one full-width image, so a srcset buys nothing there, and the
 * raw `src` would point at the unprocessed 2-3 MB PNG. Resolving it through
 * getImage routes the URL through the same optimizer the grid uses.
 *
 * Note: with the Vercel adapter the actual format is negotiated from the
 * Accept header, so passing `format` here has no effect and the width is
 * snapped to the service's presets. The call is here to get an optimized URL
 * rather than a guaranteed WebP.
 */
const lightbox = await Promise.all(
  fotos.map(async (f) => {
    const optimized = await getImage({ src: f.src, width: 1600 });
    return { src: optimized.src, alt: f.alt, caption: f.caption };
  }),
);
---

<section id="galeria" class="bg-slate-50 py-16 sm:py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-700 to-navy-800 px-6 py-10 text-center shadow-xl sm:px-12 sm:py-14 md:py-16">
      <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-brand-500/15 blur-3xl"></div>
      <div class="absolute -bottom-12 -left-12 h-44 w-44 rounded-full bg-brand-500/10 blur-3xl"></div>
      <span class="relative inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-xs font-bold uppercase tracking-widest text-brand-300 sm:text-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        Galería
      </span>
      <h1 class="relative mx-auto mt-3 max-w-2xl text-2xl font-extrabold text-white sm:text-3xl md:text-4xl">
        La vida en Galileo
      </h1>
      <p class="relative mx-auto mt-4 max-w-2xl text-base text-navy-100 sm:text-lg">
        Infraestructura, deporte y tradiciones que forman parte de nuestra comunidad educativa.
      </p>
    </div>

    <div class="mt-12 grid grid-cols-2 gap-4 sm:mt-14 sm:gap-6 md:grid-cols-3 lg:grid-cols-4">
      {fotos.map((f, i) => (
        <button
          type="button"
          data-galeria-index={i}
          class="group relative overflow-hidden rounded-2xl bg-white ring-1 ring-slate-200 transition hover:-translate-y-1 hover:shadow-xl hover:ring-brand-300"
        >
          <Image
            src={f.src}
            alt={f.alt}
            widths={[320, 640, 960, 1200]}
            sizes="(min-width: 1024px) 25vw, (min-width: 768px) 33vw, (min-width: 640px) 50vw, 100vw"
            loading="lazy"
            decoding="async"
            class="aspect-[4/3] w-full object-cover transition-transform duration-500 group-hover:scale-105"
          />
          <span class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-navy-900/85 via-navy-900/30 to-transparent px-4 pb-3 pt-10 text-left text-xs font-bold text-white opacity-0 transition-opacity duration-300 group-hover:opacity-100 sm:text-sm">
            {f.caption}
          </span>
        </button>
      ))}
    </div>
  </div>
</section>

<div
  id="galeria-lightbox"
  class="fixed inset-0 z-[80] hidden items-center justify-center bg-navy-900/90 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-label="Vista ampliada de la galería"
>
  <button
    id="galeria-lb-close"
    type="button"
    aria-label="Cerrar galería"
    class="absolute right-4 top-4 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20"
  >
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M6 6l12 12 M18 6L6 18" />
    </svg>
  </button>
  <button
    id="galeria-lb-prev"
    type="button"
    aria-label="Imagen anterior"
    class="absolute left-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:left-6"
  >
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M15 18l-6-6 6-6" />
    </svg>
  </button>
  <button
    id="galeria-lb-next"
    type="button"
    aria-label="Imagen siguiente"
    class="absolute right-3 z-10 flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white transition hover:bg-white/20 sm:right-6"
  >
    <svg
      class="h-5 w-5"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      stroke-width="2.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M9 5l7 7-7 7" />
    </svg>
  </button>
  <figure class="max-w-4xl px-14">
    <img id="galeria-lb-img" class="mx-auto max-h-[75vh] w-auto rounded-xl shadow-2xl" src="" alt="" />
    <figcaption id="galeria-lb-caption" class="mt-3 text-center text-sm font-bold text-white"></figcaption>
  </figure>
</div>

<script define:vars={{ lightbox }}>
  (() => {
    const lb = document.getElementById('galeria-lightbox');
    const img = document.getElementById('galeria-lb-img');
    const caption = document.getElementById('galeria-lb-caption');
    if (!lb || !img || !caption) return;

    let index = 0;
    let lastFocus = null;

    const show = (i) => {
      index = (i + fotos.length) % fotos.length;
      const f = fotos[index];
      img.src = f.src;
      img.alt = f.alt;
      caption.textContent = f.caption;
    };
    const open = (i, trigger) => {
      lastFocus = trigger || null;
      show(i);
      lb.classList.remove('hidden');
      lb.classList.add('flex');
      document.body.style.overflow = 'hidden';
      document.getElementById('galeria-lb-close')?.focus();
    };
    const close = () => {
      lb.classList.add('hidden');
      lb.classList.remove('flex');
      document.body.style.overflow = '';
      lastFocus?.focus();
    };

    document.querySelectorAll('[data-galeria-index]').forEach((btn) => {
      btn.addEventListener('click', () => {
        open(Number(btn.getAttribute('data-galeria-index')), btn);
      });
    });

    document.getElementById('galeria-lb-close')?.addEventListener('click', close);
    document.getElementById('galeria-lb-prev')?.addEventListener('click', () => show(index - 1));
    document.getElementById('galeria-lb-next')?.addEventListener('click', () => show(index + 1));
    lb.addEventListener('click', (e) => {
      if (e.target === lb) close();
    });

    const FOCUSABLE = 'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])';

    document.addEventListener('keydown', (e) => {
      if (lb.classList.contains('hidden')) return;
      if (e.key === 'Escape') close();
      if (e.key === 'ArrowLeft') show(index - 1);
      if (e.key === 'ArrowRight') show(index + 1);

      // Keep Tab inside the lightbox. Done here rather than via the shared
      // createDialog helper because that one stops propagation on Escape,
      // which would also swallow the arrow keys handled above.
      if (e.key === 'Tab') {
        const items = Array.from(lb.querySelectorAll < HTMLElement > FOCUSABLE).filter(
          (el) => el.offsetParent !== null,
        );
        if (!items.length) return;
        const first = items[0];
        const last = items[items.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    });
  })();
</script>
