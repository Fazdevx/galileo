---
const steps = [
  {
    title: 'Agenda tu visita',
    desc: 'Contáctanos por WhatsApp o correo y coordinamos una visita guiada o una entrevista con tu hijo y su apoderado.',
    icon: 'M8 2v4 M16 2v4 M3 10h18 M5 4h14a2 2 0 012 2v14a2 2 0 01-2 2H5a2 2 0 01-2-2V6a2 2 0 012-2z',
  },
  {
    title: 'Presenta tus documentos',
    desc: 'DNI del estudiante y del apoderado, certificado de estudios del nivel anterior y fotos recientes.',
    icon: 'M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8',
  },
  {
    title: 'Evaluación diagnóstica',
    desc: 'Aplicamos una evaluación diagnóstica para conocer el nivel del estudiante y asignarle el acompañamiento adecuado.',
    icon: 'M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2 M9 5a2 2 0 002 2h2a2 2 0 002-2  M9 5a2 2 0 012-2h2a2 2 0 012 2 M9 12l2 2 4-4',
  },
  {
    title: 'Confirma tu matrícula',
    desc: 'Formaliza la vacante completando tu matrícula y dale la bienvenida a tu familia Galileo.',
    icon: 'M22 11.08V12a10 10 0 11-5.93-9.14 M22 4L12 14.01 9 11.01',
  },
];

const phone = '51997394157';
const msg = encodeURIComponent('Hola, quisiera información sobre pensiones y becas del Colegio y Academia Galileo.');
const waLink = `https://wa.me/${phone}?text=${msg}`;
---

<section id="admision" class="bg-slate-50 py-16 sm:py-20 md:py-24">
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-navy-700 to-navy-800 px-6 py-10 text-center shadow-xl sm:px-12 sm:py-14 md:py-16">
      <div class="absolute -right-12 -top-12 h-44 w-44 rounded-full bg-brand-500/15 blur-3xl"></div>
      <div class="absolute -bottom-12 -left-12 h-44 w-44 rounded-full bg-brand-500/10 blur-3xl"></div>
      <span class="relative inline-flex items-center gap-2 rounded-full bg-white/10 px-4 py-1 text-xs font-bold uppercase tracking-widest text-brand-300 sm:text-sm">
        <span class="h-1.5 w-1.5 rounded-full bg-brand-400"></span>
        Admisión 2026
      </span>
      <h1 class="relative mx-auto mt-3 max-w-2xl text-2xl font-extrabold text-white sm:text-3xl md:text-4xl">
        ¿Cómo me matriculo?
      </h1>
      <p class="relative mx-auto mt-4 max-w-2xl text-base text-navy-100 sm:text-lg">
        Un proceso sencillo en 4 pasos para que tu hijo o hija empiece el año con nosotros.
      </p>
    </div>

    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {steps.map((s, i) => (
        <article class="group relative overflow-hidden rounded-2xl bg-white p-6 ring-1 ring-slate-200 transition-all hover:-translate-y-1 hover:shadow-xl hover:ring-brand-300 sm:p-7">
          <span class="pointer-events-none absolute -right-2 -top-4 select-none text-6xl font-extrabold text-brand-100 transition-colors group-hover:text-brand-200 sm:text-7xl">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div class="relative flex h-14 w-14 items-center justify-center rounded-xl bg-brand-500 text-white transition-colors group-hover:bg-brand-600">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-7 w-7"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d={s.icon} />
            </svg>
          </div>
          <h3 class="relative mt-5 text-lg font-extrabold text-navy-700 sm:text-xl">{s.title}</h3>
          <p class="relative mt-2 text-sm leading-relaxed text-slate-600">{s.desc}</p>
        </article>
      ))}
    </div>

    <div class="mt-12 overflow-hidden rounded-2xl bg-navy-700 px-6 py-8 sm:px-8 sm:py-10 md:flex md:items-center md:justify-between">
      <div class="max-w-2xl text-white">
        <h3 class="text-xl font-extrabold sm:text-2xl md:text-3xl">Pensiones y becas</h3>
        <p class="mt-2 text-sm text-navy-100 sm:text-base">
          El costo no debe ser un impedimento. Escríbenos y te informamos sobre pensiones, descuentos por familia y
          becas disponibles para este año.
        </p>
      </div>
      <div class="mt-6 flex flex-wrap items-center gap-3 md:mt-0">
        <a
          href={waLink}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded-full bg-brand-500 px-5 py-2.5 text-sm font-bold text-white transition hover:bg-brand-600 sm:px-6 sm:py-3"
        >
          Consultar costos y becas
          <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24">
            <path d="M19.05 4.91A9.82 9.82 0 0012.04 2C6.58 2 2.13 6.46 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.98 9.98 0 004.79 1.22h.01c5.46 0 9.9-4.46 9.9-9.91 0-2.65-1.03-5.14-2.9-7.02zM12.05 20.15h-.01a8.3 8.3 0 01-4.23-1.16l-.3-.18-3.12.82.83-3.04-.2-.31a8.21 8.21 0 01-1.26-4.38c0-4.55 3.71-8.25 8.25-8.25 2.21 0 4.28.86 5.84 2.42a8.2 8.2 0 012.42 5.84c0 4.53-3.7 8.24-8.25 8.24zM15.88 14.4c-.2-.1-1.17-.58-1.35-.64-.18-.06-.31-.1-.44.1-.13.2-.51.64-.63.77-.11.13-.23.15-.43.05-.2-.1-.84-.31-1.6-.99-.59-.52-.98-1.17-1.1-1.37-.11-.2-.01-.31.09-.41.09-.09.2-.23.29-.35.1-.12.13-.2.2-.33.07-.13.03-.24-.02-.34-.05-.1-.44-1.06-.6-1.45-.16-.39-.32-.33-.44-.34h-.38c-.13 0-.34.05-.52.24-.18.2-.68.67-.68 1.63s.7 1.89.8 2.02c.1.13 1.38 2.11 3.35 2.96.47.2.83.32 1.12.41.47.15.9.13 1.24.08.38-.06 1.17-.48 1.34-.94.16-.46.16-.85.11-.94-.05-.09-.18-.14-.38-.24z" />
          </svg>
        </a>
        <button
          id="btn-admision-prematricula"
          type="button"
          class="inline-flex items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-navy-700 transition hover:bg-navy-100 sm:px-6 sm:py-3"
        >
          Pre-matrícula rápida
          <svg
            class="h-4 w-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M5 12h14 M13 6l6 6-6 6" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script>
  document.getElementById('btn-admision-prematricula')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('open-prematricula'));
  });
</script>
