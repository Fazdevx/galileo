<script>
  import { PRIZES } from '../data/olimpiadasStore';

  type Prize = { id: string; name: string; description: string; type: string; value: number; icon: string };

  // The wheel keeps 6 segments: the five prizes plus a repeat of the first, so
  // the wheel geometry (and therefore the pointer maths) is unchanged.
  const WHEEL_PRIZES = PRIZES.map(({ color, ...p }) => p as Prize);
  WHEEL_PRIZES.push({ ...(WHEEL_PRIZES[0] as Prize), id: 'w6' });

  // The card deck shows 8 cards drawn from the same pool, so duplicates are
  // expected here.
  const ALL_PRIZES = Array.from({ length: 8 }, (_, i) => ({
    ...(PRIZES[i % PRIZES.length] as Prize),
    id: `d${i + 1}`,
  }));

  const SEGMENT_COLORS = ['#1b2a4e', '#f97316', '#0f172a', '#ea580c', '#1e3a5f', '#c2410c'];
  const SEGMENT_LIGHT = ['#2d4a7a', '#fb923c', '#1e293b', '#f97316', '#334e68', '#ea580c'];

  const TOTAL = WHEEL_PRIZES.length;
  const SEGMENT_ANGLE = 360 / TOTAL;
  let spinning = false;
  let deckFlipped = false;

  // Shared with the "cerrar" buttons inside the win forms, which live outside showModal().
  let hideModal: () => void = () => {};
  let dialog: DialogHandle | null = null;

  function closePrizeModal() {
    // Goes through the handle so Escape, the trap and the listeners stay in sync.
    if (dialog) dialog.close();
    else hideModal();
  }

  function launchConfetti() {
    const container = document.getElementById('confetti-container');
    if (!container) return;
    container.innerHTML = '';
    const colors = ['#ff6b1a', '#1b2a4e', '#ff7d2e', '#f04e00', '#2d4173', '#fbbf24'];
    const modal = document.getElementById('prize-card');
    const modalRect = modal ? modal.getBoundingClientRect() : { width: window.innerWidth, height: window.innerHeight };

    for (let i = 0; i < 40; i++) {
      const piece = document.createElement('div');
      const x = Math.random() * modalRect.width;
      const color = colors[Math.floor(Math.random() * colors.length)];
      const size = Math.random() * 10 + 3;
      const shape = Math.random() > 0.5 ? '50%' : '2px';
      piece.style.cssText = `position:absolute;left:${x}px;top:-10px;width:${size}px;height:${size}px;background:${color};border-radius:${shape};pointer-events:none;`;
      container.appendChild(piece);
      const anim = piece.animate(
        [
          { transform: `translate(0, 0) rotate(0deg) scale(1)`, opacity: 1 },
          {
            transform: `translate(${Math.random() * 100 - 50}px, ${modalRect.height + 20}px) rotate(${Math.random() * 720}deg) scale(0.3)`,
            opacity: 0,
          },
        ],
        {
          duration: Math.random() * 1500 + 1000,
          easing: 'cubic-bezier(0.25, 0.46, 0.45, 0.94)',
          delay: Math.random() * 600,
        },
      );
      anim.onfinish = () => piece.remove();
    }
    // Limpiar el contenedor despuÃ©s de que todos los confetis terminen
    setTimeout(() => {
      if (container) container.innerHTML = '';
    }, 3000);
  }

  function buildWheelSegments() {
    const container = document.getElementById('wheel-segments');
    if (!container) return;
    container.innerHTML = '';

    WHEEL_PRIZES.forEach((prize, i) => {
      const startAngle = i * SEGMENT_ANGLE;
      const endAngle = startAngle + SEGMENT_ANGLE;
      const startRad = ((startAngle - 90) * Math.PI) / 180;
      const endRad = ((endAngle - 90) * Math.PI) / 180;
      const x1 = 200 + 195 * Math.cos(startRad);
      const y1 = 200 + 195 * Math.sin(startRad);
      const x2 = 200 + 195 * Math.cos(endRad);
      const y2 = 200 + 195 * Math.sin(endRad);
      const largeArc = SEGMENT_ANGLE > 180 ? 1 : 0;
      const midAngle = (startAngle + endAngle) / 2 - 90;
      const labelR = 130;
      const lx = 200 + labelR * Math.cos((midAngle * Math.PI) / 180);
      const ly = 200 + labelR * Math.sin((midAngle * Math.PI) / 180);
      const color = SEGMENT_COLORS[i % SEGMENT_COLORS.length];
      const lightColor = SEGMENT_LIGHT[i % SEGMENT_LIGHT.length];

      const gradId = `segGrad${i}`;
      const defs = document.querySelector('defs');
      if (defs) {
        const grad = document.createElementNS('http://www.w3.org/2000/svg', 'radialGradient');
        grad.setAttribute('id', gradId);
        grad.setAttribute('cx', '50%');
        grad.setAttribute('cy', '50%');
        grad.setAttribute('r', '50%');
        const stop1 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
        stop1.setAttribute('offset', '0%');
        stop1.setAttribute('stop-color', lightColor);
        const stop2 = document.createElementNS('http://www.w3.org/2000/svg', 'stop');
        stop2.setAttribute('offset', '100%');
        stop2.setAttribute('stop-color', color);
        grad.appendChild(stop1);
        grad.appendChild(stop2);
        defs.appendChild(grad);
      }

      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', `M200,200 L${x1},${y1} A195,195 0 ${largeArc},1 ${x2},${y2} Z`);
      path.setAttribute('fill', `url(#${gradId})`);
      path.setAttribute('stroke', '#fff');
      path.setAttribute('stroke-width', '2.5');
      path.setAttribute('filter', 'url(#segmentShadow)');

      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('x', String(lx));
      text.setAttribute('y', String(ly - 8));
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('dominant-baseline', 'central');
      text.setAttribute('fill', '#fff');
      text.setAttribute('font-size', '16');
      text.setAttribute('font-weight', 'bold');
      text.setAttribute('transform', `rotate(${midAngle + 90}, ${lx}, ${ly})`);
      text.textContent = String(i + 1);

      const subText = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      subText.setAttribute('x', String(lx));
      subText.setAttribute('y', String(ly + 12));
      subText.setAttribute('text-anchor', 'middle');
      subText.setAttribute('dominant-baseline', 'central');
      subText.setAttribute('fill', '#fff');
      subText.setAttribute('font-size', '9');
      subText.setAttribute('opacity', '0.9');
      subText.setAttribute('transform', `rotate(${midAngle + 90}, ${lx}, ${ly})`);
      subText.textContent = prize.name.length > 12 ? prize.name.substring(0, 11) + 'â€¦' : prize.name;

      container.appendChild(path);
      container.appendChild(text);
      container.appendChild(subText);
    });
  }

  function pickRandomPrize() {
    return WHEEL_PRIZES[Math.floor(Math.random() * WHEEL_PRIZES.length)];
  }

  function showCountdown(onComplete: () => void) {
    const cdEl = document.getElementById('countdown');
    const numEl = document.getElementById('countdown-num');
    const spinBtn = document.getElementById('spin-btn') as HTMLButtonElement | null;
    if (!cdEl || !numEl) {
      onComplete();
      return;
    }

    cdEl.classList.remove('hidden');
    if (spinBtn) spinBtn.classList.add('hidden');

    let count = 3;
    numEl.textContent = String(count);
    numEl.style.transition = 'none';
    numEl.style.transform = 'scale(1.5)';
    numEl.style.opacity = '1';

    const interval = setInterval(() => {
      count--;
      if (count <= 0) {
        clearInterval(interval);
        numEl.style.transition = 'all 0.3s ease';
        numEl.style.transform = 'scale(0.5)';
        numEl.style.opacity = '0';
        setTimeout(() => {
          cdEl.classList.add('hidden');
          if (spinBtn) spinBtn.classList.remove('hidden');
          onComplete();
        }, 300);
      } else {
        numEl.textContent = String(count);
        numEl.style.transition = 'none';
        numEl.style.transform = 'scale(1.5)';
        requestAnimationFrame(() => {
          numEl.style.transition = 'all 0.3s ease';
          numEl.style.transform = 'scale(1)';
        });
      }
    }, 800);
  }

  function showModal() {
    const today = new Date().toISOString().slice(0, 10);
    const lastSeen = localStorage.getItem('galileo-prize-date');
    if (lastSeen === today) return;

    const modal = document.getElementById('prize-modal');
    const card = document.getElementById('prize-card');
    const spinnerArea = document.getElementById('prize-spinner-area');
    const deckArea = document.getElementById('prize-deck-area');

    if (!modal || !card) return;

    const useWheel = Math.random() > 0.5;
    if (spinnerArea) spinnerArea.classList.toggle('hidden', !useWheel);
    if (deckArea) deckArea.classList.toggle('hidden', useWheel);

    const spinResult = document.getElementById('spin-result');
    const spinWinForm = document.getElementById('spin-win-form');
    const spinCelebration = document.getElementById('spin-celebration');
    const deckResult = document.getElementById('deck-result');
    const deckWinForm = document.getElementById('deck-win-form');
    const deckCelebration = document.getElementById('deck-celebration');
    if (spinResult) spinResult.classList.add('hidden');
    if (spinWinForm) spinWinForm.classList.add('hidden');
    if (spinCelebration) spinCelebration.classList.add('hidden');
    if (deckResult) deckResult.classList.add('hidden');
    if (deckWinForm) deckWinForm.classList.add('hidden');
    if (deckCelebration) deckCelebration.classList.add('hidden');

    if (useWheel) {
      buildWheelSegments();
      spinning = false;
      deckFlipped = false;
      const centerText = document.getElementById('center-text');
      if (centerText) {
        centerText.textContent = 'GIRAR';
        centerText.setAttribute('font-size', '14');
      }
      const spinBtn = document.getElementById('spin-btn') as HTMLButtonElement | null;
      const spinResult = document.getElementById('spin-result');
      const spinResultName = document.getElementById('spin-result-name');
      const spinResultDesc = document.getElementById('spin-result-desc');
      const wheelSvg = document.getElementById('wheel-svg');

      if (spinBtn) spinBtn.disabled = false;
      if (spinResult) spinResult.classList.add('hidden');
      if (wheelSvg) {
        wheelSvg.style.transition = 'none';
        wheelSvg.style.transform = 'rotate(0deg)';
      }

      if (spinBtn) {
        spinBtn.onclick = () => {
          if (spinning) return;
          spinning = true;
          spinBtn.disabled = true;

          showCountdown(() => {
            spinBtn.innerHTML = faIcon('spinner', 16, 'animate-spin mr-2 inline-block align-[-2px]') + 'Girando...';
            const prize = pickRandomPrize();
            const prizeIndex = WHEEL_PRIZES.findIndex((p) => p.id === prize.id);
            const targetAngle = 360 * 8 + (360 - (prizeIndex * SEGMENT_ANGLE + SEGMENT_ANGLE / 2));
            if (wheelSvg) {
              wheelSvg.style.transition = 'transform 6s cubic-bezier(0.17, 0.67, 0.12, 0.99)';
              wheelSvg.style.transform = `rotate(${targetAngle}deg)`;
            }
            setTimeout(() => {
              if (spinResultName) spinResultName.textContent = prize.name;
              if (spinResultDesc) spinResultDesc.textContent = prize.description;
              if (spinResult) {
                spinResult.classList.remove('hidden');
                const resultDiv = spinResult.querySelector('div');
                if (resultDiv) resultDiv.classList.add('celebrate-anim');
              }
              if (centerText) {
                centerText.textContent = prize.name;
                centerText.setAttribute('font-size', '11');
              }
              if (spinBtn)
                spinBtn.innerHTML = faIcon('dharmachakra', 16, 'mr-2 inline-block align-[-2px]') + 'Girar Ruleta';
              spinning = false;
              saveWinner(prize);
              launchConfetti();
              setTimeout(() => {
                if (spinResult) spinResult.classList.add('hidden');
                showCelebration(prize, 'spin');
              }, 2000);
            }, 6200);
          });
        };
      }
    } else {
      deckFlipped = false;
      const deckGrid = document.getElementById('deck-grid');
      const deckResult = document.getElementById('deck-result');
      const deckResultName = document.getElementById('deck-result-name');
      const deckResultDesc = document.getElementById('deck-result-desc');

      if (deckGrid) {
        deckGrid.innerHTML = '';
        const shuffled = [...ALL_PRIZES].sort(() => Math.random() - 0.5).slice(0, 8);
        shuffled.forEach((prize) => {
          const cardEl = document.createElement('div');
          cardEl.className = 'flip-card cursor-pointer h-24 sm:h-32';
          cardEl.innerHTML = `
            <div class="relative h-full w-full preserve-3d transition-all duration-500" style="transform-style: preserve-3d;">
              <div class="flip-front absolute inset-0 flex flex-col items-center justify-center rounded-xl bg-navy-900/30 backdrop-blur-sm shadow-lg border-2 border-brand-500/30" style="backface-visibility: hidden; transform: rotateY(0deg);">
                <div class="absolute inset-0 rounded-xl overflow-hidden opacity-10">
                  <svg width="100%" height="100%"><pattern id="diag${prize.id}" patternUnits="userSpaceOnUse" width="12" height="12" patternTransform="rotate(45)"><line x1="0" y1="0" x2="0" y2="12" stroke="#f97316" stroke-width="1.5"/></pattern></svg>
                  <rect width="100%" height="100%" fill="url(#diag${prize.id})" />
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="relative z-10 h-8 w-8 text-brand-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 3-3 3"/><path d="M12 17h.01"/><path d="M12 22a10 10 0 1 0 0-20 10 10 0 0 0 0 20Z"/></svg>
                <span class="mt-2 text-xs font-bold text-white relative z-10">CLICK</span>
              </div>
              <div class="flip-back absolute inset-0 flex flex-col items-center justify-center rounded-xl shadow-lg border-2 border-brand-500/50" style="backface-visibility: hidden; transform: rotateY(180deg); background: linear-gradient(135deg, rgba(27, 42, 78, 0.6), rgba(15, 23, 42, 0.8)); backdrop-blur-sm;">
                <span class="text-brand-400">${faIcon(prize.icon, 36)}</span>
                <span class="mt-2 text-xs font-bold text-white relative z-10">${prize.name}</span>
              </div>
            </div>
          `;
          cardEl.addEventListener('click', () => {
            if (deckFlipped) return;
            deckFlipped = true;
            const inner = cardEl.querySelector<HTMLElement>('.preserve-3d');
            if (inner) inner.style.transform = 'rotateY(180deg)';
            if (deckResultName) deckResultName.textContent = prize.name;
            if (deckResultDesc) deckResultDesc.textContent = prize.description;
            if (deckResult) {
              deckResult.classList.remove('hidden');
              const resultDiv = deckResult.querySelector('div');
              if (resultDiv) resultDiv.classList.add('celebrate-anim');
            }
            saveWinner(prize);
            launchConfetti();
            setTimeout(() => {
              if (deckResult) deckResult.classList.add('hidden');
              showCelebration(prize, 'deck');
            }, 1500);
          });
          deckGrid.appendChild(cardEl);
        });
      }
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');

    requestAnimationFrame(() => {
      card.style.opacity = '0';
      card.style.transform = 'scale(0.9) translateY(20px)';
      requestAnimationFrame(() => {
        card.style.transition = 'all 0.4s cubic-bezier(0.17, 0.67, 0.12, 0.99)';
        card.style.opacity = '1';
        card.style.transform = 'scale(1) translateY(0)';
      });
    });

    function hideModalImpl() {
      if (!modal || !card) return;
      card.style.opacity = '0';
      card.style.transform = 'scale(0.9) translateY(20px)';
      setTimeout(() => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        localStorage.setItem('galileo-prize-date', today);
      }, 300);
    }
    hideModal = hideModalImpl;

    const closeBtn = document.getElementById('prize-close');
    const backdrop = document.getElementById('prize-backdrop');
    if (closeBtn) closeBtn.onclick = closePrizeModal;
    if (backdrop) backdrop.onclick = closePrizeModal;

    // Escape, focus trap and focus restoration come from the shared helper.
    dialog?.destroy();
    dialog = window.createDialog({
      root: modal,
      close: hideModalImpl,
      initialFocus: '#prize-close',
    });
    // showModal() already made it visible with an entrance animation, so we only
    // wire the trap and move focus.
    dialog.open();
  }

  function saveWinner(prize: { id: string; name: string; description: string; icon: string }) {
    const winners = JSON.parse(localStorage.getItem('galileo-winners') || '[]');
    winners.push({ prizeId: prize.id, timestamp: Date.now() });
    localStorage.setItem('galileo-winners', JSON.stringify(winners));
  }

  function showWinForm(prize: { id: string; name: string; description: string; icon: string }, mode: 'spin' | 'deck') {
    const prefix = mode;
    const form = document.getElementById(`${prefix}-win-form`);
    const ticketInput = document.getElementById(`${prefix}-ticket-number`) as HTMLInputElement | null;
    const nameInput = document.getElementById(`${prefix}-parent-name`) as HTMLInputElement | null;
    const whatsappBtn = document.getElementById(`${prefix}-whatsapp-btn`);

    if (!form) return;
    form.classList.remove('hidden');

    if (ticketInput) ticketInput.value = '';
    if (nameInput) nameInput.value = '';

    if (whatsappBtn) {
      whatsappBtn.onclick = () => {
        const ticket = ticketInput?.value.trim() || '';
        const name = nameInput?.value.trim() || '';
        if (!ticket || !name) {
          alert('Completa ambos campos para enviar por WhatsApp.');
          return;
        }
        const message = `ðŸŽ‰ Â¡Ganaste: ${prize.name}!
ðŸ“¦ ${prize.description}
ðŸŽ« Boleta: ${ticket}
ðŸ‘¤ Padre/Madre: ${name}`;
        const encodedMessage = encodeURIComponent(message);
        window.open(`https://wa.me/51997394157?text=${encodedMessage}`, '_blank');
        // Cerrar el modal despuÃ©s de enviar
        setTimeout(() => {
          closePrizeModal();
        }, 1000);
      };
    }

    // BotÃ³n de cerrar sin enviar
    const closeBtn = document.getElementById(`${prefix}-close-btn`);
    if (closeBtn) {
      closeBtn.onclick = () => {
        closePrizeModal();
      };
    }

    // Cerrar automÃ¡ticamente despuÃ©s de 2 segundos
    setTimeout(() => {
      closePrizeModal();
    }, 2000);
  }

  function showCelebration(
    prize: { id: string; name: string; description: string; icon: string },
    mode: 'spin' | 'deck',
  ) {
    const prefix = mode;
    const celebration = document.getElementById(`${prefix}-celebration`);
    const icon = document.getElementById(`${prefix}-celebration-icon`);
    const name = document.getElementById(`${prefix}-celebration-name`);

    if (!celebration) return;

    if (icon) icon.innerHTML = faIcon(prize.icon, 64);
    if (name) name.textContent = prize.name;

    celebration.classList.remove('hidden');
    // No lanzar confetis aquÃ­, ya se lanzaron antes

    const iconEl = icon?.querySelector('i');
    if (iconEl) {
      iconEl.style.transition = 'none';
      iconEl.style.transform = 'scale(0)';
      iconEl.classList.add('bounce-icon');
      requestAnimationFrame(() => {
        iconEl.style.transition = 'all 0.5s cubic-bezier(0.17, 0.67, 0.12, 0.99)';
        iconEl.style.transform = 'scale(1)';
      });
    }

    setTimeout(() => {
      if (celebration) celebration.classList.add('hidden');
      showWinForm(prize, mode);
    }, 2500);
  }

  document.addEventListener('DOMContentLoaded', showModal);
</script>

